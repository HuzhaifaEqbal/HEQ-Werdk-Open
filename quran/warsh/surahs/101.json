  "ayahs": [
    {
      "id": 6137,
      "number": 1,
      "text_uthmani": "اِ۬لْقَارِعَةُ مَا اَ۬لْقَارِعَةُۖ ١",
      "text_simple": "القارعه ما القارعه ١",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 6138,
      "number": 2,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا اَ۬لْقَارِعَةُۖ ٢",
      "text_simple": "ومآ ادريك ما القارعه ٢",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 6139,
      "number": 3,
      "text_uthmani": "يَوْمَ يَكُونُ اُ۬لنَّاسُ كَالْفَرَاشِ اِ۬لْمَبْثُوثِ ٣",
      "text_simple": "يوم يكون الناس كالفراش المبثوث ٣",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 6140,
      "number": 4,
      "text_uthmani": "وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ اِ۬لْمَنفُوشِۖ ٤",
      "text_simple": "وتكون الجبال كالعهن المنفوش ٤",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 6141,
      "number": 5,
      "text_uthmani": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ ٥",
      "text_simple": "فاما من ثقلت موزينه ٥",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6142,
      "number": 6,
      "text_uthmani": "فَهُوَ فِے عِيشَةٖ رَّاضِيَةٖۖ ٦",
      "text_simple": "فهو فے عيشهٖ راضيهٖ ٦",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 6143,
      "number": 7,
      "text_uthmani": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ ٧",
      "text_simple": "واما من خفت موزينه ٧",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6144,
      "number": 8,
      "text_uthmani": "فَأُمُّهُۥ هَاوِيَةٞۖ ٨",
      "text_simple": "فامه هاويهٞ ٨",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6145,
      "number": 9,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا هِيَهْۖ ٩",
      "text_simple": "ومآ ادريك ما هيه ٩",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6146,
      "number": 10,
      "text_uthmani": "نَارٌ حَامِيَةٌۖ ١٠",
      "text_simple": "نار حاميه ١٠",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    }
  ]
}