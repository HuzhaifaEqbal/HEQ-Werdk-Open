{
  "number": 82,
  "name_ar": "الانفِطَار",
  "name_en": "Al-Infiṭār",
  "ayahs_count": 19,
  "page_start": 587,
  "page_end": 587,
  "ayahs": [
    {
      "id": 5805,
      "number": 1,
      "text_uthmani": "إِذَا اَ۬لسَّمَآءُ اُ۪نفَطَرَتْ ١",
      "text_simple": "اذا السمآء انفطرت ١",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5806,
      "number": 2,
      "text_uthmani": "وَإِذَا اَ۬لْكَوَاكِبُ اُ۪نتَثَرَتْ ٢",
      "text_simple": "واذا الكواكب انتثرت ٢",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5807,
      "number": 3,
      "text_uthmani": "وَإِذَا اَ۬لْبِحَارُ فُجِّرَتْ ٣",
      "text_simple": "واذا البحار فجرت ٣",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5808,
      "number": 4,
      "text_uthmani": "وَإِذَا اَ۬لْقُبُورُ بُعْثِرَتْ ٤",
      "text_simple": "واذا القبور بعثرت ٤",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5809,
      "number": 5,
      "text_uthmani": "عَلِمَتْ نَفْسٞ مَّا قَدَّمَتْ وَأَخَّرَتْۖ ٥",
      "text_simple": "علمت نفسٞ ما قدمت واخرت ٥",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5810,
      "number": 6,
      "text_uthmani": "يَٰٓأَيُّهَا اَ۬لِانسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لْكَرِيمِ ٦",
      "text_simple": "يٓايها الانسن ما غرك بربك الكريم ٦",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5811,
      "number": 7,
      "text_uthmani": "اِ۬لذِے خَلَقَكَ فَسَوّ۪يٰكَ فَعَدَّلَكَ ٧",
      "text_simple": "الذے خلقك فسويك فعدلك ٧",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5812,
      "number": 8,
      "text_uthmani": "فِےٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَۖ ٨",
      "text_simple": "فےٓ اي صورهٖ ما شآء ركبك ٨",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5813,
      "number": 9,
      "text_uthmani": "كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ ٩",
      "text_simple": "كلا بل تكذبون بالدين ٩",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5814,
      "number": 10,
      "text_uthmani": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ ١٠",
      "text_simple": "وان عليكم لحفظين ١٠",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5815,
      "number": 11,
      "text_uthmani": "كِرَاماٗ كَٰتِبِينَ ١١",
      "text_simple": "كراماٗ كتبين ١١",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5816,
      "number": 12,
      "text_uthmani": "يَعْلَمُونَ مَا تَفْعَلُونَۖ ١٢",
      "text_simple": "يعلمون ما تفعلون ١٢",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5817,
      "number": 13,
      "text_uthmani": "إِنَّ اَ۬لَابْرَارَ لَفِے نَعِيمٖۖ ١٣",
      "text_simple": "ان الابرار لفے نعيمٖ ١٣",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5818,
      "number": 14,
      "text_uthmani": "وَإِنَّ اَ۬لْفُجَّارَ لَفِے جَحِيمٖ ١٤",
      "text_simple": "وان الفجار لفے جحيمٖ ١٤",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5819,
      "number": 15,
      "text_uthmani": "يَصْلَوْنَهَا يَوْمَ اَ۬لدِّينِ ١٥",
      "text_simple": "يصلونها يوم الدين ١٥",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5820,
      "number": 16,
      "text_uthmani": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَۖ ١٦",
      "text_simple": "وما هم عنها بغآئبين ١٦",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5821,
      "number": 17,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِ ١٧",
      "text_simple": "ومآ ادريك ما يوم الدين ١٧",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5822,
      "number": 18,
      "text_uthmani": "ثُمَّ مَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِۖ ١٨",
      "text_simple": "ثم مآ ادريك ما يوم الدين ١٨",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5823,
      "number": 19,
      "text_uthmani": "يَوْمَ لَا تَمْلِكُ نَفْسٞ لِّنَفْسٖ شَئْاٗۖ وَالَامْرُ يَوْمَئِذٖ لِّلهِۖ ١٩",
      "text_simple": "يوم لا تملك نفسٞ لنفسٖ شئاٗ والامر يومئذٖ لله ١٩",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    }
  ]
}