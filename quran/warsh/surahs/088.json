{
  "number": 88,
  "name_ar": "الغَاشِية",
  "name_en": "Al-Ghāshiyah",
  "ayahs_count": 26,
  "page_start": 592,
  "page_end": 593,
  "ayahs": [
    {
      "id": 5943,
      "number": 1,
      "text_uthmani": "هَلَ اَت۪يٰكَ حَدِيثُ اُ۬لْغَٰشِيَةِۖ ١",
      "text_simple": "هل اتيك حديث الغشيه ١",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5944,
      "number": 2,
      "text_uthmani": "وُجُوهٞ يَوْمَئِذٍ خَٰشِعَةٌ ٢",
      "text_simple": "وجوهٞ يومئذ خشعه ٢",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5945,
      "number": 3,
      "text_uthmani": "عَامِلَةٞ نَّاصِبَةٞ ٣",
      "text_simple": "عاملهٞ ناصبهٞ ٣",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5946,
      "number": 4,
      "text_uthmani": "تَصْلَىٰ نَاراً حَامِيَةٗ ٤",
      "text_simple": "تصلي نارا حاميهٗ ٤",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5947,
      "number": 5,
      "text_uthmani": "تُسْق۪ىٰ مِنْ عَيْنٍ اٰنِيَةٖۖ ٥",
      "text_simple": "تسقي من عين انيهٖ ٥",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5948,
      "number": 6,
      "text_uthmani": "لَّيْسَ لَهُمْ طَعَامٌ اِلَّا مِن ضَرِيعٖ ٦",
      "text_simple": "ليس لهم طعام الا من ضريعٖ ٦",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5949,
      "number": 7,
      "text_uthmani": "لَّا يُسْمِنُ وَلَا يُغْنِے مِن جُوعٖۖ ٧",
      "text_simple": "لا يسمن ولا يغنے من جوعٖ ٧",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5950,
      "number": 8,
      "text_uthmani": "وُجُوهٞ يَوْمَئِذٖ نَّاعِمَةٞ ٨",
      "text_simple": "وجوهٞ يومئذٖ ناعمهٞ ٨",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5951,
      "number": 9,
      "text_uthmani": "لِّسَعْيِهَا رَاضِيَةٞ ٩",
      "text_simple": "لسعيها راضيهٞ ٩",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5952,
      "number": 10,
      "text_uthmani": "فِے جَنَّةٍ عَالِيَةٖ ١٠",
      "text_simple": "فے جنه عاليهٖ ١٠",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5953,
      "number": 11,
      "text_uthmani": "لَّا تُسْمَعُ فِيهَا لَٰغِيَةٞۖ ١١",
      "text_simple": "لا تسمع فيها لغيهٞ ١١",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5954,
      "number": 12,
      "text_uthmani": "فِيهَا عَيْنٞ جَارِيَةٞۖ ١٢",
      "text_simple": "فيها عينٞ جاريهٞ ١٢",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5955,
      "number": 13,
      "text_uthmani": "فِيهَا سُرُرٞ مَّرْفُوعَةٞ ١٣",
      "text_simple": "فيها سررٞ مرفوعهٞ ١٣",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5956,
      "number": 14,
      "text_uthmani": "وَأَكْوَابٞ مَّوْضُوعَةٞ ١٤",
      "text_simple": "واكوابٞ موضوعهٞ ١٤",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5957,
      "number": 15,
      "text_uthmani": "وَنَمَارِقُ مَصْفُوفَةٞ ١٥",
      "text_simple": "ونمارق مصفوفهٞ ١٥",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5958,
      "number": 16,
      "text_uthmani": "وَزَرَابِيُّ مَبْثُوثَةٌۖ ١٦",
      "text_simple": "وزرابي مبثوثه ١٦",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5959,
      "number": 17,
      "text_uthmani": "۞ اَفَلَا يَنظُرُونَ إِلَى اَ۬لِابِلِ كَيْفَ خُلِقَتْ ١٧",
      "text_simple": "افلا ينظرون الي الابل كيف خلقت ١٧",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5960,
      "number": 18,
      "text_uthmani": "وَإِلَى اَ۬لسَّمَآءِ كَيْفَ رُفِعَتْ ١٨",
      "text_simple": "والي السمآء كيف رفعت ١٨",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5961,
      "number": 19,
      "text_uthmani": "وَإِلَى اَ۬لْجِبَالِ كَيْفَ نُصِبَتْ ١٩",
      "text_simple": "والي الجبال كيف نصبت ١٩",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5962,
      "number": 20,
      "text_uthmani": "وَإِلَى اَ۬لَارْضِ كَيْفَ سُطِحَتْۖ ٢٠",
      "text_simple": "والي الارض كيف سطحت ٢٠",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5963,
      "number": 21,
      "text_uthmani": "فَذَكِّرِ اِنَّمَآ أَنتَ مُذَكِّرٞۖ ٢١",
      "text_simple": "فذكر انمآ انت مذكرٞ ٢١",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5964,
      "number": 22,
      "text_uthmani": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍۖ ٢٢",
      "text_simple": "لست عليهم بمصيطر ٢٢",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5965,
      "number": 23,
      "text_uthmani": "اِلَّا مَن تَوَلّ۪ىٰ وَكَفَرَ ٢٣",
      "text_simple": "الا من تولي وكفر ٢٣",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5966,
      "number": 24,
      "text_uthmani": "فَيُعَذِّبُهُ اُ۬للَّهُ اُ۬لْعَذَابَ اَ۬لَاكْبَرَۖ ٢٤",
      "text_simple": "فيعذبه الله العذاب الاكبر ٢٤",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5967,
      "number": 25,
      "text_uthmani": "إِنَّ إِلَيْنَآ إِيَابَهُمْ ٢٥",
      "text_simple": "ان الينآ ايابهم ٢٥",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5968,
      "number": 26,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُمْۖ ٢٦",
      "text_simple": "ثم ان علينا حسابهم ٢٦",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    }
  ]
}