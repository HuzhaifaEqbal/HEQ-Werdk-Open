{
  "number": 80,
  "name_ar": "عَبَسَ",
  "name_en": "‘Abasa",
  "ayahs_count": 42,
  "page_start": 585,
  "page_end": 586,
  "ayahs": [
    {
      "id": 5734,
      "number": 1,
      "text_uthmani": "عَبَسَ وَتَوَلّ۪ىٰٓ ١",
      "text_simple": "عبس وتوليٓ ١",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5735,
      "number": 2,
      "text_uthmani": "أَن جَآءَهُ اُ۬لَاعْم۪ىٰۖ ٢",
      "text_simple": "ان جآءه الاعمي ٢",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5736,
      "number": 3,
      "text_uthmani": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكّ۪ىٰٓ ٣",
      "text_simple": "وما يدريك لعله يزكيٓ ٣",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5737,
      "number": 4,
      "text_uthmani": "أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْر۪ىٰٓۖ ٤",
      "text_simple": "او يذكر فتنفعه الذكريٓ ٤",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5738,
      "number": 5,
      "text_uthmani": "أَمَّا مَنِ اِ۪سْتَغْن۪ىٰ ٥",
      "text_simple": "اما من استغني ٥",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5739,
      "number": 6,
      "text_uthmani": "فَأَنتَ لَهُۥ تَصَّدّ۪ىٰ ٦",
      "text_simple": "فانت له تصدي ٦",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5740,
      "number": 7,
      "text_uthmani": "وَمَا عَلَيْكَ أَلَّا يَزَّكّ۪ىٰۖ ٧",
      "text_simple": "وما عليك الا يزكي ٧",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5741,
      "number": 8,
      "text_uthmani": "وَأَمَّا مَن جَآءَكَ يَسْع۪ىٰ ٨",
      "text_simple": "واما من جآءك يسعي ٨",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5742,
      "number": 9,
      "text_uthmani": "وَهُوَ يَخْش۪ىٰ ٩",
      "text_simple": "وهو يخشي ٩",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5743,
      "number": 10,
      "text_uthmani": "فَأَنتَ عَنْهُ تَلَهّ۪ىٰ ١٠",
      "text_simple": "فانت عنه تلهي ١٠",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5744,
      "number": 11,
      "text_uthmani": "كَلَّآۖ إِنَّهَا تَذْكِرَةٞۖ ١١",
      "text_simple": "كلآ انها تذكرهٞ ١١",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5745,
      "number": 12,
      "text_uthmani": "فَمَن شَآءَ ذَكَرَهُۥ ١٢",
      "text_simple": "فمن شآء ذكره ١٢",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5746,
      "number": 13,
      "text_uthmani": "فِے صُحُفٖ مُّكَرَّمَةٖ ١٣",
      "text_simple": "فے صحفٖ مكرمهٖ ١٣",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5747,
      "number": 14,
      "text_uthmani": "مَّرْفُوعَةٖ مُّطَهَّرَةِۢ ١٤",
      "text_simple": "مرفوعهٖ مطهره ١٤",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5748,
      "number": 15,
      "text_uthmani": "بِأَيْدِے سَفَرَةٖ ١٥",
      "text_simple": "بايدے سفرهٖ ١٥",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5749,
      "number": 16,
      "text_uthmani": "كِرَامِۢ بَرَرَةٖۖ ١٦",
      "text_simple": "كرام بررهٖ ١٦",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5750,
      "number": 17,
      "text_uthmani": "قُتِلَ اَ۬لِانسَٰنُ مَآ أَكْفَرَهُۥۖ ١٧",
      "text_simple": "قتل الانسن مآ اكفره ١٧",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5751,
      "number": 18,
      "text_uthmani": "مِنَ اَيِّ شَےْءٍ خَلَقَهُۥۖ ١٨",
      "text_simple": "من اي شےء خلقه ١٨",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5752,
      "number": 19,
      "text_uthmani": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩",
      "text_simple": "من نطفه خلقه فقدره ١٩",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5753,
      "number": 20,
      "text_uthmani": "ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ ٢٠",
      "text_simple": "ثم السبيل يسره ٢٠",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5754,
      "number": 21,
      "text_uthmani": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ ٢١",
      "text_simple": "ثم اماته فاقبره ٢١",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5755,
      "number": 22,
      "text_uthmani": "ثُمَّ إِذَا شَآءَ انشَرَهُۥۖ ٢٢",
      "text_simple": "ثم اذا شآء انشره ٢٢",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5756,
      "number": 23,
      "text_uthmani": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥۖ ٢٣",
      "text_simple": "كلا لما يقض مآ امره ٢٣",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5757,
      "number": 24,
      "text_uthmani": "فَلْيَنظُرِ اِ۬لِانسَٰنُ إِلَىٰ طَعَامِهِۦٓۖ ٢٤",
      "text_simple": "فلينظر الانسن الي طعامهٓ ٢٤",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5758,
      "number": 25,
      "text_uthmani": "إِنَّا صَبَبْنَا اَ۬لْمَآءَ صَبّاٗ ٢٥",
      "text_simple": "انا صببنا المآء صباٗ ٢٥",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5759,
      "number": 26,
      "text_uthmani": "ثُمَّ شَقَقْنَا اَ۬لَارْضَ شَقّاٗ ٢٦",
      "text_simple": "ثم شققنا الارض شقاٗ ٢٦",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5760,
      "number": 27,
      "text_uthmani": "فَأَنۢبَتْنَا فِيهَا حَبّاٗ ٢٧",
      "text_simple": "فانبتنا فيها حباٗ ٢٧",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5761,
      "number": 28,
      "text_uthmani": "وَعِنَباٗ وَقَضْباٗ ٢٨",
      "text_simple": "وعنباٗ وقضباٗ ٢٨",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5762,
      "number": 29,
      "text_uthmani": "وَزَيْتُوناٗ وَنَخْلاٗ ٢٩",
      "text_simple": "وزيتوناٗ ونخلاٗ ٢٩",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5763,
      "number": 30,
      "text_uthmani": "وَحَدَآئِقَ غُلْباٗ ٣٠",
      "text_simple": "وحدآئق غلباٗ ٣٠",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5764,
      "number": 31,
      "text_uthmani": "وَفَٰكِهَةٗ وَأَبّاٗ ٣١",
      "text_simple": "وفكههٗ واباٗ ٣١",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5765,
      "number": 32,
      "text_uthmani": "مَّتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ ٣٢",
      "text_simple": "متعاٗ لكم ولانعمكم ٣٢",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5766,
      "number": 33,
      "text_uthmani": "فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ ٣٣",
      "text_simple": "فاذا جآءت الصآخه ٣٣",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5767,
      "number": 34,
      "text_uthmani": "يَوْمَ يَفِرُّ اُ۬لْمَرْءُ مِنَ اَخِيهِ ٣٤",
      "text_simple": "يوم يفر المرء من اخيه ٣٤",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5768,
      "number": 35,
      "text_uthmani": "وَأُمِّهِۦ وَأَبِيهِ ٣٥",
      "text_simple": "وامه وابيه ٣٥",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5769,
      "number": 36,
      "text_uthmani": "وَصَٰحِبَتِهِۦ وَبَنِيهِۖ ٣٦",
      "text_simple": "وصحبته وبنيه ٣٦",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5770,
      "number": 37,
      "text_uthmani": "لِكُلِّ اِ۪مْرِےٕٖ مِّنْهُمْ يَوْمَئِذٖ شَأْنٞ يُغْنِيهِۖ ٣٧",
      "text_simple": "لكل امرےٕٖ منهم يومئذٖ شانٞ يغنيه ٣٧",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5771,
      "number": 38,
      "text_uthmani": "وُجُوهٞ يَوْمَئِذٖ مُّسْفِرَةٞ ٣٨",
      "text_simple": "وجوهٞ يومئذٖ مسفرهٞ ٣٨",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5772,
      "number": 39,
      "text_uthmani": "ضَاحِكَةٞ مُّسْتَبْشِرَةٞۖ ٣٩",
      "text_simple": "ضاحكهٞ مستبشرهٞ ٣٩",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5773,
      "number": 40,
      "text_uthmani": "وَوُجُوهٞ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٞ ٤٠",
      "text_simple": "ووجوهٞ يومئذ عليها غبرهٞ ٤٠",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5774,
      "number": 41,
      "text_uthmani": "تَرْهَقُهَا قَتَرَةٌۖ ٤١",
      "text_simple": "ترهقها قتره ٤١",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5775,
      "number": 42,
      "text_uthmani": "ا۟وْلَٰٓئِكَ هُمُ اُ۬لْكَفَرَةُ اُ۬لْفَجَرَةُۖ ٤٢",
      "text_simple": "اولٓئك هم الكفره الفجره ٤٢",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    }
  ]
}