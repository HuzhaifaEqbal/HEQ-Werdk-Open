{
  "number": 55,
  "name_ar": "الرَّحمٰن",
  "name_en": "Ar-Raḥmān",
  "ayahs_count": 77,
  "page_start": 531,
  "page_end": 534,
  "ayahs": [
    {
      "id": 4879,
      "number": 1,
      "text_uthmani": "اِ۬لرَّحْمَٰنُ عَلَّمَ اَ۬لْقُرْءَانَۖ ١",
      "text_simple": "الرحمن علم القرءان ١",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4880,
      "number": 2,
      "text_uthmani": "خَلَقَ اَ۬لِانسَٰنَ عَلَّمَهُ اُ۬لْبَيَانَۖ ٢",
      "text_simple": "خلق الانسن علمه البيان ٢",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4881,
      "number": 3,
      "text_uthmani": "اَ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانٖۖ ٣",
      "text_simple": "الشمس والقمر بحسبانٖ ٣",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 4882,
      "number": 4,
      "text_uthmani": "وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِۖ ٤",
      "text_simple": "والنجم والشجر يسجدن ٤",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 4883,
      "number": 5,
      "text_uthmani": "وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لْمِيزَانَ ٥",
      "text_simple": "والسمآء رفعها ووضع الميزان ٥",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4884,
      "number": 6,
      "text_uthmani": "أَلَّا تَطْغَوْاْ فِے اِ۬لْمِيزَانِ ٦",
      "text_simple": "الا تطغوا فے الميزان ٦",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4885,
      "number": 7,
      "text_uthmani": "وَأَقِيمُواْ اُ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ اُ۬لْمِيزَانَۖ ٧",
      "text_simple": "واقيموا الوزن بالقسط ولا تخسروا الميزان ٧",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4886,
      "number": 8,
      "text_uthmani": "وَالَارْضَ وَضَعَهَا لِلَانَامِ ٨",
      "text_simple": "والارض وضعها للانام ٨",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 4887,
      "number": 9,
      "text_uthmani": "فِيهَا فَٰكِهَةٞ وَالنَّخْلُ ذَاتُ اُ۬لَاكْمَامِ ٩",
      "text_simple": "فيها فكههٞ والنخل ذات الاكمام ٩",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 4888,
      "number": 10,
      "text_uthmani": "وَالْحَبُّ ذُو اُ۬لْعَصْفِ وَالرَّيْحَانُۖ ١٠",
      "text_simple": "والحب ذو العصف والريحان ١٠",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 4889,
      "number": 11,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ١١",
      "text_simple": "فباي ءالآء ربكما تكذبان ١١",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 4890,
      "number": 12,
      "text_uthmani": "خَلَقَ اَ۬لِانسَٰنَ مِن صَلْصَٰلٖ كَالْفَخّ۪ارِ ١٢",
      "text_simple": "خلق الانسن من صلصلٖ كالفخار ١٢",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 4891,
      "number": 13,
      "text_uthmani": "وَخَلَقَ اَ۬لْجَآنَّ مِن مَّارِجٖ مِّن نّ۪ارٖۖ ١٣",
      "text_simple": "وخلق الجآن من مارجٖ من نارٖ ١٣",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 4892,
      "number": 14,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ١٤",
      "text_simple": "فباي ءالآء ربكما تكذبان ١٤",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4893,
      "number": 15,
      "text_uthmani": "رَبُّ اُ۬لْمَشْرِقَيْنِ وَرَبُّ اُ۬لْمَغْرِبَيْنِۖ ١٥",
      "text_simple": "رب المشرقين ورب المغربين ١٥",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 4894,
      "number": 16,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ١٦",
      "text_simple": "فباي ءالآء ربكما تكذبان ١٦",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 4895,
      "number": 17,
      "text_uthmani": "مَرَجَ اَ۬لْبَحْرَيْنِ يَلْتَقِيَٰنِ ١٧",
      "text_simple": "مرج البحرين يلتقين ١٧",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4896,
      "number": 18,
      "text_uthmani": "بَيْنَهُمَا بَرْزَخٞ لَّا يَبْغِيَٰنِۖ ١٨",
      "text_simple": "بينهما برزخٞ لا يبغين ١٨",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4897,
      "number": 19,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ١٩",
      "text_simple": "فباي ءالآء ربكما تكذبان ١٩",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 4898,
      "number": 20,
      "text_uthmani": "يُخْرَجُ مِنْهُمَا اَ۬للُّؤْلُؤُاْ وَالْمَرْجَانُۖ ٢٠",
      "text_simple": "يخرج منهما اللؤلؤا والمرجان ٢٠",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 4899,
      "number": 21,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ٢١",
      "text_simple": "فباي ءالآء ربكما تكذبان ٢١",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 4900,
      "number": 22,
      "text_uthmani": "وَلَهُ اُ۬لْجَوَارِ اِ۬لْمُنشَأَٰتُ فِے اِ۬لْبَحْرِ كَالَاعْلَٰمِۖ ٢٢",
      "text_simple": "وله الجوار المنشات فے البحر كالاعلم ٢٢",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 4901,
      "number": 23,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ٢٣",
      "text_simple": "فباي ءالآء ربكما تكذبان ٢٣",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 4902,
      "number": 24,
      "text_uthmani": "كُلُّ مَنْ عَلَيْهَا فَانٖ ٢٤",
      "text_simple": "كل من عليها فانٖ ٢٤",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 4903,
      "number": 25,
      "text_uthmani": "وَيَبْق۪ىٰ وَجْهُ رَبِّكَ ذُو اُ۬لْجَلَٰلِ وَالِاكْرَامِۖ ٢٥",
      "text_simple": "ويبقي وجه ربك ذو الجلل والاكرام ٢٥",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 4904,
      "number": 26,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ٢٦",
      "text_simple": "فباي ءالآء ربكما تكذبان ٢٦",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 4905,
      "number": 27,
      "text_uthmani": "يَسْـَٔلُهُۥ مَن فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِ كُلَّ يَوْمٍ هُوَ فِے شَأْنٖۖ ٢٧",
      "text_simple": "يسـٔله من فے السموت والارض كل يوم هو فے شانٖ ٢٧",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 4906,
      "number": 28,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ٢٨",
      "text_simple": "فباي ءالآء ربكما تكذبان ٢٨",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 4907,
      "number": 29,
      "text_uthmani": "سَنَفْرُغُ لَكُمُۥٓ أَيُّهَ اَ۬لثَّقَلَٰنِۖ ٢٩",
      "text_simple": "سنفرغ لكمٓ ايه الثقلن ٢٩",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4908,
      "number": 30,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ٣٠",
      "text_simple": "فباي ءالآء ربكما تكذبان ٣٠",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 4909,
      "number": 31,
      "text_uthmani": "يَٰمَعْشَرَ اَ۬لْجِنِّ وَالِانسِ إِنِ اِ۪سْتَطَعْتُمُۥٓ أَن تَنفُذُواْ مِنَ اَقْط۪ارِ اِ۬لسَّمَٰوَٰتِ وَالَارْضِ فَانفُذُواْۖ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٖۖ ٣١",
      "text_simple": "يمعشر الجن والانس ان استطعتمٓ ان تنفذوا من اقطار السموت والارض فانفذوا لا تنفذون الا بسلطنٖ ٣١",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 8,
      "line_end": 10
    },
    {
      "id": 4910,
      "number": 32,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ٣٢",
      "text_simple": "فباي ءالآء ربكما تكذبان ٣٢",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4911,
      "number": 33,
      "text_uthmani": "يُرْسَلُ عَلَيْكُمَا شُوَاظٞ مِّن نّ۪ارٖ ٣٣",
      "text_simple": "يرسل عليكما شواظٞ من نارٖ ٣٣",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 4912,
      "number": 34,
      "text_uthmani": "وَنُحَاسٞ فَلَا تَنتَصِرَٰنِۖ ٣٤",
      "text_simple": "ونحاسٞ فلا تنتصرن ٣٤",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 4913,
      "number": 35,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ٣٥",
      "text_simple": "فباي ءالآء ربكما تكذبان ٣٥",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 4914,
      "number": 36,
      "text_uthmani": "فَإِذَا اَ۪نشَقَّتِ اِ۬لسَّمَآءُ فَكَانَتْ وَرْدَةٗ كَالدِّهَانِ ٣٦",
      "text_simple": "فاذا انشقت السمآء فكانت وردهٗ كالدهان ٣٦",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 4915,
      "number": 37,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٧",
      "text_simple": "فباي ءالآء ربكما تكذبان ٣٧",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 4916,
      "number": 38,
      "text_uthmani": "فَيَوْمَئِذٖ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞۖ ٣٨",
      "text_simple": "فيومئذٖ لا يسـٔل عن ذنبهٓ انسٞ ولا جآنٞ ٣٨",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 4917,
      "number": 39,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ٣٩",
      "text_simple": "فباي ءالآء ربكما تكذبان ٣٩",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4918,
      "number": 40,
      "text_uthmani": "۞ يُعْرَفُ اُ۬لْمُجْرِمُونَ بِسِيمٰ۪هُمْ فَيُوخَذُ بِالنَّوَٰصِے وَالَاقْدَامِۖ ٤٠",
      "text_simple": "يعرف المجرمون بسيمهم فيوخذ بالنوصے والاقدام ٤٠",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 4919,
      "number": 41,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ٤١",
      "text_simple": "فباي ءالآء ربكما تكذبان ٤١",
      "juz": 27,
      "page": 533,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4920,
      "number": 42,
      "text_uthmani": "هَٰذِهِۦ جَهَنَّمُ اُ۬لتِے يُكَذِّبُ بِهَا اَ۬لْمُجْرِمُونَ ٤٢",
      "text_simple": "هذه جهنم التے يكذب بها المجرمون ٤٢",
      "juz": 27,
      "page": 533,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 4921,
      "number": 43,
      "text_uthmani": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ اٰنٖۖ ٤٣",
      "text_simple": "يطوفون بينها وبين حميم انٖ ٤٣",
      "juz": 27,
      "page": 533,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 4922,
      "number": 44,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ ٤٤",
      "text_simple": "فباي ءالآء ربكما تكذبان ٤٤",
      "juz": 27,
      "page": 533,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 4923,
      "number": 45,
