{
  "number": 79,
  "name_ar": "النَّازعَات",
  "name_en": "An-Nāzi‘āt",
  "ayahs_count": 45,
  "page_start": 583,
  "page_end": 584,
  "ayahs": [
    {
      "id": 5689,
      "number": 1,
      "text_uthmani": "وَالنَّٰزِعَٰتِ غَرْقاٗ ١",
      "text_simple": "والنزعت غرقاٗ ١",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5690,
      "number": 2,
      "text_uthmani": "وَالنَّٰشِطَٰتِ نَشْطاٗ ٢",
      "text_simple": "والنشطت نشطاٗ ٢",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5691,
      "number": 3,
      "text_uthmani": "وَالسَّٰبِحَٰتِ سَبْحاٗ ٣",
      "text_simple": "والسبحت سبحاٗ ٣",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5692,
      "number": 4,
      "text_uthmani": "فَالسَّٰبِقَٰتِ سَبْقاٗ ٤",
      "text_simple": "فالسبقت سبقاٗ ٤",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5693,
      "number": 5,
      "text_uthmani": "فَالْمُدَبِّرَٰتِ أَمْراٗ ٥",
      "text_simple": "فالمدبرت امراٗ ٥",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5694,
      "number": 6,
      "text_uthmani": "يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ ٦",
      "text_simple": "يوم ترجف الراجفه ٦",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5695,
      "number": 7,
      "text_uthmani": "تَتْبَعُهَا اَ۬لرَّادِفَةُۖ ٧",
      "text_simple": "تتبعها الرادفه ٧",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5696,
      "number": 8,
      "text_uthmani": "قُلُوبٞ يَوْمَئِذٖ وَاجِفَةٌ ٨",
      "text_simple": "قلوبٞ يومئذٖ واجفه ٨",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5697,
      "number": 9,
      "text_uthmani": "اَبْصَٰرُهَا خَٰشِعَةٞۖ ٩",
      "text_simple": "ابصرها خشعهٞ ٩",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5698,
      "number": 10,
      "text_uthmani": "يَقُولُونَ أَ۟نَّا لَمَرْدُودُونَ فِے اِ۬لْحَافِرَةِ ١٠",
      "text_simple": "يقولون انا لمردودون فے الحافره ١٠",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5699,
      "number": 11,
      "text_uthmani": "إِذَا كُنَّا عِظَٰماٗ نَّخِرَةٗۖ ١١",
      "text_simple": "اذا كنا عظماٗ نخرهٗ ١١",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5700,
      "number": 12,
      "text_uthmani": "قَالُواْ تِلْكَ إِذاٗ كَرَّةٌ خَاسِرَةٞ ١٢",
      "text_simple": "قالوا تلك اذاٗ كره خاسرهٞ ١٢",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5701,
      "number": 13,
      "text_uthmani": "فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ ١٣",
      "text_simple": "فانما هي زجرهٞ وحدهٞ ١٣",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5702,
      "number": 14,
      "text_uthmani": "فَإِذَا هُم بِالسَّاهِرَةِۖ ١٤",
      "text_simple": "فاذا هم بالساهره ١٤",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5703,
      "number": 15,
      "text_uthmani": "هَلَ اَت۪يٰكَ حَدِيثُ مُوس۪ىٰٓ ١٥",
      "text_simple": "هل اتيك حديث موسيٓ ١٥",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5704,
      "number": 16,
      "text_uthmani": "إِذْ نَاد۪يٰهُ رَبُّهُۥ بِالْوَادِ اِ۬لْمُقَدَّسِ طُوَىۖ ١٦",
      "text_simple": "اذ ناديه ربه بالواد المقدس طوي ١٦",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5705,
      "number": 17,
      "text_uthmani": "اَ۪ذْهَبِ اِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغ۪ىٰ ١٧",
      "text_simple": "اذهب الي فرعون انه طغي ١٧",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5706,
      "number": 18,
      "text_uthmani": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَّكّ۪ىٰ ١٨",
      "text_simple": "فقل هل لك اليٓ ان تزكي ١٨",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5707,
      "number": 19,
      "text_uthmani": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْش۪ىٰۖ ١٩",
      "text_simple": "واهديك الي ربك فتخشي ١٩",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5708,
      "number": 20,
      "text_uthmani": "فَأَر۪يٰهُ اُ۬لَايَةَ اَ۬لْكُبْر۪ىٰ ٢٠",
      "text_simple": "فاريه الايه الكبري ٢٠",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5709,
      "number": 21,
      "text_uthmani": "فَكَذَّبَ وَعَص۪ىٰ ٢١",
      "text_simple": "فكذب وعصي ٢١",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5710,
      "number": 22,
      "text_uthmani": "ثُمَّ أَدْبَرَ يَسْع۪ىٰ ٢٢",
      "text_simple": "ثم ادبر يسعي ٢٢",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5711,
      "number": 23,
      "text_uthmani": "فَحَشَرَ فَنَاد۪ىٰ ٢٣",
      "text_simple": "فحشر فنادي ٢٣",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5712,
      "number": 24,
      "text_uthmani": "فَقَالَ أَنَا رَبُّكُمُ اُ۬لَاعْل۪ىٰ ٢٤",
      "text_simple": "فقال انا ربكم الاعلي ٢٤",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5713,
      "number": 25,
      "text_uthmani": "فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لَاخِرَةِ وَالُاول۪ىٰٓۖ ٢٥",
      "text_simple": "فاخذه الله نكال الاخره والاوليٓ ٢٥",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5714,
      "number": 26,
      "text_uthmani": "إِنَّ فِے ذَٰلِكَ لَعِبْرَةٗ لِّمَنْ يَّخْش۪ىٰٓۖ ٢٦",
      "text_simple": "ان فے ذلك لعبرهٗ لمن يخشيٓ ٢٦",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5715,
      "number": 27,
      "text_uthmani": "ءَآنتُمُۥٓ أَشَدُّ خَلْقاً اَمِ اِ۬لسَّمَآءُۖ بَنَيٰهَا ٢٧",
      "text_simple": "ءآنتمٓ اشد خلقا ام السمآء بنيها ٢٧",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5716,
      "number": 28,
      "text_uthmani": "رَفَعَ سَمْكَهَا فَسَوَّيٰهَا ٢٨",
      "text_simple": "رفع سمكها فسويها ٢٨",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5717,
      "number": 29,
      "text_uthmani": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ ٢٩",
      "text_simple": "واغطش ليلها واخرج ضحيها ٢٩",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5718,
      "number": 30,
      "text_uthmani": "وَالَارْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَآ ٣٠",
      "text_simple": "والارض بعد ذلك دحيهآ ٣٠",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5719,
      "number": 31,
      "text_uthmani": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا ٣١",
      "text_simple": "اخرج منها مآءها ومرعيها ٣١",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5720,
      "number": 32,
      "text_uthmani": "وَالْجِبَالَ أَرْسَيٰهَا ٣٢",
      "text_simple": "والجبال ارسيها ٣٢",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5721,
      "number": 33,
      "text_uthmani": "مَتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ ٣٣",
      "text_simple": "متعاٗ لكم ولانعمكم ٣٣",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5722,
      "number": 34,
      "text_uthmani": "فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لْكُبْر۪ىٰ ٣٤",
      "text_simple": "فاذا جآءت الطآمه الكبري ٣٤",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5723,
      "number": 35,
      "text_uthmani": "يَوْمَ يَتَذَكَّرُ اُ۬لِانسَٰنُ مَا سَع۪ىٰ ٣٥",
      "text_simple": "يوم يتذكر الانسن ما سعي ٣٥",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5724,
      "number": 36,
      "text_uthmani": "وَبُرِّزَتِ اِ۬لْجَحِيمُ لِمَنْ يَّر۪ىٰۖ ٣٦",
      "text_simple": "وبرزت الجحيم لمن يري ٣٦",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5725,
      "number": 37,
      "text_uthmani": "فَأَمَّا مَن طَغ۪ىٰ وَءَاثَرَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا ٣٧",
      "text_simple": "فاما من طغي وءاثر الحيوه الدنيا ٣٧",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5726,
      "number": 38,
      "text_uthmani": "فَإِنَّ اَ۬لْجَحِيمَ هِيَ اَ۬لْمَأْو۪ىٰۖ ٣٨",
      "text_simple": "فان الجحيم هي الماوي ٣٨",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5727,
      "number": 39,
      "text_uthmani": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفْسَ عَنِ اِ۬لْهَو۪ىٰ ٣٩",
      "text_simple": "واما من خاف مقام ربه ونهي النفس عن الهوي ٣٩",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5728,
      "number": 40,
      "text_uthmani": "فَإِنَّ اَ۬لْجَنَّةَ هِيَ اَ۬لْمَأْو۪ىٰۖ ٤٠",
      "text_simple": "فان الجنه هي الماوي ٤٠",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5729,
      "number": 41,
      "text_uthmani": "۞ يَسْـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرْسَيٰهَاۖ ٤١",
      "text_simple": "يسـٔلونك عن الساعه ايان مرسيها ٤١",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5730,
      "number": 42,
      "text_uthmani": "فِيمَ أَنتَ مِن ذِكْر۪يٰهَآۖ ٤٢",
      "text_simple": "فيم انت من ذكريهآ ٤٢",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5731,
      "number": 43,
      "text_uthmani": "إِلَىٰ رَبِّكَ مُنتَهَيٰهَآۖ ٤٣",
      "text_simple": "الي ربك منتهيهآ ٤٣",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5732,
      "number": 44,
      "text_uthmani": "إِنَّمَآ أَنتَ مُنذِرُ مَنْ يَّخْشَيٰهَاۖ ٤٤",
      "text_simple": "انمآ انت منذر من يخشيها ٤٤",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5733,
      "number": 45,
      "text_uthmani": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓاْ إِلَّا عَشِيَّةً اَوْ ضُحَيٰهَاۖ ٤٥",
      "text_simple": "كانهم يوم يرونها لم يلبثوٓا الا عشيه او ضحيها ٤٥",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    }
  ]
}