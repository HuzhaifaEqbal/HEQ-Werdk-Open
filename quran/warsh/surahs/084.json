{
  "number": 84,
  "name_ar": "الانشِقَاق",
  "name_en": "Al-Inshiqāq",
  "ayahs_count": 25,
  "page_start": 589,
  "page_end": 590,
  "ayahs": [
    {
      "id": 5860,
      "number": 1,
      "text_uthmani": "إِذَا اَ۬لسَّمَآءُ اُ۪نشَقَّتْ ١",
      "text_simple": "اذا السمآء انشقت ١",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5861,
      "number": 2,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ ٢",
      "text_simple": "واذنت لربها وحقت ٢",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5862,
      "number": 3,
      "text_uthmani": "وَإِذَا اَ۬لَارْضُ مُدَّتْ ٣",
      "text_simple": "واذا الارض مدت ٣",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5863,
      "number": 4,
      "text_uthmani": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ ٤",
      "text_simple": "والقت ما فيها وتخلت ٤",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5864,
      "number": 5,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْۖ ٥",
      "text_simple": "واذنت لربها وحقت ٥",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5865,
      "number": 6,
      "text_uthmani": "يَٰٓأَيُّهَا اَ۬لِانسَٰنُ إِنَّكَ كَادِحٌ اِلَىٰ رَبِّكَ كَدْحاٗ فَمُلَٰقِيهِۖ ٦",
      "text_simple": "يٓايها الانسن انك كادح الي ربك كدحاٗ فملقيه ٦",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5866,
      "number": 7,
      "text_uthmani": "فَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ ٧",
      "text_simple": "فاما من اوتي كتبه بيمينه ٧",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5867,
      "number": 8,
      "text_uthmani": "فَسَوْفَ يُحَاسَبُ حِسَاباٗ يَسِيراٗ ٨",
      "text_simple": "فسوف يحاسب حساباٗ يسيراٗ ٨",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5868,
      "number": 9,
      "text_uthmani": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُوراٗۖ ٩",
      "text_simple": "وينقلب اليٓ اهله مسروراٗ ٩",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5869,
      "number": 10,
      "text_uthmani": "وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ ١٠",
      "text_simple": "واما من اوتي كتبه ورآء ظهره ١٠",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5870,
      "number": 11,
      "text_uthmani": "فَسَوْفَ يَدْعُواْ ثُبُوراٗ ١١",
      "text_simple": "فسوف يدعوا ثبوراٗ ١١",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5871,
      "number": 12,
      "text_uthmani": "وَيُصَلَّىٰ سَعِيراًۖ ١٢",
      "text_simple": "ويصلي سعيرا ١٢",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5872,
      "number": 13,
      "text_uthmani": "اِنَّهُۥ كَانَ فِےٓ أَهْلِهِۦ مَسْرُوراًۖ ١٣",
      "text_simple": "انه كان فےٓ اهله مسرورا ١٣",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5873,
      "number": 14,
      "text_uthmani": "اِنَّهُۥ ظَنَّ أَن لَّنْ يَّحُورَ ١٤",
      "text_simple": "انه ظن ان لن يحور ١٤",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5874,
      "number": 15,
      "text_uthmani": "بَل۪ىٰٓۖ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيراٗۖ ١٥",
      "text_simple": "بليٓ ان ربه كان به بصيراٗ ١٥",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5875,
      "number": 16,
      "text_uthmani": "۞ فَلَآ أُقْسِمُ بِالشَّفَقِ ١٦",
      "text_simple": "فلآ اقسم بالشفق ١٦",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5876,
      "number": 17,
      "text_uthmani": "وَاليْلِ وَمَا وَسَقَ ١٧",
      "text_simple": "واليل وما وسق ١٧",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5877,
      "number": 18,
      "text_uthmani": "وَالْقَمَرِ إِذَا اَ۪تَّسَقَ ١٨",
      "text_simple": "والقمر اذا اتسق ١٨",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5878,
      "number": 19,
      "text_uthmani": "لَتَرْكَبُنَّ طَبَقاً عَن طَبَقٖۖ ١٩",
      "text_simple": "لتركبن طبقا عن طبقٖ ١٩",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5879,
      "number": 20,
      "text_uthmani": "فَمَا لَهُمْ لَا يُومِنُونَ ٢٠",
      "text_simple": "فما لهم لا يومنون ٢٠",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5880,
      "number": 21,
      "text_uthmani": "وَإِذَا قُرِۓَ عَلَيْهِمُ اُ۬لْقُرْءَانُ لَا يَسْجُدُونَۖ ٢١",
      "text_simple": "واذا قرۓ عليهم القرءان لا يسجدون ٢١",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5881,
      "number": 22,
      "text_uthmani": "بَلِ اِ۬لذِينَ كَفَرُواْ يُكَذِّبُونَ ٢٢",
      "text_simple": "بل الذين كفروا يكذبون ٢٢",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5882,
      "number": 23,
      "text_uthmani": "وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَۖ ٢٣",
      "text_simple": "والله اعلم بما يوعون ٢٣",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5883,
      "number": 24,
      "text_uthmani": "فَبَشِّرْهُم بِعَذَابٍ اَلِيمٍۖ ٢٤",
      "text_simple": "فبشرهم بعذاب اليم ٢٤",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5884,
      "number": 25,
      "text_uthmani": "اِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونٖۖ ٢٥",
      "text_simple": "الا الذين ءامنوا وعملوا الصلحت لهمٓ اجر غير ممنونٖ ٢٥",
      "juz": 30,
      "page": 590,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    }
  ]
}