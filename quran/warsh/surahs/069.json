{
  "number": 69,
  "name_ar": "الحَاقة",
  "name_en": "Al-Ḥāqqah",
  "ayahs_count": 52,
  "page_start": 566,
  "page_end": 568,
  "ayahs": [
    {
      "id": 5302,
      "number": 1,
      "text_uthmani": "اَ۬لْحَآقَّةُ مَا اَ۬لْحَآقَّةُۖ ١",
      "text_simple": "الحآقه ما الحآقه ١",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5303,
      "number": 2,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحَآقَّةُۖ ٢",
      "text_simple": "ومآ ادريك ما الحآقه ٢",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5304,
      "number": 3,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ وَعَادُۢ بِالْقَارِعَةِۖ ٣",
      "text_simple": "كذبت ثمود وعاد بالقارعه ٣",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5305,
      "number": 4,
      "text_uthmani": "فَأَمَّا ثَمُودُ فَأُهْلِكُواْ بِالطَّاغِيَةِۖ ٤",
      "text_simple": "فاما ثمود فاهلكوا بالطاغيه ٤",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5306,
      "number": 5,
      "text_uthmani": "وَأَمَّا عَادٞ فَأُهْلِكُواْ بِرِيحٖ صَرْصَرٍ عَاتِيَةٖ ٥",
      "text_simple": "واما عادٞ فاهلكوا بريحٖ صرصر عاتيهٖ ٥",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5307,
      "number": 6,
      "text_uthmani": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُوماٗۖ فَتَرَى اَ۬لْقَوْمَ فِيهَا صَرْع۪ىٰ كَأَنَّهُمُۥٓ أَعْجَازُ نَخْلٍ خَاوِيَةٖۖ ٦",
      "text_simple": "سخرها عليهم سبع ليالٖ وثمنيه ايام حسوماٗ فتري القوم فيها صرعي كانهمٓ اعجاز نخل خاويهٖ ٦",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5308,
      "number": 7,
      "text_uthmani": "فَهَلْ تَر۪ىٰ لَهُم مِّنۢ بَاقِيَةٖۖ ٧",
      "text_simple": "فهل تري لهم من باقيهٖ ٧",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5309,
      "number": 8,
      "text_uthmani": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَالْمُوتَفِكَٰتُ بِالْخَاطِئَةِ ٨",
      "text_simple": "وجآء فرعون ومن قبله والموتفكت بالخاطئه ٨",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5310,
      "number": 9,
      "text_uthmani": "فَعَصَوْاْ رَسُولَ رَبِّهِمْ فَأَخَذَهُمُۥٓ أَخْذَةٗ رَّابِيَةًۖ ٩",
      "text_simple": "فعصوا رسول ربهم فاخذهمٓ اخذهٗ رابيه ٩",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5311,
      "number": 10,
      "text_uthmani": "اِنَّا لَمَّا طَغَا اَ۬لْمَآءُ حَمَلْنَٰكُمْ فِے اِ۬لْجَارِيَةِ ١٠",
      "text_simple": "انا لما طغا المآء حملنكم فے الجاريه ١٠",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5312,
      "number": 11,
      "text_uthmani": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةٗ وَتَعِيَهَآ أُذْنٞ وَٰعِيَةٞۖ ١١",
      "text_simple": "لنجعلها لكم تذكرهٗ وتعيهآ اذنٞ وعيهٞ ١١",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5313,
      "number": 12,
      "text_uthmani": "فَإِذَا نُفِخَ فِے اِ۬لصُّورِ نَفْخَةٞ وَٰحِدَةٞ ١٢",
      "text_simple": "فاذا نفخ فے الصور نفخهٞ وحدهٞ ١٢",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5314,
      "number": 13,
      "text_uthmani": "وَحُمِلَتِ اِ۬لَارْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ ١٣",
      "text_simple": "وحملت الارض والجبال فدكتا دكهٗ وحدهٗ ١٣",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5315,
      "number": 14,
      "text_uthmani": "فَيَوْمَئِذٖ وَقَعَتِ اِ۬لْوَاقِعَةُ ١٤",
      "text_simple": "فيومئذٖ وقعت الواقعه ١٤",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5316,
      "number": 15,
      "text_uthmani": "وَانشَقَّتِ اِ۬لسَّمَآءُ فَهِيَ يَوْمَئِذٖ وَاهِيَةٞ ١٥",
      "text_simple": "وانشقت السمآء فهي يومئذٖ واهيهٞ ١٥",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5317,
      "number": 16,
      "text_uthmani": "وَالْمَلَكُ عَلَىٰٓ أَرْجَآئِهَاۖ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٖ ثَمَٰنِيَةٞ ١٦",
      "text_simple": "والملك عليٓ ارجآئها ويحمل عرش ربك فوقهم يومئذٖ ثمنيهٞ ١٦",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5318,
      "number": 17,
      "text_uthmani": "يَوْمَئِذٖ تُعْرَضُونَ لَا تَخْف۪ىٰ مِنكُمْ خَافِيَةٞۖ ١٧",
      "text_simple": "يومئذٖ تعرضون لا تخفي منكم خافيهٞ ١٧",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5319,
      "number": 18,
      "text_uthmani": "۞ فَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ اُ۪قْرَءُواْ كِتَٰبِيَهْۖ ١٨",
      "text_simple": "فاما من اوتي كتبه بيمينه فيقول هآؤم اقرءوا كتبيه ١٨",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5320,
      "number": 19,
      "text_uthmani": "إِنِّے ظَنَنتُ أَنِّے مُلَٰقٍ حِسَابِيَهْۖ ١٩",
      "text_simple": "انے ظننت انے ملق حسابيه ١٩",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5321,
      "number": 20,
      "text_uthmani": "فَهُوَ فِے عِيشَةٖ رَّاضِيَةٖ ٢٠",
      "text_simple": "فهو فے عيشهٖ راضيهٖ ٢٠",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5322,
      "number": 21,
      "text_uthmani": "فِے جَنَّةٍ عَالِيَةٖ ٢١",
      "text_simple": "فے جنه عاليهٖ ٢١",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5323,
      "number": 22,
      "text_uthmani": "قُطُوفُهَا دَانِيَةٞۖ ٢٢",
      "text_simple": "قطوفها دانيهٞ ٢٢",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5324,
      "number": 23,
      "text_uthmani": "كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَآ أَسْلَفْتُمْ فِے اِ۬لَايَّامِ اِ۬لْخَالِيَةِۖ ٢٣",
      "text_simple": "كلوا واشربوا هنيٓـٔا بمآ اسلفتم فے الايام الخاليه ٢٣",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5325,
      "number": 24,
      "text_uthmani": "وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ ٢٤",
      "text_simple": "واما من اوتي كتبه بشماله ٢٤",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5326,
      "number": 25,
      "text_uthmani": "فَيَقُولُ يَٰلَيْتَنِے لَمُ ا۟وتَ كِتَٰبِيَهْۖ ٢٥",
      "text_simple": "فيقول يليتنے لم اوت كتبيه ٢٥",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5327,
      "number": 26,
      "text_uthmani": "وَلَمَ اَدْرِ مَا حِسَابِيَهْۖ ٢٦",
      "text_simple": "ولم ادر ما حسابيه ٢٦",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5328,
      "number": 27,
      "text_uthmani": "يَٰلَيْتَهَا كَانَتِ اِ۬لْقَاضِيَةَ ٢٧",
      "text_simple": "يليتها كانت القاضيه ٢٧",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5329,
      "number": 28,
      "text_uthmani": "مَآ أَغْن۪ىٰ عَنِّے مَالِيَهۖ ٢٨",
      "text_simple": "مآ اغني عنے ماليه ٢٨",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5330,
      "number": 29,
      "text_uthmani": "هَّلَكَ عَنِّے سُلْطَٰنِيَهْۖ ٢٩",
      "text_simple": "هلك عنے سلطنيه ٢٩",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5331,
      "number": 30,
      "text_uthmani": "خُذُوهُ فَغُلُّوهُ ٣٠",
      "text_simple": "خذوه فغلوه ٣٠",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5332,
      "number": 31,
      "text_uthmani": "ثُمَّ اَ۬لْجَحِيمَ صَلُّوهُ ٣١",
      "text_simple": "ثم الجحيم صلوه ٣١",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5333,
      "number": 32,
      "text_uthmani": "ثُمَّ فِے سِلْسِلَةٖ ذَرْعُهَا سَبْعُونَ ذِرَاعاٗ فَاسْلُكُوهُۖ ٣٢",
      "text_simple": "ثم فے سلسلهٖ ذرعها سبعون ذراعاٗ فاسلكوه ٣٢",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5334,
      "number": 33,
      "text_uthmani": "إِنَّهُۥ كَانَ لَا يُومِنُ بِاللَّهِ اِ۬لْعَظِيمِ ٣٣",
      "text_simple": "انه كان لا يومن بالله العظيم ٣٣",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5335,
      "number": 34,
      "text_uthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ ٣٤",
      "text_simple": "ولا يحض علي طعام المسكين ٣٤",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5336,
      "number": 35,
      "text_uthmani": "فَلَيْسَ لَهُ اُ۬لْيَوْمَ هَٰهُنَا حَمِيمٞ ٣٥",
      "text_simple": "فليس له اليوم ههنا حميمٞ ٣٥",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5337,
      "number": 36,
      "text_uthmani": "وَلَا طَعَامٌ اِلَّا مِنْ غِسْلِينٖ ٣٦",
      "text_simple": "ولا طعام الا من غسلينٖ ٣٦",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5338,
      "number": 37,
      "text_uthmani": "لَّا يَاكُلُهُۥٓ إِلَّا اَ۬لْخَٰطِـُٔونَۖ ٣٧",
      "text_simple": "لا ياكلهٓ الا الخطـٔون ٣٧",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5339,
      "number": 38,
      "text_uthmani": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ ٣٨",
      "text_simple": "فلآ اقسم بما تبصرون ٣٨",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5340,
      "number": 39,
      "text_uthmani": "وَمَا لَا تُبْصِرُونَ ٣٩",
      "text_simple": "وما لا تبصرون ٣٩",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5341,
      "number": 40,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ ٤٠",
      "text_simple": "انه لقول رسولٖ كريمٖ ٤٠",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5342,
      "number": 41,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَاعِرٖ قَلِيلاٗ مَّا تُومِنُونَ ٤١",
      "text_simple": "وما هو بقول شاعرٖ قليلاٗ ما تومنون ٤١",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5343,
      "number": 42,
      "text_uthmani": "وَلَا بِقَوْلِ كَاهِنٖۖ قَلِيلاٗ مَّا تَذَّكَّرُونَۖ ٤٢",
      "text_simple": "ولا بقول كاهنٖ قليلاٗ ما تذكرون ٤٢",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5344,
      "number": 43,
      "text_uthmani": "تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ ٤٣",
      "text_simple": "تنزيلٞ من رب العلمين ٤٣",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5345,
      "number": 44,
      "text_uthmani": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ اَ۬لَاقَاوِيلِ ٤٤",
      "text_simple": "ولو تقول علينا بعض الاقاويل ٤٤",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5346,
      "number": 45,
      "text_uthmani": "لَأَخَذْنَا مِنْهُ بِالْيَمِينِ ٤٥",
      "text_simple": "لاخذنا منه باليمين ٤٥",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5347,
      "number": 46,
      "text_uthmani": "ثُمَّ لَقَطَعْنَا مِنْهُ اُ۬لْوَتِينَ ٤٦",
      "text_simple": "ثم لقطعنا منه الوتين ٤٦",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5348,
      "number": 47,
      "text_uthmani": "فَمَا مِنكُم مِّنَ اَحَدٍ عَنْهُ حَٰجِزِينَۖ ٤٧",
      "text_simple": "فما منكم من احد عنه حجزين ٤٧",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5349,
      "number": 48,
      "text_uthmani": "وَإِنَّهُۥ لَتَذْكِرَةٞ لِّلْمُتَّقِينَۖ ٤٨",
      "text_simple": "وانه لتذكرهٞ للمتقين ٤٨",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5350,
      "number": 49,
      "text_uthmani": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَۖ ٤٩",
      "text_simple": "وانا لنعلم ان منكم مكذبين ٤٩",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5351,
      "number": 50,
      "text_uthmani": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى اَ۬لْكٰ۪فِرِينَۖ ٥٠",
      "text_simple": "وانه لحسره علي الكفرين ٥٠",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5352,
      "number": 51,
      "text_uthmani": "وَإِنَّهُۥ لَحَقُّ اُ۬لْيَقِينِۖ ٥١",
      "text_simple": "وانه لحق اليقين ٥١",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5353,
      "number": 52,
      "text_uthmani": "فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ ٥٢",
      "text_simple": "فسبح باسم ربك العظيم ٥٢",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    }
  ]
}