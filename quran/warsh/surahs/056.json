{
  "number": 56,
  "name_ar": "الوَاقِعة",
  "name_en": "Al-Wāqi‘ah",
  "ayahs_count": 99,
  "page_start": 534,
  "page_end": 537,
  "ayahs": [
    {
      "id": 4956,
      "number": 1,
      "text_uthmani": "إِذَا وَقَعَتِ اِ۬لْوَاقِعَةُ ١",
      "text_simple": "اذا وقعت الواقعه ١",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4957,
      "number": 2,
      "text_uthmani": "لَيْسَ لِوَقْعَتِهَا كَٰذِبَةٌۖ ٢",
      "text_simple": "ليس لوقعتها كذبه ٢",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4958,
      "number": 3,
      "text_uthmani": "خَافِضَةٞ رَّافِعَةٌ ٣",
      "text_simple": "خافضهٞ رافعه ٣",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4959,
      "number": 4,
      "text_uthmani": "اِذَا رُجَّتِ اِ۬لَارْضُ رَجّاٗ ٤",
      "text_simple": "اذا رجت الارض رجاٗ ٤",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4960,
      "number": 5,
      "text_uthmani": "وَبُسَّتِ اِ۬لْجِبَالُ بَسّاٗ ٥",
      "text_simple": "وبست الجبال بساٗ ٥",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4961,
      "number": 6,
      "text_uthmani": "فَكَانَتْ هَبَآءٗ مُّنۢبَثّاٗ ٦",
      "text_simple": "فكانت هبآءٗ منبثاٗ ٦",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 4962,
      "number": 7,
      "text_uthmani": "وَكُنتُمُۥٓ أَزْوَٰجاٗ ثَلَٰثَةٗۖ ٧",
      "text_simple": "وكنتمٓ ازوجاٗ ثلثهٗ ٧",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 4963,
      "number": 8,
      "text_uthmani": "فَأَصْحَٰبُ اُ۬لْمَيْمَنَةِ ٨",
      "text_simple": "فاصحب الميمنه ٨",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 4964,
      "number": 9,
      "text_uthmani": "مَآ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ ٩",
      "text_simple": "مآ اصحب الميمنه ٩",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 4965,
      "number": 10,
      "text_uthmani": "وَأَصْحَٰبُ اُ۬لْمَشْـَٔمَةِ ١٠",
      "text_simple": "واصحب المشـٔمه ١٠",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 4966,
      "number": 11,
      "text_uthmani": "مَآ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ ١١",
      "text_simple": "مآ اصحب المشـٔمه ١١",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 4967,
      "number": 12,
      "text_uthmani": "وَالسَّٰبِقُونَ اَ۬لسَّٰبِقُونَۖ ١٢",
      "text_simple": "والسبقون السبقون ١٢",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 4968,
      "number": 13,
      "text_uthmani": "أُوْلَٰٓئِكَ اَ۬لْمُقَرَّبُونَ ١٣",
      "text_simple": "اولٓئك المقربون ١٣",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 4969,
      "number": 14,
      "text_uthmani": "فِے جَنَّٰتِ اِ۬لنَّعِيمِۖ ١٤",
      "text_simple": "فے جنت النعيم ١٤",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4970,
      "number": 15,
      "text_uthmani": "ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ ١٥",
      "text_simple": "ثلهٞ من الاولين ١٥",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4971,
      "number": 16,
      "text_uthmani": "وَقَلِيلٞ مِّنَ اَ۬لَاخِرِينَ ١٦",
      "text_simple": "وقليلٞ من الاخرين ١٦",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4972,
      "number": 17,
      "text_uthmani": "عَلَىٰ سُرُرٖ مَّوْضُونَةٖ ١٧",
      "text_simple": "علي سررٖ موضونهٖ ١٧",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 4973,
      "number": 18,
      "text_uthmani": "مُّتَّكِـِٕينَ عَلَيْهَا مُتَقَٰبِلِينَۖ ١٨",
      "text_simple": "متكـٕين عليها متقبلين ١٨",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 4974,
      "number": 19,
      "text_uthmani": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٞ مُّخَلَّدُونَ ١٩",
      "text_simple": "يطوف عليهم ولدنٞ مخلدون ١٩",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4975,
      "number": 20,
      "text_uthmani": "بِأَكْوَابٖ وَأَبَارِيقَ ٢٠",
      "text_simple": "باكوابٖ واباريق ٢٠",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4976,
      "number": 21,
      "text_uthmani": "وَكَأْسٖ مِّن مَّعِينٖ ٢١",
      "text_simple": "وكاسٖ من معينٖ ٢١",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 4977,
      "number": 22,
      "text_uthmani": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ ٢٢",
      "text_simple": "لا يصدعون عنها ولا ينزفون ٢٢",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 4978,
      "number": 23,
      "text_uthmani": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ ٢٣",
      "text_simple": "وفكههٖ مما يتخيرون ٢٣",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 4979,
      "number": 24,
      "text_uthmani": "وَلَحْمِ طَيْرٖ مِّمَّا يَشْتَهُونَۖ ٢٤",
      "text_simple": "ولحم طيرٖ مما يشتهون ٢٤",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 4980,
      "number": 25,
      "text_uthmani": "وَحُورٌ عِينٞ كَأَمْثَٰلِ اِ۬للُّؤْلُوِٕ اِ۬لْمَكْنُونِ ٢٥",
      "text_simple": "وحور عينٞ كامثل اللؤلوٕ المكنون ٢٥",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 4981,
      "number": 26,
      "text_uthmani": "جَزَآءَۢ بِمَا كَانُواْ يَعْمَلُونَۖ ٢٦",
      "text_simple": "جزآء بما كانوا يعملون ٢٦",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 4982,
      "number": 27,
      "text_uthmani": "لَا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا تَاثِيماًۖ ٢٧",
      "text_simple": "لا يسمعون فيها لغواٗ ولا تاثيما ٢٧",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 4983,
      "number": 28,
      "text_uthmani": "اِلَّا قِيلاٗ سَلَٰماٗ سَلَٰماٗۖ ٢٨",
      "text_simple": "الا قيلاٗ سلماٗ سلماٗ ٢٨",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 4984,
      "number": 29,
      "text_uthmani": "وَأَصْحَٰبُ اُ۬لْيَمِينِ مَآ أَصْحَٰبُ اُ۬لْيَمِينِۖ ٢٩",
      "text_simple": "واصحب اليمين مآ اصحب اليمين ٢٩",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 4985,
      "number": 30,
      "text_uthmani": "فِے سِدْرٖ مَّخْضُودٖ ٣٠",
      "text_simple": "فے سدرٖ مخضودٖ ٣٠",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 4986,
      "number": 31,
      "text_uthmani": "وَطَلْحٖ مَّنضُودٖ ٣١",
      "text_simple": "وطلحٖ منضودٖ ٣١",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 4987,
      "number": 32,
      "text_uthmani": "وَظِلّٖ مَّمْدُودٖ ٣٢",
      "text_simple": "وظلٖ ممدودٖ ٣٢",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 4988,
      "number": 33,
      "text_uthmani": "وَمَآءٖ مَّسْكُوبٖ ٣٣",
      "text_simple": "ومآءٖ مسكوبٖ ٣٣",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4989,
      "number": 34,
      "text_uthmani": "وَفَٰكِهَةٖ كَثِيرَةٖ ٣٤",
      "text_simple": "وفكههٖ كثيرهٖ ٣٤",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4990,
      "number": 35,
      "text_uthmani": "لَّا مَقْطُوعَةٖ وَلَا مَمْنُوعَةٖ ٣٥",
      "text_simple": "لا مقطوعهٖ ولا ممنوعهٖ ٣٥",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 4991,
      "number": 36,
      "text_uthmani": "وَفُرُشٖ مَّرْفُوعَةٍۖ ٣٦",
      "text_simple": "وفرشٖ مرفوعه ٣٦",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 4992,
      "number": 37,
      "text_uthmani": "اِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءٗ ٣٧",
      "text_simple": "انآ انشانهن انشآءٗ ٣٧",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 4993,
      "number": 38,
      "text_uthmani": "فَجَعَلْنَٰهُنَّ أَبْكَاراً ٣٨",
      "text_simple": "فجعلنهن ابكارا ٣٨",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4994,
      "number": 39,
      "text_uthmani": "عُرُباً اَتْرَاباٗ ٣٩",
      "text_simple": "عربا اتراباٗ ٣٩",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4995,
      "number": 40,
      "text_uthmani": "لِّأَصْحَٰبِ اِ۬لْيَمِينِۖ ٤٠",
      "text_simple": "لاصحب اليمين ٤٠",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4996,
      "number": 41,
      "text_uthmani": "ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ ٤١",
      "text_simple": "ثلهٞ من الاولين ٤١",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 4997,
      "number": 42,
      "text_uthmani": "وَثُلَّةٞ مِّنَ اَ۬لَاخِرِينَۖ ٤٢",
      "text_simple": "وثلهٞ من الاخرين ٤٢",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4998,
      "number": 43,
      "text_uthmani": "وَأَصْحَٰبُ اُ۬لشِّمَالِ ٤٣",
      "text_simple": "واصحب الشمال ٤٣",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4999,
      "number": 44,
      "text_uthmani": "مَآ أَصْحَٰبُ اُ۬لشِّمَالِۖ ٤٤",
      "text_simple": "مآ اصحب الشمال ٤٤",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5000,
      "number": 45,
      "text_uthmani": "فِے سَمُومٖ وَحَمِيمٖ ٤٥",
      "text_simple": "فے سمومٖ وحميمٖ ٤٥",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5001,
      "number": 46,
      "text_uthmani": "وَظِلّٖ مِّنْ يَّحْمُومٖ ٤٦",
      "text_simple": "وظلٖ من يحمومٖ ٤٦",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5002,
      "number": 47,
      "text_uthmani": "لَّا بَارِدٖ وَلَا كَرِيمٍۖ ٤٧",
      "text_simple": "لا باردٖ ولا كريم ٤٧",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5003,
      "number": 48,
      "text_uthmani": "اِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ ٤٨",
      "text_simple": "انهم كانوا قبل ذلك مترفين ٤٨",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5004,
      "number": 49,
      "text_uthmani": "وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لْحِنثِ اِ۬لْعَظِيمِۖ ٤٩",
      "text_simple": "وكانوا يصرون علي الحنث العظيم ٤٩",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5005,
      "number": 50,
      "text_uthmani": "وَكَانُواْ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ ٥٠",
      "text_simple": "وكانوا يقولون ائذا متنا وكنا تراباٗ وعظما انا لمبعوثون ٥٠",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5006,
      "number": 51,
      "text_uthmani": "أَوَءَابَآؤُنَا اَ۬لَاوَّلُونَۖ ٥١",
      "text_simple": "اوءابآؤنا الاولون ٥١",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5007,
      "number": 52,
      "text_uthmani": "۞ قُلِ اِنَّ اَ۬لَاوَّلِينَ وَالَاخِرِينَ لَمَجْمُوعُونَ ٥٢",
      "text_simple": "قل ان الاولين والاخرين لمجموعون ٥٢",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5008,
      "number": 53,
      "text_uthmani": "إِلَىٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ ٥٣",
      "text_simple": "الي ميقت يومٖ معلومٖ ٥٣",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5009,
      "number": 54,
      "text_uthmani": "ثُمَّ إِنَّكُمُۥٓ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لْمُكَذِّبُونَ ٥٤",
      "text_simple": "ثم انكمٓ ايها الضآلون المكذبون ٥٤",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5010,
      "number": 55,
      "text_uthmani": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ٥٥",
      "text_simple": "لآكلون من شجرٖ من زقومٖ ٥٥",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5011,
      "number": 56,
      "text_uthmani": "فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ ٥٦",
      "text_simple": "فمالـٔون منها البطون ٥٦",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5012,
      "number": 57,
      "text_uthmani": "فَشَٰرِبُونَ عَلَيْهِ مِنَ اَ۬لْحَمِيمِ ٥٧",
      "text_simple": "فشربون عليه من الحميم ٥٧",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5013,
      "number": 58,
      "text_uthmani": "فَشَٰرِبُونَ شُرْبَ اَ۬لْهِيمِۖ ٥٨",
      "text_simple": "فشربون شرب الهيم ٥٨",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5014,
      "number": 59,
      "text_uthmani": "هَٰذَا نُزُلُهُمْ يَوْمَ اَ۬لدِّينِۖ ٥٩",
      "text_simple": "هذا نزلهم يوم الدين ٥٩",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5015,
      "number": 60,
      "text_uthmani": "نَحْنُ خَلَقْنَٰكُمْۖ فَلَوْلَا تُصَدِّقُونَۖ ٦٠",
      "text_simple": "نحن خلقنكم فلولا تصدقون ٦٠",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5016,
      "number": 61,
      "text_uthmani": "أَفَرَٰٓيْتُم مَّا تُمْنُونَ ٦١",
      "text_simple": "افرٓيتم ما تمنون ٦١",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5017,
      "number": 62,
      "text_uthmani": "ءَآنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ اُ۬لْخَٰلِقُونَۖ ٦٢",
      "text_simple": "ءآنتم تخلقونهٓ ام نحن الخلقون ٦٢",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5018,
      "number": 63,
      "text_uthmani": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ اُ۬لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ ٦٣",
      "text_simple": "نحن قدرنا بينكم الموت وما نحن بمسبوقين ٦٣",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5019,
      "number": 64,
      "text_uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِے مَا لَا تَعْلَمُونَۖ ٦٤",
      "text_simple": "عليٓ ان نبدل امثلكم وننشئكم فے ما لا تعلمون ٦٤",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5020,
      "number": 65,
      "text_uthmani": "وَلَقَدْ عَلِمْتُمُ اُ۬لنَّشْأَةَ اَ۬لُاول۪ىٰۖ فَلَوْلَا تَذَّكَّرُونَۖ ٦٥",
      "text_simple": "ولقد علمتم النشاه الاولي فلولا تذكرون ٦٥",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5021,
      "number": 66,
      "text_uthmani": "أَفَرَٰٓيْتُم مَّا تَحْرُثُونَ ٦٦",
      "text_simple": "افرٓيتم ما تحرثون ٦٦",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5022,
      "number": 67,
      "text_uthmani": "ءَآنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ اُ۬لزَّٰرِعُونَۖ ٦٧",
      "text_simple": "ءآنتم تزرعونهٓ ام نحن الزرعون ٦٧",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5023,
      "number": 68,
      "text_uthmani": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰماٗ فَظَلْتُمْ تَفَكَّهُونَ ٦٨",
      "text_simple": "لو نشآء لجعلنه حطماٗ فظلتم تفكهون ٦٨",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5024,
      "number": 69,
      "text_uthmani": "إِنَّا لَمُغْرَمُونَ ٦٩",
      "text_simple": "انا لمغرمون ٦٩",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5025,
      "number": 70,
      "text_uthmani": "بَلْ نَحْنُ مَحْرُومُونَۖ ٧٠",
      "text_simple": "بل نحن محرومون ٧٠",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5026,
      "number": 71,
      "text_uthmani": "أَفَرَٰٓيْتُمُ اُ۬لْمَآءَ اَ۬لذِے تَشْرَبُونَ ٧١",
      "text_simple": "افرٓيتم المآء الذے تشربون ٧١",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5027,
      "number": 72,
      "text_uthmani": "ءَآنتُمُۥٓ أَنزَلْتُمُوهُ مِنَ اَ۬لْمُزْنِ أَمْ نَحْنُ اُ۬لْمُنزِلُونَۖ ٧٢",
      "text_simple": "ءآنتمٓ انزلتموه من المزن ام نحن المنزلون ٧٢",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5028,
      "number": 73,
      "text_uthmani": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجاٗۖ فَلَوْلَا تَشْكُرُونَۖ ٧٣",
      "text_simple": "لو نشآء جعلنه اجاجاٗ فلولا تشكرون ٧٣",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5029,
      "number": 74,
      "text_uthmani": "أَفَرَٰٓيْتُمُ اُ۬لنَّارَ اَ۬لتِے تُورُونَ ٧٤",
      "text_simple": "افرٓيتم النار التے تورون ٧٤",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5030,
      "number": 75,
      "text_uthmani": "ءَآنتُمُۥٓ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ اُ۬لْمُنشِـُٔونَۖ ٧٥",
      "text_simple": "ءآنتمٓ انشاتم شجرتهآ ام نحن المنشـٔون ٧٥",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5031,
      "number": 76,
      "text_uthmani": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةٗ وَمَتَٰعاٗ لِّلْمُقْوِينَۖ ٧٦",
      "text_simple": "نحن جعلنها تذكرهٗ ومتعاٗ للمقوين ٧٦",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5032,
      "number": 77,
      "text_uthmani": "فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ ٧٧",
      "text_simple": "فسبح باسم ربك العظيم ٧٧",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5033,
      "number": 78,
      "text_uthmani": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ اِ۬لنُّجُومِ ٧٨",
      "text_simple": "فلآ اقسم بموقع النجوم ٧٨",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5034,
      "number": 79,
      "text_uthmani": "وَإِنَّهُۥ لَقَسَمٞ لَّوْ تَعْلَمُونَ عَظِيمٌ ٧٩",
      "text_simple": "وانه لقسمٞ لو تعلمون عظيم ٧٩",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5035,
      "number": 80,
      "text_uthmani": "اِنَّهُۥ لَقُرْءَانٞ كَرِيمٞ ٨٠",
      "text_simple": "انه لقرءانٞ كريمٞ ٨٠",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5036,
      "number": 81,
      "text_uthmani": "فِے كِتَٰبٖ مَّكْنُونٖ ٨١",
      "text_simple": "فے كتبٖ مكنونٖ ٨١",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5037,
      "number": 82,
      "text_uthmani": "لَّا يَمَسُّهُۥٓ إِلَّا اَ۬لْمُطَهَّرُونَۖ ٨٢",
      "text_simple": "لا يمسهٓ الا المطهرون ٨٢",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5038,
      "number": 83,
      "text_uthmani": "تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ ٨٣",
      "text_simple": "تنزيلٞ من رب العلمين ٨٣",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5039,
      "number": 84,
      "text_uthmani": "أَفَبِهَٰذَا اَ۬لْحَدِيثِ أَنتُم مُّدْهِنُونَ ٨٤",
      "text_simple": "افبهذا الحديث انتم مدهنون ٨٤",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5040,
      "number": 85,
      "text_uthmani": "وَتَجْعَلُونَ رِزْقَكُمُۥٓ أَنَّكُمْ تُكَذِّبُونَۖ ٨٥",
      "text_simple": "وتجعلون رزقكمٓ انكم تكذبون ٨٥",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5041,
      "number": 86,
      "text_uthmani": "فَلَوْلَآ إِذَا بَلَغَتِ اِ۬لْحُلْقُومَ ٨٦",
      "text_simple": "فلولآ اذا بلغت الحلقوم ٨٦",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5042,
      "number": 87,
      "text_uthmani": "وَأَنتُمْ حِينَئِذٖ تَنظُرُونَ ٨٧",
      "text_simple": "وانتم حينئذٖ تنظرون ٨٧",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5043,
      "number": 88,
      "text_uthmani": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ ٨٨",
      "text_simple": "ونحن اقرب اليه منكم ولكن لا تبصرون ٨٨",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5044,
      "number": 89,
      "text_uthmani": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ ٨٩",
      "text_simple": "فلولآ ان كنتم غير مدينين ٨٩",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5045,
      "number": 90,
      "text_uthmani": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَۖ ٩٠",
      "text_simple": "ترجعونهآ ان كنتم صدقين ٩٠",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5046,
      "number": 91,
      "text_uthmani": "فَأَمَّآ إِن كَانَ مِنَ اَ۬لْمُقَرَّبِينَ ٩١",
      "text_simple": "فامآ ان كان من المقربين ٩١",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5047,
      "number": 92,
      "text_uthmani": "فَرَوْحٞ وَرَيْحَانٞ وَجَنَّتُ نَعِيمٖۖ ٩٢",
      "text_simple": "فروحٞ وريحانٞ وجنت نعيمٖ ٩٢",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5048,
      "number": 93,
      "text_uthmani": "وَأَمَّآ إِن كَانَ مِنَ اَصْحَٰبِ اِ۬لْيَمِينِ ٩٣",
      "text_simple": "وامآ ان كان من اصحب اليمين ٩٣",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5049,
      "number": 94,
      "text_uthmani": "فَسَلَٰمٞ لَّكَ مِنَ اَصْحَٰبِ اِ۬لْيَمِينِۖ ٩٤",
      "text_simple": "فسلمٞ لك من اصحب اليمين ٩٤",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5050,
      "number": 95,
      "text_uthmani": "وَأَمَّآ إِن كَانَ مِنَ اَ۬لْمُكَذِّبِينَ اَ۬لضَّآلِّينَ ٩٥",
      "text_simple": "وامآ ان كان من المكذبين الضآلين ٩٥",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5051,
      "number": 96,
      "text_uthmani": "فَنُزُلٞ مِّنْ حَمِيمٖ ٩٦",
      "text_simple": "فنزلٞ من حميمٖ ٩٦",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5052,
      "number": 97,
      "text_uthmani": "وَتَصْلِيَةُ جَحِيمٍۖ ٩٧",
      "text_simple": "وتصليه جحيم ٩٧",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5053,
      "number": 98,
      "text_uthmani": "اِنَّ هَٰذَا لَهُوَ حَقُّ اُ۬لْيَقِينِۖ ٩٨",
      "text_simple": "ان هذا لهو حق اليقين ٩٨",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5054,
      "number": 99,
      "text_uthmani": "فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ ٩٩",
