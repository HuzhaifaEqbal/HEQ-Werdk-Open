{
  "number": 81,
  "name_ar": "التَّكوير",
  "name_en": "At-Takwīr",
  "ayahs_count": 29,
  "page_start": 586,
  "page_end": 586,
  "ayahs": [
    {
      "id": 5776,
      "number": 1,
      "text_uthmani": "إِذَا اَ۬لشَّمْسُ كُوِّرَتْ ١",
      "text_simple": "اذا الشمس كورت ١",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5777,
      "number": 2,
      "text_uthmani": "وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتْ ٢",
      "text_simple": "واذا النجوم انكدرت ٢",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5778,
      "number": 3,
      "text_uthmani": "وَإِذَا اَ۬لْجِبَالُ سُيِّرَتْ ٣",
      "text_simple": "واذا الجبال سيرت ٣",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5779,
      "number": 4,
      "text_uthmani": "وَإِذَا اَ۬لْعِشَارُ عُطِّلَتْ ٤",
      "text_simple": "واذا العشار عطلت ٤",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5780,
      "number": 5,
      "text_uthmani": "وَإِذَا اَ۬لْوُحُوشُ حُشِرَتْ ٥",
      "text_simple": "واذا الوحوش حشرت ٥",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5781,
      "number": 6,
      "text_uthmani": "وَإِذَا اَ۬لْبِحَارُ سُجِّرَتْ ٦",
      "text_simple": "واذا البحار سجرت ٦",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5782,
      "number": 7,
      "text_uthmani": "وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتْ ٧",
      "text_simple": "واذا النفوس زوجت ٧",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5783,
      "number": 8,
      "text_uthmani": "وَإِذَا اَ۬لْمَوْءُۥدَةُ سُئِلَتْ ٨",
      "text_simple": "واذا الموءده سئلت ٨",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5784,
      "number": 9,
      "text_uthmani": "بِأَيِّ ذَنۢبٖ قُتِلَتْ ٩",
      "text_simple": "باي ذنبٖ قتلت ٩",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5785,
      "number": 10,
      "text_uthmani": "وَإِذَا اَ۬لصُّحُفُ نُشِرَتْ ١٠",
      "text_simple": "واذا الصحف نشرت ١٠",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5786,
      "number": 11,
      "text_uthmani": "وَإِذَا اَ۬لسَّمَآءُ كُشِطَتْ ١١",
      "text_simple": "واذا السمآء كشطت ١١",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5787,
      "number": 12,
      "text_uthmani": "وَإِذَا اَ۬لْجَحِيمُ سُعِّرَتْ ١٢",
      "text_simple": "واذا الجحيم سعرت ١٢",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5788,
      "number": 13,
      "text_uthmani": "وَإِذَا اَ۬لْجَنَّةُ أُزْلِفَتْ ١٣",
      "text_simple": "واذا الجنه ازلفت ١٣",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5789,
      "number": 14,
      "text_uthmani": "عَلِمَتْ نَفْسٞ مَّآ أَحْضَرَتْۖ ١٤",
      "text_simple": "علمت نفسٞ مآ احضرت ١٤",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5790,
      "number": 15,
      "text_uthmani": "فَلَآ أُقْسِمُ بِالْخُنَّسِ ١٥",
      "text_simple": "فلآ اقسم بالخنس ١٥",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5791,
      "number": 16,
      "text_uthmani": "اِ۬لْجَوَارِ اِ۬لْكُنَّسِ ١٦",
      "text_simple": "الجوار الكنس ١٦",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5792,
      "number": 17,
      "text_uthmani": "وَاليْلِ إِذَا عَسْعَسَ ١٧",
      "text_simple": "واليل اذا عسعس ١٧",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5793,
      "number": 18,
      "text_uthmani": "وَالصُّبْحِ إِذَا تَنَفَّسَ ١٨",
      "text_simple": "والصبح اذا تنفس ١٨",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5794,
      "number": 19,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ ١٩",
      "text_simple": "انه لقول رسولٖ كريمٖ ١٩",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5795,
      "number": 20,
      "text_uthmani": "ذِے قُوَّةٍ عِندَ ذِے اِ۬لْعَرْشِ مَكِينٖ ٢٠",
      "text_simple": "ذے قوه عند ذے العرش مكينٖ ٢٠",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5796,
      "number": 21,
      "text_uthmani": "مُّطَاعٖ ثَمَّ أَمِينٖۖ ٢١",
      "text_simple": "مطاعٖ ثم امينٖ ٢١",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5797,
      "number": 22,
      "text_uthmani": "وَمَا صَٰحِبُكُم بِمَجْنُونٖۖ ٢٢",
      "text_simple": "وما صحبكم بمجنونٖ ٢٢",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5798,
      "number": 23,
      "text_uthmani": "وَلَقَدْ ر۪ء۪اهُ بِالُافُقِ اِ۬لْمُبِينِۖ ٢٣",
      "text_simple": "ولقد رءاه بالافق المبين ٢٣",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5799,
      "number": 24,
      "text_uthmani": "وَمَا هُوَ عَلَى اَ۬لْغَيْبِ بِضَنِينٖۖ ٢٤",
      "text_simple": "وما هو علي الغيب بضنينٖ ٢٤",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5800,
      "number": 25,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٖ رَّجِيمٖ ٢٥",
      "text_simple": "وما هو بقول شيطنٖ رجيمٖ ٢٥",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5801,
      "number": 26,
      "text_uthmani": "فَأَيْنَ تَذْهَبُونَۖ ٢٦",
      "text_simple": "فاين تذهبون ٢٦",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5802,
      "number": 27,
      "text_uthmani": "إِنْ هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَ ٢٧",
      "text_simple": "ان هو الا ذكرٞ للعلمين ٢٧",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5803,
      "number": 28,
      "text_uthmani": "لِمَن شَآءَ مِنكُمُۥٓ أَنْ يَّسْتَقِيمَۖ ٢٨",
      "text_simple": "لمن شآء منكمٓ ان يستقيم ٢٨",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5804,
      "number": 29,
      "text_uthmani": "وَمَا تَشَآءُونَ إِلَّآ أَنْ يَّشَآءَ اَ۬للَّهُ رَبُّ اُ۬لْعَٰلَمِينَۖ ٢٩",
      "text_simple": "وما تشآءون الآ ان يشآء الله رب العلمين ٢٩",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    }
  ]
}