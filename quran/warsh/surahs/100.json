      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 6129,
      "number": 4,
      "text_uthmani": "فَأَثَرْنَ بِهِۦ نَقْعاٗ ٤",
      "text_simple": "فاثرن به نقعاٗ ٤",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6130,
      "number": 5,
      "text_uthmani": "فَوَسَطْنَ بِهِۦ جَمْعاً ٥",
      "text_simple": "فوسطن به جمعا ٥",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6131,
      "number": 6,
      "text_uthmani": "اِنَّ اَ۬لِانسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ٦",
      "text_simple": "ان الانسن لربه لكنودٞ ٦",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 6132,
      "number": 7,
      "text_uthmani": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ٧",
      "text_simple": "وانه علي ذلك لشهيدٞ ٧",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 6133,
      "number": 8,
      "text_uthmani": "وَإِنَّهُۥ لِحُبِّ اِ۬لْخَيْرِ لَشَدِيدٌۖ ٨",
      "text_simple": "وانه لحب الخير لشديد ٨",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 6134,
      "number": 9,
      "text_uthmani": "۞ اَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِے اِ۬لْقُبُورِ ٩",
      "text_simple": "افلا يعلم اذا بعثر ما فے القبور ٩",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 6135,
      "number": 10,
      "text_uthmani": "وَحُصِّلَ مَا فِے اِ۬لصُّدُورِ ١٠",
      "text_simple": "وحصل ما فے الصدور ١٠",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 6136,
      "number": 11,
      "text_uthmani": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٖ لَّخَبِيرٌۖ ١١",
      "text_simple": "ان ربهم بهم يومئذٖ لخبير ١١",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    }
  ]
