  "ayahs": [
    {
      "id": 6158,
      "number": 1,
      "text_uthmani": "وَيْلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ١",
      "text_simple": "ويلٞ لكل همزهٖ لمزه ١",
      "juz": 30,
      "page": 601,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 6159,
      "number": 2,
      "text_uthmani": "اِ۬لذِے جَمَعَ مَالاٗ وَعَدَّدَهُۥ ٢",
      "text_simple": "الذے جمع مالاٗ وعدده ٢",
      "juz": 30,
      "page": 601,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 6160,
      "number": 3,
      "text_uthmani": "يَحْسِبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ ٣",
      "text_simple": "يحسب ان مالهٓ اخلده ٣",
      "juz": 30,
      "page": 601,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6161,
      "number": 4,
      "text_uthmani": "كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ ٤",
      "text_simple": "كلا لينبذن فے الحطمه ٤",
      "juz": 30,
      "page": 601,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6162,
      "number": 5,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحُطَمَةُۖ ٥",
      "text_simple": "ومآ ادريك ما الحطمه ٥",
      "juz": 30,
      "page": 601,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6163,
      "number": 6,
      "text_uthmani": "نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ ٦",
      "text_simple": "نار الله الموقده ٦",
      "juz": 30,
      "page": 601,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6164,
      "number": 7,
      "text_uthmani": "اُ۬لتِے تَطَّلِعُ عَلَى اَ۬لَافْـِٕدَةِۖ ٧",
      "text_simple": "التے تطلع علي الافـٕده ٧",
      "juz": 30,
      "page": 601,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 6165,
      "number": 8,
      "text_uthmani": "إِنَّهَا عَلَيْهِم مُّوصَدَةٞ ٨",
      "text_simple": "انها عليهم موصدهٞ ٨",
      "juz": 30,
      "page": 601,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6166,
      "number": 9,
      "text_uthmani": "فِے عَمَدٖ مُّمَدَّدَةٍۖ ٩",
      "text_simple": "فے عمدٖ ممدده ٩",
      "juz": 30,
      "page": 601,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    }
  ]
}