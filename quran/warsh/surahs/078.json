{
  "number": 78,
  "name_ar": "النَّبَإ",
  "name_en": "An-Naba’",
  "ayahs_count": 40,
  "page_start": 582,
  "page_end": 583,
  "ayahs": [
    {
      "id": 5649,
      "number": 1,
      "text_uthmani": "عَمَّۖ يَتَسَآءَلُونَ ١",
      "text_simple": "عم يتسآءلون ١",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5650,
      "number": 2,
      "text_uthmani": "عَنِ اِ۬لنَّبَإِ اِ۬لْعَظِيمِ ٢",
      "text_simple": "عن النبا العظيم ٢",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5651,
      "number": 3,
      "text_uthmani": "اِ۬لذِے هُمْ فِيهِ مُخْتَلِفُونَۖ ٣",
      "text_simple": "الذے هم فيه مختلفون ٣",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5652,
      "number": 4,
      "text_uthmani": "كَلَّا سَيَعْلَمُونَ ٤",
      "text_simple": "كلا سيعلمون ٤",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5653,
      "number": 5,
      "text_uthmani": "ثُمَّ كَلَّا سَيَعْلَمُونَۖ ٥",
      "text_simple": "ثم كلا سيعلمون ٥",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5654,
      "number": 6,
      "text_uthmani": "أَلَمْ نَجْعَلِ اِ۬لَارْضَ مِهَٰداٗ ٦",
      "text_simple": "الم نجعل الارض مهداٗ ٦",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5655,
      "number": 7,
      "text_uthmani": "وَالْجِبَالَ أَوْتَاداٗ ٧",
      "text_simple": "والجبال اوتاداٗ ٧",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5656,
      "number": 8,
      "text_uthmani": "وَخَلَقْنَٰكُمُۥٓ أَزْوَٰجاٗ ٨",
      "text_simple": "وخلقنكمٓ ازوجاٗ ٨",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5657,
      "number": 9,
      "text_uthmani": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتاٗ ٩",
      "text_simple": "وجعلنا نومكم سباتاٗ ٩",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5658,
      "number": 10,
      "text_uthmani": "وَجَعَلْنَا اَ۬ليْلَ لِبَاساٗ ١٠",
      "text_simple": "وجعلنا اليل لباساٗ ١٠",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5659,
      "number": 11,
      "text_uthmani": "وَجَعَلْنَا اَ۬لنَّهَارَ مَعَاشاٗ ١١",
      "text_simple": "وجعلنا النهار معاشاٗ ١١",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5660,
      "number": 12,
      "text_uthmani": "وَبَنَيْنَا فَوْقَكُمْ سَبْعاٗ شِدَاداٗ ١٢",
      "text_simple": "وبنينا فوقكم سبعاٗ شداداٗ ١٢",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5661,
      "number": 13,
      "text_uthmani": "وَجَعَلْنَا سِرَاجاٗ وَهَّاجاٗ ١٣",
      "text_simple": "وجعلنا سراجاٗ وهاجاٗ ١٣",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5662,
      "number": 14,
      "text_uthmani": "وَأَنزَلْنَا مِنَ اَ۬لْمُعْصِرَٰتِ مَآءٗ ثَجَّاجاٗ ١٤",
      "text_simple": "وانزلنا من المعصرت مآءٗ ثجاجاٗ ١٤",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5663,
      "number": 15,
      "text_uthmani": "لِّنُخْرِجَ بِهِۦ حَبّاٗ وَنَبَاتاٗ ١٥",
      "text_simple": "لنخرج به حباٗ ونباتاٗ ١٥",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5664,
      "number": 16,
      "text_uthmani": "وَجَنَّٰتٍ اَلْفَافاًۖ ١٦",
      "text_simple": "وجنت الفافا ١٦",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5665,
      "number": 17,
      "text_uthmani": "اِنَّ يَوْمَ اَ۬لْفَصْلِ كَانَ مِيقَٰتاٗ ١٧",
      "text_simple": "ان يوم الفصل كان ميقتاٗ ١٧",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5666,
      "number": 18,
      "text_uthmani": "يَوْمَ يُنفَخُ فِے اِ۬لصُّورِ فَتَاتُونَ أَفْوَاجاٗ ١٨",
      "text_simple": "يوم ينفخ فے الصور فتاتون افواجاٗ ١٨",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5667,
      "number": 19,
      "text_uthmani": "وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتَ اَبْوَٰباٗ ١٩",
      "text_simple": "وفتحت السمآء فكانت ابوباٗ ١٩",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5668,
      "number": 20,
      "text_uthmani": "وَسُيِّرَتِ اِ۬لْجِبَالُ فَكَانَتْ سَرَاباًۖ ٢٠",
      "text_simple": "وسيرت الجبال فكانت سرابا ٢٠",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5669,
      "number": 21,
      "text_uthmani": "اِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداٗ ٢١",
      "text_simple": "ان جهنم كانت مرصاداٗ ٢١",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5670,
      "number": 22,
      "text_uthmani": "لِّلطَّٰغِينَ مَـَٔاباٗ ٢٢",
      "text_simple": "للطغين مـٔاباٗ ٢٢",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5671,
      "number": 23,
      "text_uthmani": "لَّٰبِثِينَ فِيهَآ أَحْقَاباٗۖ ٢٣",
      "text_simple": "لبثين فيهآ احقاباٗ ٢٣",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5672,
      "number": 24,
      "text_uthmani": "لَّا يَذُوقُونَ فِيهَا بَرْداٗ وَلَا شَرَاباً ٢٤",
      "text_simple": "لا يذوقون فيها برداٗ ولا شرابا ٢٤",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5673,
      "number": 25,
      "text_uthmani": "اِلَّا حَمِيماٗ وَغَسَاقاٗ ٢٥",
      "text_simple": "الا حميماٗ وغساقاٗ ٢٥",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5674,
      "number": 26,
      "text_uthmani": "جَزَآءٗ وِفَاقاًۖ ٢٦",
      "text_simple": "جزآءٗ وفاقا ٢٦",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5675,
      "number": 27,
      "text_uthmani": "اِنَّهُمْ كَانُواْ لَا يَرْجُونَ حِسَاباٗ ٢٧",
      "text_simple": "انهم كانوا لا يرجون حساباٗ ٢٧",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5676,
      "number": 28,
      "text_uthmani": "وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّاباٗۖ ٢٨",
      "text_simple": "وكذبوا بـٔايتنا كذاباٗ ٢٨",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5677,
      "number": 29,
      "text_uthmani": "وَكُلَّ شَےْءٍ اَحْصَيْنَٰهُ كِتَٰباٗۖ ٢٩",
      "text_simple": "وكل شےء احصينه كتباٗ ٢٩",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5678,
      "number": 30,
      "text_uthmani": "فَذُوقُواْ فَلَن نَّزِيدَكُمُۥٓ إِلَّا عَذَاباًۖ ٣٠",
      "text_simple": "فذوقوا فلن نزيدكمٓ الا عذابا ٣٠",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5679,
      "number": 31,
      "text_uthmani": "اِنَّ لِلْمُتَّقِينَ مَفَازاً ٣١",
      "text_simple": "ان للمتقين مفازا ٣١",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5680,
      "number": 32,
      "text_uthmani": "حَدَآئِقَ وَأَعْنَٰباٗ ٣٢",
      "text_simple": "حدآئق واعنباٗ ٣٢",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5681,
      "number": 33,
      "text_uthmani": "وَكَوَاعِبَ أَتْرَاباٗ ٣٣",
      "text_simple": "وكواعب اتراباٗ ٣٣",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5682,
      "number": 34,
      "text_uthmani": "وَكَأْساٗ دِهَاقاٗ ٣٤",
      "text_simple": "وكاساٗ دهاقاٗ ٣٤",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5683,
      "number": 35,
      "text_uthmani": "لَّا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا كِذَّاباٗۖ ٣٥",
      "text_simple": "لا يسمعون فيها لغواٗ ولا كذاباٗ ٣٥",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5684,
      "number": 36,
      "text_uthmani": "جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَاباٗۖ ٣٦",
      "text_simple": "جزآءٗ من ربك عطآء حساباٗ ٣٦",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5685,
      "number": 37,
      "text_uthmani": "رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَاۖ اَ۬لرَّحْمَٰنُ لَا يَمْلِكُونَ مِنْهُ خِطَاباٗۖ ٣٧",
      "text_simple": "رب السموت والارض وما بينهما الرحمن لا يملكون منه خطاباٗ ٣٧",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5686,
      "number": 38,
      "text_uthmani": "يَوْمَ يَقُومُ اُ۬لرُّوحُ وَالْمَلَٰٓئِكَةُ صَفّاٗ لَّا يَتَكَلَّمُونَ إِلَّا مَنَ اَذِنَ لَهُ اُ۬لرَّحْمَٰنُ وَقَالَ صَوَاباٗۖ ٣٨",
      "text_simple": "يوم يقوم الروح والملٓئكه صفاٗ لا يتكلمون الا من اذن له الرحمن وقال صواباٗ ٣٨",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5687,
      "number": 39,
      "text_uthmani": "ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لْحَقُّۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔاباًۖ ٣٩",
      "text_simple": "ذلك اليوم الحق فمن شآء اتخذ الي ربه مـٔابا ٣٩",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5688,
      "number": 40,
      "text_uthmani": "اِنَّآ أَنذَرْنَٰكُمْ عَذَاباٗ قَرِيباٗ يَوْمَ يَنظُرُ اُ۬لْمَرْءُ مَا قَدَّمَتْ يَدَٰهُ وَيَقُولُ اُ۬لْكَافِرُ يَٰلَيْتَنِے كُنتُ تُرَٰباٗۖ ٤٠",
      "text_simple": "انآ انذرنكم عذاباٗ قريباٗ يوم ينظر المرء ما قدمت يده ويقول الكافر يليتنے كنت ترباٗ ٤٠",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    }
  ]
}