{
  "number": 75,
  "name_ar": "القِيَامة",
  "name_en": "Al-Qiyāmah",
  "ayahs_count": 39,
  "page_start": 577,
  "page_end": 578,
  "ayahs": [
    {
      "id": 5529,
      "number": 1,
      "text_uthmani": "لَآ أُقْسِمُ بِيَوْمِ اِ۬لْقِيَٰمَةِ ١",
      "text_simple": "لآ اقسم بيوم القيمه ١",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5530,
      "number": 2,
      "text_uthmani": "وَلَآ أُقْسِمُ بِالنَّفْسِ اِ۬للَّوَّامَةِۖ ٢",
      "text_simple": "ولآ اقسم بالنفس اللوامه ٢",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5531,
      "number": 3,
      "text_uthmani": "أَيَحْسِبُ اُ۬لِانسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ ٣",
      "text_simple": "ايحسب الانسن الن نجمع عظامه ٣",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5532,
      "number": 4,
      "text_uthmani": "بَل۪ىٰۖ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥۖ ٤",
      "text_simple": "بلي قدرين عليٓ ان نسوي بنانه ٤",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5533,
      "number": 5,
      "text_uthmani": "بَلْ يُرِيدُ اُ۬لِانسَٰنُ لِيَفْجُرَ أَمَامَهُۥۖ ٥",
      "text_simple": "بل يريد الانسن ليفجر امامه ٥",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5534,
      "number": 6,
      "text_uthmani": "يَسْـَٔلُ أَيَّانَ يَوْمُ اُ۬لْقِيَٰمَةِۖ ٦",
      "text_simple": "يسـٔل ايان يوم القيمه ٦",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5535,
      "number": 7,
      "text_uthmani": "فَإِذَا بَرَقَ اَ۬لْبَصَرُ ٧",
      "text_simple": "فاذا برق البصر ٧",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5536,
      "number": 8,
      "text_uthmani": "وَخَسَفَ اَ۬لْقَمَرُ ٨",
      "text_simple": "وخسف القمر ٨",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5537,
      "number": 9,
      "text_uthmani": "وَجُمِعَ اَ۬لشَّمْسُ وَالْقَمَرُ ٩",
      "text_simple": "وجمع الشمس والقمر ٩",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5538,
      "number": 10,
      "text_uthmani": "يَقُولُ اُ۬لِانسَٰنُ يَوْمَئِذٍ اَيْنَ اَ۬لْمَفَرُّۖ ١٠",
      "text_simple": "يقول الانسن يومئذ اين المفر ١٠",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5539,
      "number": 11,
      "text_uthmani": "كَلَّا لَا وَزَرَۖ ١١",
      "text_simple": "كلا لا وزر ١١",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5540,
      "number": 12,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمُسْتَقَرُّۖ ١٢",
      "text_simple": "الي ربك يومئذ المستقر ١٢",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5541,
      "number": 13,
      "text_uthmani": "يُنَبَّؤُاْ اُ۬لِانسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَۖ ١٣",
      "text_simple": "ينبؤا الانسن يومئذ بما قدم واخر ١٣",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5542,
      "number": 14,
      "text_uthmani": "بَلِ اِ۬لِانسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٞ ١٤",
      "text_simple": "بل الانسن علي نفسه بصيرهٞ ١٤",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5543,
      "number": 15,
      "text_uthmani": "وَلَوَ اَلْق۪ىٰ مَعَاذِيرَهُۥۖ ١٥",
      "text_simple": "ولو القي معاذيره ١٥",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5544,
      "number": 16,
      "text_uthmani": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓۖ إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥۖ ١٦",
      "text_simple": "لا تحرك به لسانك لتعجل بهٓ ان علينا جمعه وقرءانه ١٦",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5545,
      "number": 17,
      "text_uthmani": "فَإِذَا قَرَأْنَٰهُ فَاتَّبِعْ قُرْءَانَهُۥ ١٧",
      "text_simple": "فاذا قرانه فاتبع قرءانه ١٧",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5546,
      "number": 18,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥۖ ١٨",
      "text_simple": "ثم ان علينا بيانه ١٨",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5547,
      "number": 19,
      "text_uthmani": "كَلَّا بَلْ تُحِبُّونَ اَ۬لْعَاجِلَةَ ١٩",
      "text_simple": "كلا بل تحبون العاجله ١٩",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5548,
      "number": 20,
      "text_uthmani": "وَتَذَرُونَ اَ۬لَاخِرَةَۖ ٢٠",
      "text_simple": "وتذرون الاخره ٢٠",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5549,
      "number": 21,
      "text_uthmani": "وُجُوهٞ يَوْمَئِذٖ نَّاضِرَةٌ ٢١",
      "text_simple": "وجوهٞ يومئذٖ ناضره ٢١",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5550,
      "number": 22,
      "text_uthmani": "اِلَىٰ رَبِّهَا نَاظِرَةٞۖ ٢٢",
      "text_simple": "الي ربها ناظرهٞ ٢٢",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5551,
      "number": 23,
      "text_uthmani": "وَوُجُوهٞ يَوْمَئِذِۢ بَاسِرَةٞ ٢٣",
      "text_simple": "ووجوهٞ يومئذ باسرهٞ ٢٣",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5552,
      "number": 24,
      "text_uthmani": "تَظُنُّ أَنْ يُّفْعَلَ بِهَا فَاقِرَةٞۖ ٢٤",
      "text_simple": "تظن ان يفعل بها فاقرهٞ ٢٤",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5553,
      "number": 25,
      "text_uthmani": "كَلَّآ إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ ٢٥",
      "text_simple": "كلآ اذا بلغت التراقي ٢٥",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5554,
      "number": 26,
      "text_uthmani": "وَقِيلَ مَن رَّاقٖ ٢٦",
      "text_simple": "وقيل من راقٖ ٢٦",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5555,
      "number": 27,
      "text_uthmani": "وَظَنَّ أَنَّهُ اُ۬لْفِرَاقُ ٢٧",
      "text_simple": "وظن انه الفراق ٢٧",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5556,
      "number": 28,
      "text_uthmani": "وَالْتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ ٢٨",
      "text_simple": "والتفت الساق بالساق ٢٨",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5557,
      "number": 29,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمَسَاقُۖ ٢٩",
      "text_simple": "الي ربك يومئذ المساق ٢٩",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5558,
      "number": 30,
      "text_uthmani": "فَلَا صَدَّقَ وَلَا صَلّ۪ىٰۖ ٣٠",
      "text_simple": "فلا صدق ولا صلي ٣٠",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5559,
      "number": 31,
      "text_uthmani": "وَلَٰكِن كَذَّبَ وَتَوَلّ۪ىٰۖ ٣١",
      "text_simple": "ولكن كذب وتولي ٣١",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5560,
      "number": 32,
      "text_uthmani": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطّ۪ىٰٓۖ ٣٢",
      "text_simple": "ثم ذهب اليٓ اهله يتمطيٓ ٣٢",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5561,
      "number": 33,
      "text_uthmani": "أَوْل۪ىٰ لَكَ فَأَوْل۪ىٰ ٣٣",
      "text_simple": "اولي لك فاولي ٣٣",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5562,
      "number": 34,
      "text_uthmani": "ثُمَّ أَوْل۪ىٰ لَكَ فَأَوْل۪ىٰٓۖ ٣٤",
      "text_simple": "ثم اولي لك فاوليٓ ٣٤",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5563,
      "number": 35,
      "text_uthmani": "أَيَحْسِبُ اُ۬لِانسَٰنُ أَنْ يُّتْرَكَ سُدىًۖ ٣٥",
      "text_simple": "ايحسب الانسن ان يترك سدي ٣٥",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5564,
      "number": 36,
      "text_uthmani": "اَلَمْ يَكُ نُطْفَةٗ مِّن مَّنِيّٖ تُمْن۪ىٰ ٣٦",
      "text_simple": "الم يك نطفهٗ من منيٖ تمني ٣٦",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5565,
      "number": 37,
      "text_uthmani": "ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوّ۪ىٰ ٣٧",
      "text_simple": "ثم كان علقهٗ فخلق فسوي ٣٧",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5566,
      "number": 38,
      "text_uthmani": "فَجَعَلَ مِنْهُ اُ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالُانث۪ىٰٓۖ ٣٨",
      "text_simple": "فجعل منه الزوجين الذكر والانثيٓ ٣٨",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5567,
      "number": 39,
      "text_uthmani": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَنْ يُّحْـِۧيَ اَ۬لْمَوْت۪ىٰۖ ٣٩",
      "text_simple": "اليس ذلك بقدر عليٓ ان يحـي الموتي ٣٩",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    }
  ]
}