{
  "number": 70,
  "name_ar": "المَعَارج",
  "name_en": "Al-Ma‘ārij",
  "ayahs_count": 44,
  "page_start": 568,
  "page_end": 570,
  "ayahs": [
    {
      "id": 5354,
      "number": 1,
      "text_uthmani": "سَالَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ ١",
      "text_simple": "سال سآئل بعذابٖ واقعٖ ١",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5355,
      "number": 2,
      "text_uthmani": "لِّلْكٰ۪فِرِينَ لَيْسَ لَهُۥ دَافِعٞ ٢",
      "text_simple": "للكفرين ليس له دافعٞ ٢",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5356,
      "number": 3,
      "text_uthmani": "مِّنَ اَ۬للَّهِ ذِے اِ۬لْمَعَارِجِۖ ٣",
      "text_simple": "من الله ذے المعارج ٣",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5357,
      "number": 4,
      "text_uthmani": "تَعْرُجُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ إِلَيْهِ فِے يَوْمٖ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٖۖ ٤",
      "text_simple": "تعرج الملٓئكه والروح اليه فے يومٖ كان مقداره خمسين الف سنهٖ ٤",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5358,
      "number": 5,
      "text_uthmani": "فَاصْبِرْ صَبْراٗ جَمِيلاًۖ ٥",
      "text_simple": "فاصبر صبراٗ جميلا ٥",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5359,
      "number": 6,
      "text_uthmani": "اِنَّهُمْ يَرَوْنَهُۥ بَعِيداٗ ٦",
      "text_simple": "انهم يرونه بعيداٗ ٦",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5360,
      "number": 7,
      "text_uthmani": "وَنَر۪يٰهُ قَرِيباٗۖ ٧",
      "text_simple": "ونريه قريباٗ ٧",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5361,
      "number": 8,
      "text_uthmani": "يَوْمَ تَكُونُ اُ۬لسَّمَآءُ كَالْمُهْلِ ٨",
      "text_simple": "يوم تكون السمآء كالمهل ٨",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5362,
      "number": 9,
      "text_uthmani": "وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ ٩",
      "text_simple": "وتكون الجبال كالعهن ٩",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5363,
      "number": 10,
      "text_uthmani": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيماٗ ١٠",
      "text_simple": "ولا يسـٔل حميم حميماٗ ١٠",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5364,
      "number": 11,
      "text_uthmani": "يُبَصَّرُونَهُمْۖ يَوَدُّ اُ۬لْمُجْرِمُ لَوْ يَفْتَدِے مِنْ عَذَابِ يَوْمَئِذِۢ بِبَنِيهِ ١١",
      "text_simple": "يبصرونهم يود المجرم لو يفتدے من عذاب يومئذ ببنيه ١١",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5365,
      "number": 12,
      "text_uthmani": "وَصَٰحِبَتِهِۦ وَأَخِيهِ ١٢",
      "text_simple": "وصحبته واخيه ١٢",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5366,
      "number": 13,
      "text_uthmani": "وَفَصِيلَتِهِ اِ۬لتِے تُـْٔوِيهِ ١٣",
      "text_simple": "وفصيلته التے تـٔويه ١٣",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5367,
      "number": 14,
      "text_uthmani": "وَمَن فِے اِ۬لَارْضِ جَمِيعاٗ ثُمَّ يُنجِيهِ ١٤",
      "text_simple": "ومن فے الارض جميعاٗ ثم ينجيه ١٤",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5368,
      "number": 15,
      "text_uthmani": "كَلَّآۖ إِنَّهَا لَظ۪ىٰ ١٥",
      "text_simple": "كلآ انها لظي ١٥",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5369,
      "number": 16,
      "text_uthmani": "نَزَّاعَةٞ لِّلشَّو۪ىٰ ١٦",
      "text_simple": "نزاعهٞ للشوي ١٦",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5370,
      "number": 17,
      "text_uthmani": "تَدْعُواْ مَنَ اَدْبَرَ وَتَوَلّ۪ىٰ ١٧",
      "text_simple": "تدعوا من ادبر وتولي ١٧",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5371,
      "number": 18,
      "text_uthmani": "وَجَمَعَ فَأَوْع۪ىٰٓۖ ١٨",
      "text_simple": "وجمع فاوعيٓ ١٨",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5372,
      "number": 19,
      "text_uthmani": "إِنَّ اَ۬لِانسَٰنَ خُلِقَ هَلُوعاً ١٩",
      "text_simple": "ان الانسن خلق هلوعا ١٩",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5373,
      "number": 20,
      "text_uthmani": "اِذَا مَسَّهُ اُ۬لشَّرُّ جَزُوعاٗ ٢٠",
      "text_simple": "اذا مسه الشر جزوعاٗ ٢٠",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5374,
      "number": 21,
      "text_uthmani": "وَإِذَا مَسَّهُ اُ۬لْخَيْرُ مَنُوعاً ٢١",
      "text_simple": "واذا مسه الخير منوعا ٢١",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5375,
      "number": 22,
      "text_uthmani": "اِلَّا اَ۬لْمُصَلِّينَ ٢٢",
      "text_simple": "الا المصلين ٢٢",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5376,
      "number": 23,
      "text_uthmani": "اَ۬لذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَۖ ٢٣",
      "text_simple": "الذين هم علي صلاتهم دآئمون ٢٣",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5377,
      "number": 24,
      "text_uthmani": "وَالذِينَ فِےٓ أَمْوَٰلِهِمْ حَقّٞ مَّعْلُومٞ ٢٤",
      "text_simple": "والذين فےٓ امولهم حقٞ معلومٞ ٢٤",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5378,
      "number": 25,
      "text_uthmani": "لِّلسَّآئِلِ وَالْمَحْرُومِۖ ٢٥",
      "text_simple": "للسآئل والمحروم ٢٥",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5379,
      "number": 26,
      "text_uthmani": "وَالذِينَ يُصَدِّقُونَ بِيَوْمِ اِ۬لدِّينِۖ ٢٦",
      "text_simple": "والذين يصدقون بيوم الدين ٢٦",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5380,
      "number": 27,
      "text_uthmani": "وَالذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ ٢٧",
      "text_simple": "والذين هم من عذاب ربهم مشفقون ٢٧",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5381,
      "number": 28,
      "text_uthmani": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَامُونٖۖ ٢٨",
      "text_simple": "ان عذاب ربهم غير مامونٖ ٢٨",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5382,
      "number": 29,
      "text_uthmani": "وَالذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ ٢٩",
      "text_simple": "والذين هم لفروجهم حفظون ٢٩",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5383,
      "number": 30,
      "text_uthmani": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمُۥٓ أَوْ مَا مَلَكَتَ اَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَۖ ٣٠",
      "text_simple": "الا عليٓ ازوجهمٓ او ما ملكت ايمنهم فانهم غير ملومين ٣٠",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5384,
      "number": 31,
      "text_uthmani": "فَمَنِ اِ۪بْتَغ۪ىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْعَادُونَۖ ٣١",
      "text_simple": "فمن ابتغي ورآء ذلك فاولٓئك هم العادون ٣١",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5385,
      "number": 32,
      "text_uthmani": "وَالذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَۖ ٣٢",
      "text_simple": "والذين هم لامنتهم وعهدهم رعون ٣٢",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5386,
      "number": 33,
      "text_uthmani": "وَالذِينَ هُم بِشَهَٰدَتِهِمْ قَآئِمُونَۖ ٣٣",
      "text_simple": "والذين هم بشهدتهم قآئمون ٣٣",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5387,
      "number": 34,
      "text_uthmani": "وَالذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ ٣٤",
      "text_simple": "والذين هم علي صلاتهم يحافظون ٣٤",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5388,
      "number": 35,
      "text_uthmani": "أُوْلَٰٓئِكَ فِے جَنَّٰتٖ مُّكْرَمُونَۖ ٣٥",
      "text_simple": "اولٓئك فے جنتٖ مكرمون ٣٥",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5389,
      "number": 36,
      "text_uthmani": "فَمَالِ اِ۬لذِينَ كَفَرُواْ قِبَلَكَ مُهْطِعِينَ ٣٦",
      "text_simple": "فمال الذين كفروا قبلك مهطعين ٣٦",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5390,
      "number": 37,
      "text_uthmani": "عَنِ اِ۬لْيَمِينِ وَعَنِ اِ۬لشِّمَالِ عِزِينَۖ ٣٧",
      "text_simple": "عن اليمين وعن الشمال عزين ٣٧",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5391,
      "number": 38,
      "text_uthmani": "أَيَطْمَعُ كُلُّ اُ۪مْرِےٕٖ مِّنْهُمُۥٓ أَنْ يُّدْخَلَ جَنَّةَ نَعِيمٖ ٣٨",
      "text_simple": "ايطمع كل امرےٕٖ منهمٓ ان يدخل جنه نعيمٖ ٣٨",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5392,
      "number": 39,
      "text_uthmani": "كَلَّآۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَۖ ٣٩",
      "text_simple": "كلآ انا خلقنهم مما يعلمون ٣٩",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5393,
      "number": 40,
      "text_uthmani": "۞ فَلَآ أُقْسِمُ بِرَبِّ اِ۬لْمَشَٰرِقِ وَالْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ ٤٠",
      "text_simple": "فلآ اقسم برب المشرق والمغرب انا لقدرون ٤٠",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5394,
      "number": 41,
      "text_uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْراٗ مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَۖ ٤١",
      "text_simple": "عليٓ ان نبدل خيراٗ منهم وما نحن بمسبوقين ٤١",
      "juz": 29,
      "page": 570,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5395,
      "number": 42,
      "text_uthmani": "فَذَرْهُمْ يَخُوضُواْ وَيَلْعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوْمَهُمُ اُ۬لذِے يُوعَدُونَ ٤٢",
      "text_simple": "فذرهم يخوضوا ويلعبوا حتي يلقوا يومهم الذے يوعدون ٤٢",
      "juz": 29,
      "page": 570,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5396,
      "number": 43,
      "text_uthmani": "يَوْمَ يَخْرُجُونَ مِنَ اَ۬لَاجْدَاثِ سِرَاعاٗ كَأَنَّهُمُۥٓ إِلَىٰ نَصْبٖ يُوفِضُونَ ٤٣",
      "text_simple": "يوم يخرجون من الاجداث سراعاٗ كانهمٓ الي نصبٖ يوفضون ٤٣",
      "juz": 29,
      "page": 570,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5397,
      "number": 44,
      "text_uthmani": "خَٰشِعَةً اَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لذِے كَانُواْ يُوعَدُونَۖ ٤٤",
      "text_simple": "خشعه ابصرهم ترهقهم ذلهٞ ذلك اليوم الذے كانوا يوعدون ٤٤",
      "juz": 29,
      "page": 570,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    }
  ]
}