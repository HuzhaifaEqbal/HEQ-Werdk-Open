{
  "number": 77,
  "name_ar": "المُرسَلات",
  "name_en": "Al-Mursalāt",
  "ayahs_count": 50,
  "page_start": 580,
  "page_end": 581,
  "ayahs": [
    {
      "id": 5599,
      "number": 1,
      "text_uthmani": "وَالْمُرْسَلَٰتِ عُرْفاٗ ١",
      "text_simple": "والمرسلت عرفاٗ ١",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5600,
      "number": 2,
      "text_uthmani": "فَالْعَٰصِفَٰتِ عَصْفاٗ ٢",
      "text_simple": "فالعصفت عصفاٗ ٢",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5601,
      "number": 3,
      "text_uthmani": "وَالنَّٰشِرَٰتِ نَشْراٗ ٣",
      "text_simple": "والنشرت نشراٗ ٣",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5602,
      "number": 4,
      "text_uthmani": "فَالْفَٰرِقَٰتِ فَرْقاٗ ٤",
      "text_simple": "فالفرقت فرقاٗ ٤",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5603,
      "number": 5,
      "text_uthmani": "فَالْمُلْقِيَٰتِ ذِكْراً ٥",
      "text_simple": "فالملقيت ذكرا ٥",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5604,
      "number": 6,
      "text_uthmani": "عُذْراً اَوْ نُذُراً ٦",
      "text_simple": "عذرا او نذرا ٦",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5605,
      "number": 7,
      "text_uthmani": "اِنَّمَا تُوعَدُونَ لَوَٰقِعٞۖ ٧",
      "text_simple": "انما توعدون لوقعٞ ٧",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5606,
      "number": 8,
      "text_uthmani": "فَإِذَا اَ۬لنُّجُومُ طُمِسَتْ ٨",
      "text_simple": "فاذا النجوم طمست ٨",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5607,
      "number": 9,
      "text_uthmani": "وَإِذَا اَ۬لسَّمَآءُ فُرِجَتْ ٩",
      "text_simple": "واذا السمآء فرجت ٩",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5608,
      "number": 10,
      "text_uthmani": "وَإِذَا اَ۬لْجِبَالُ نُسِفَتْ ١٠",
      "text_simple": "واذا الجبال نسفت ١٠",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5609,
      "number": 11,
      "text_uthmani": "وَإِذَا اَ۬لرُّسُلُ أُقِّتَتْ ١١",
      "text_simple": "واذا الرسل اقتت ١١",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5610,
      "number": 12,
      "text_uthmani": "لِأَيِّ يَوْمٍ ا۟جِّلَتْ ١٢",
      "text_simple": "لاي يوم اجلت ١٢",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5611,
      "number": 13,
      "text_uthmani": "لِيَوْمِ اِ۬لْفَصْلِۖ ١٣",
      "text_simple": "ليوم الفصل ١٣",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5612,
      "number": 14,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لْفَصْلِۖ ١٤",
      "text_simple": "ومآ ادريك ما يوم الفصل ١٤",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5613,
      "number": 15,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ١٥",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ١٥",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5614,
      "number": 16,
      "text_uthmani": "۞ أَلَمْ نُهْلِكِ اِ۬لَاوَّلِينَۖ ١٦",
      "text_simple": "الم نهلك الاولين ١٦",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5615,
      "number": 17,
      "text_uthmani": "ثُمَّ نُتْبِعُهُمُ اُ۬لَاخِرِينَۖ ١٧",
      "text_simple": "ثم نتبعهم الاخرين ١٧",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5616,
      "number": 18,
      "text_uthmani": "كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ ١٨",
      "text_simple": "كذلك نفعل بالمجرمين ١٨",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5617,
      "number": 19,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ١٩",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ١٩",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5618,
      "number": 20,
      "text_uthmani": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٖ مَّهِينٖ ٢٠",
      "text_simple": "الم نخلقكم من مآءٖ مهينٖ ٢٠",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5619,
      "number": 21,
      "text_uthmani": "فَجَعَلْنَٰهُ فِے قَر۪ارٖ مَّكِينٍ ٢١",
      "text_simple": "فجعلنه فے قرارٖ مكين ٢١",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5620,
      "number": 22,
      "text_uthmani": "اِلَىٰ قَدَرٖ مَّعْلُومٖ ٢٢",
      "text_simple": "الي قدرٖ معلومٖ ٢٢",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5621,
      "number": 23,
      "text_uthmani": "فَقَدَّرْنَاۖ فَنِعْمَ اَ۬لْقَٰدِرُونَۖ ٢٣",
      "text_simple": "فقدرنا فنعم القدرون ٢٣",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5622,
      "number": 24,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٢٤",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ٢٤",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5623,
      "number": 25,
      "text_uthmani": "أَلَمْ نَجْعَلِ اِ۬لَارْضَ كِفَاتاً ٢٥",
      "text_simple": "الم نجعل الارض كفاتا ٢٥",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5624,
      "number": 26,
      "text_uthmani": "اَحْيَآءٗ وَأَمْوَٰتاٗ ٢٦",
      "text_simple": "احيآءٗ واموتاٗ ٢٦",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5625,
      "number": 27,
      "text_uthmani": "وَجَعَلْنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسْقَيْنَٰكُم مَّآءٗ فُرَاتاٗۖ ٢٧",
      "text_simple": "وجعلنا فيها روسي شمختٖ واسقينكم مآءٗ فراتاٗ ٢٧",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5626,
      "number": 28,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٢٨",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ٢٨",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5627,
      "number": 29,
      "text_uthmani": "اَ۪نطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ ٢٩",
      "text_simple": "انطلقوٓا الي ما كنتم به تكذبون ٢٩",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5628,
      "number": 30,
      "text_uthmani": "اَ۪نطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِے ثَلَٰثِ شُعَبٖ ٣٠",
      "text_simple": "انطلقوٓا الي ظلٖ ذے ثلث شعبٖ ٣٠",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5629,
      "number": 31,
      "text_uthmani": "لَّا ظَلِيلٖ وَلَا يُغْنِے مِنَ اَ۬للَّهَبِۖ ٣١",
      "text_simple": "لا ظليلٖ ولا يغنے من اللهب ٣١",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5630,
      "number": 32,
      "text_uthmani": "إِنَّهَا تَرْمِے بِشَرَرٖ كَالْقَصْرِ ٣٢",
      "text_simple": "انها ترمے بشررٖ كالقصر ٣٢",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5631,
      "number": 33,
      "text_uthmani": "كَأَنَّهُۥ جِمَٰلَٰتٞ صُفْرٞۖ ٣٣",
      "text_simple": "كانه جملتٞ صفرٞ ٣٣",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5632,
      "number": 34,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٣٤",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ٣٤",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5633,
      "number": 35,
      "text_uthmani": "هَٰذَا يَوْمُ لَا يَنطِقُونَ ٣٥",
      "text_simple": "هذا يوم لا ينطقون ٣٥",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5634,
      "number": 36,
      "text_uthmani": "وَلَا يُوذَنُ لَهُمْ فَيَعْتَذِرُونَۖ ٣٦",
      "text_simple": "ولا يوذن لهم فيعتذرون ٣٦",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5635,
      "number": 37,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٣٧",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ٣٧",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5636,
      "number": 38,
      "text_uthmani": "هَٰذَا يَوْمُ اُ۬لْفَصْلِ جَمَعْنَٰكُمْ وَالَاوَّلِينَ ٣٨",
      "text_simple": "هذا يوم الفصل جمعنكم والاولين ٣٨",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5637,
      "number": 39,
      "text_uthmani": "فَإِن كَانَ لَكُمْ كَيْدٞ فَكِيدُونِۖ ٣٩",
      "text_simple": "فان كان لكم كيدٞ فكيدون ٣٩",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5638,
      "number": 40,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٤٠",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ٤٠",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5639,
      "number": 41,
      "text_uthmani": "إِنَّ اَ۬لْمُتَّقِينَ فِے ظِلَٰلٖ وَعُيُونٖ ٤١",
      "text_simple": "ان المتقين فے ظللٖ وعيونٖ ٤١",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5640,
      "number": 42,
      "text_uthmani": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَۖ ٤٢",
      "text_simple": "وفوكه مما يشتهون ٤٢",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5641,
      "number": 43,
      "text_uthmani": "كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَا كُنتُمْ تَعْمَلُونَۖ ٤٣",
      "text_simple": "كلوا واشربوا هنيٓـٔا بما كنتم تعملون ٤٣",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5642,
      "number": 44,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ ٤٤",
      "text_simple": "انا كذلك نجزے المحسنين ٤٤",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5643,
      "number": 45,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٤٥",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ٤٥",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5644,
      "number": 46,
      "text_uthmani": "كُلُواْ وَتَمَتَّعُواْ قَلِيلاً اِنَّكُم مُّجْرِمُونَۖ ٤٦",
      "text_simple": "كلوا وتمتعوا قليلا انكم مجرمون ٤٦",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5645,
      "number": 47,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٤٧",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ٤٧",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5646,
      "number": 48,
      "text_uthmani": "وَإِذَا قِيلَ لَهُمُ اُ۪رْكَعُواْ لَا يَرْكَعُونَۖ ٤٨",
      "text_simple": "واذا قيل لهم اركعوا لا يركعون ٤٨",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5647,
      "number": 49,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٤٩",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ٤٩",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
