  "ayahs": [
    {
      "id": 6057,
      "number": 1,
      "text_uthmani": "وَالضُّح۪ىٰ ١",
      "text_simple": "والضحي ١",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6058,
      "number": 2,
      "text_uthmani": "وَاليْلِ إِذَا سَج۪ىٰ ٢",
      "text_simple": "واليل اذا سجي ٢",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6059,
      "number": 3,
      "text_uthmani": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَل۪ىٰۖ ٣",
      "text_simple": "ما ودعك ربك وما قلي ٣",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6060,
      "number": 4,
      "text_uthmani": "وَلَلَاخِرَةُ خَيْرٞ لَّكَ مِنَ اَ۬لُاول۪ىٰۖ ٤",
      "text_simple": "وللاخره خيرٞ لك من الاولي ٤",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6061,
      "number": 5,
      "text_uthmani": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْض۪ىٰٓۖ ٥",
      "text_simple": "ولسوف يعطيك ربك فترضيٓ ٥",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 6062,
      "number": 6,
      "text_uthmani": "أَلَمْ يَجِدْكَ يَتِيماٗ فَـَٔاو۪ىٰ ٦",
      "text_simple": "الم يجدك يتيماٗ فـٔاوي ٦",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6063,
      "number": 7,
      "text_uthmani": "وَوَجَدَكَ ضَآلّاٗ فَهَد۪ىٰ ٧",
      "text_simple": "ووجدك ضآلاٗ فهدي ٧",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 6064,
      "number": 8,
      "text_uthmani": "وَوَجَدَكَ عَآئِلاٗ فَأَغْن۪ىٰۖ ٨",
      "text_simple": "ووجدك عآئلاٗ فاغني ٨",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 6065,
      "number": 9,
      "text_uthmani": "فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ ٩",
      "text_simple": "فاما اليتيم فلا تقهر ٩",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 6066,
      "number": 10,
      "text_uthmani": "وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ ١٠",
      "text_simple": "واما السآئل فلا تنهر ١٠",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 6067,
      "number": 11,
      "text_uthmani": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثَۖ ١١",
      "text_simple": "واما بنعمه ربك فحدث ١١",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    }
  ]
}