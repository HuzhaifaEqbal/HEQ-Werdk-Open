{
  "number": 89,
  "name_ar": "الفَجر",
  "name_en": "Al-Fajr",
  "ayahs_count": 32,
  "page_start": 593,
  "page_end": 594,
  "ayahs": [
    {
      "id": 5969,
      "number": 1,
      "text_uthmani": "وَالْفَجْرِ ١",
      "text_simple": "والفجر ١",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5970,
      "number": 2,
      "text_uthmani": "وَلَيَالٍ عَشْرٖ ٢",
      "text_simple": "وليال عشرٖ ٢",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5971,
      "number": 3,
      "text_uthmani": "وَالشَّفْعِ وَالْوَتْرِ ٣",
      "text_simple": "والشفع والوتر ٣",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5972,
      "number": 4,
      "text_uthmani": "وَاليْلِ إِذَا يَسْرِۦ ٤",
      "text_simple": "واليل اذا يسر ٤",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5973,
      "number": 5,
      "text_uthmani": "هَلْ فِے ذَٰلِكَ قَسَمٞ لِّذِے حِجْرٍۖ ٥",
      "text_simple": "هل فے ذلك قسمٞ لذے حجر ٥",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5974,
      "number": 6,
      "text_uthmani": "اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ ٦",
      "text_simple": "الم تر كيف فعل ربك بعاد ٦",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5975,
      "number": 7,
      "text_uthmani": "اِرَمَ ذَاتِ اِ۬لْعِمَادِ ٧",
      "text_simple": "ارم ذات العماد ٧",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5976,
      "number": 8,
      "text_uthmani": "اِ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے اِ۬لْبِلَٰدِ ٨",
      "text_simple": "التے لم يخلق مثلها فے البلد ٨",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5977,
      "number": 9,
      "text_uthmani": "وَثَمُودَ اَ۬لذِينَ جَابُواْ اُ۬لصَّخْرَ بِالْوَادِۦ ٩",
      "text_simple": "وثمود الذين جابوا الصخر بالواد ٩",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5978,
      "number": 10,
      "text_uthmani": "وَفِرْعَوْنَ ذِے اِ۬لَاوْتَادِ ١٠",
      "text_simple": "وفرعون ذے الاوتاد ١٠",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5979,
      "number": 11,
      "text_uthmani": "اِ۬لذِينَ طَغَوْاْ فِے اِ۬لْبِلَٰدِ ١١",
      "text_simple": "الذين طغوا فے البلد ١١",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5980,
      "number": 12,
      "text_uthmani": "فَأَكْثَرُواْ فِيهَا اَ۬لْفَسَادَ ١٢",
      "text_simple": "فاكثروا فيها الفساد ١٢",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5981,
      "number": 13,
      "text_uthmani": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ ١٣",
      "text_simple": "فصب عليهم ربك سوط عذاب ١٣",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5982,
      "number": 14,
      "text_uthmani": "اِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ ١٤",
      "text_simple": "ان ربك لبالمرصاد ١٤",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5983,
      "number": 15,
      "text_uthmani": "فَأَمَّا اَ۬لِانسَٰنُ إِذَا مَا اَ۪بْتَل۪يٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ ١٥",
      "text_simple": "فاما الانسن اذا ما ابتليه ربه فاكرمه ونعمه ١٥",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5984,
      "number": 16,
      "text_uthmani": "فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ ١٦",
      "text_simple": "فيقول ربي اكرمن ١٦",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5985,
      "number": 17,
      "text_uthmani": "وَأَمَّآ إِذَا مَا اَ۪بْتَل۪يٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ ١٧",
      "text_simple": "وامآ اذا ما ابتليه فقدر عليه رزقه ١٧",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5986,
      "number": 18,
      "text_uthmani": "فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ ١٨",
      "text_simple": "فيقول ربي اهنن ١٨",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5987,
      "number": 19,
      "text_uthmani": "كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْيَتِيمَ ١٩",
      "text_simple": "كلا بل لا تكرمون اليتيم ١٩",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5988,
      "number": 20,
      "text_uthmani": "وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِ ٢٠",
      "text_simple": "ولا تحضون علي طعام المسكين ٢٠",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5989,
      "number": 21,
      "text_uthmani": "وَتَاكُلُونَ اَ۬لتُّرَاثَ أَكْلاٗ لَّمّاٗ ٢١",
      "text_simple": "وتاكلون التراث اكلاٗ لماٗ ٢١",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5990,
      "number": 22,
      "text_uthmani": "وَتُحِبُّونَ اَ۬لْمَالَ حُبّاٗ جَمّاٗ ٢٢",
      "text_simple": "وتحبون المال حباٗ جماٗ ٢٢",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5991,
      "number": 23,
      "text_uthmani": "كَلَّآۖ إِذَا دُكَّتِ اِ۬لَارْضُ دَكّاٗ دَكّاٗ ٢٣",
      "text_simple": "كلآ اذا دكت الارض دكاٗ دكاٗ ٢٣",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5992,
      "number": 24,
      "text_uthmani": "وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاٗ صَفّاٗ ٢٤",
      "text_simple": "وجآء ربك والملك صفاٗ صفاٗ ٢٤",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5993,
      "number": 25,
      "text_uthmani": "وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ ٢٥",
      "text_simple": "وجےٓء يومئذ بجهنم ٢٥",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5994,
      "number": 26,
      "text_uthmani": "يَوْمَئِذٖ يَتَذَكَّرُ اُ۬لِانسَٰنُ وَأَنّ۪ىٰ لَهُ اُ۬لذِّكْر۪ىٰۖ ٢٦",
      "text_simple": "يومئذٖ يتذكر الانسن واني له الذكري ٢٦",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5995,
      "number": 27,
      "text_uthmani": "يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِےۖ ٢٧",
      "text_simple": "يقول يليتنے قدمت لحياتے ٢٧",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5996,
      "number": 28,
      "text_uthmani": "فَيَوْمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ ٢٨",
      "text_simple": "فيومئذٖ لا يعذب عذابهٓ احدٞ ٢٨",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5997,
      "number": 29,
      "text_uthmani": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞۖ ٢٩",
      "text_simple": "ولا يوثق وثاقهٓ احدٞ ٢٩",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5998,
      "number": 30,
      "text_uthmani": "يَٰٓأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ ٣٠",
      "text_simple": "يٓايتها النفس المطمئنه ٣٠",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5999,
      "number": 31,
      "text_uthmani": "اُ۪رْجِعِےٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرْضِيَّةٗ ٣١",
      "text_simple": "ارجعےٓ الي ربك راضيهٗ مرضيهٗ ٣١",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 6000,
      "number": 32,
      "text_uthmani": "فَادْخُلِے فِے عِبَٰدِے وَادْخُلِے جَنَّتِےۖ ٣٢",
      "text_simple": "فادخلے فے عبدے وادخلے جنتے ٣٢",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    }
  ]
}