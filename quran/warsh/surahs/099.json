  "ayahs": [
    {
      "id": 6117,
      "number": 1,
      "text_uthmani": "إِذَا زُلْزِلَتِ اِ۬لَارْضُ زِلْزَالَهَا ١",
      "text_simple": "اذا زلزلت الارض زلزالها ١",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6118,
      "number": 2,
      "text_uthmani": "وَأَخْرَجَتِ اِ۬لَارْضُ أَثْقَالَهَا ٢",
      "text_simple": "واخرجت الارض اثقالها ٢",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6119,
      "number": 3,
      "text_uthmani": "وَقَالَ اَ۬لِانسَٰنُ مَا لَهَا ٣",
      "text_simple": "وقال الانسن ما لها ٣",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 6120,
      "number": 4,
      "text_uthmani": "يَوْمَئِذٖ تُحَدِّثُ أَخْبَارَهَا ٤",
      "text_simple": "يومئذٖ تحدث اخبارها ٤",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6121,
      "number": 5,
      "text_uthmani": "بِأَنَّ رَبَّكَ أَوْح۪ىٰ لَهَاۖ ٥",
      "text_simple": "بان ربك اوحي لها ٥",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6122,
      "number": 6,
      "text_uthmani": "يَوْمَئِذٖ يَصْدُرُ اُ۬لنَّاسُ أَشْتَاتاٗ ٦",
      "text_simple": "يومئذٖ يصدر الناس اشتاتاٗ ٦",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6123,
      "number": 7,
      "text_uthmani": "لِّيُرَوَاْ اَعْمَٰلَهُمْۖ ٧",
      "text_simple": "ليروا اعملهم ٧",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6124,
      "number": 8,
      "text_uthmani": "فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراٗ يَرَهُۥۖ ٨",
      "text_simple": "فمن يعمل مثقال ذره خيراٗ يره ٨",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 6125,
      "number": 9,
      "text_uthmani": "وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٖ شَرّاٗ يَرَهُۥۖ ٩",
      "text_simple": "ومن يعمل مثقال ذرهٖ شراٗ يره ٩",
      "juz": 30,
