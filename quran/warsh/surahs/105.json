      "line_end": 13
    },
    {
      "id": 6168,
      "number": 2,
      "text_uthmani": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِے تَضْلِيلٖ ٢",
      "text_simple": "الم يجعل كيدهم فے تضليلٖ ٢",
      "juz": 30,
      "page": 601,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 6169,
      "number": 3,
      "text_uthmani": "وَأَرْسَلَ عَلَيْهِمْ طَيْراً اَبَابِيلَ ٣",
      "text_simple": "وارسل عليهم طيرا ابابيل ٣",
      "juz": 30,
