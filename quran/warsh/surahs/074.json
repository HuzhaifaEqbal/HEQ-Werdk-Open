{
  "number": 74,
  "name_ar": "المُدثر",
  "name_en": "Al-Muddaththir",
  "ayahs_count": 55,
  "page_start": 575,
  "page_end": 577,
  "ayahs": [
    {
      "id": 5474,
      "number": 1,
      "text_uthmani": "يَٰٓأَيُّهَا اَ۬لْمُدَّثِّرُ ١",
      "text_simple": "يٓايها المدثر ١",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5475,
      "number": 2,
      "text_uthmani": "قُمْ فَأَنذِرْۖ ٢",
      "text_simple": "قم فانذر ٢",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5476,
      "number": 3,
      "text_uthmani": "وَرَبَّكَ فَكَبِّرْۖ ٣",
      "text_simple": "وربك فكبر ٣",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5477,
      "number": 4,
      "text_uthmani": "وَثِيَابَكَ فَطَهِّرْۖ ٤",
      "text_simple": "وثيابك فطهر ٤",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5478,
      "number": 5,
      "text_uthmani": "وَالرِّجْزَ فَاهْجُرْۖ ٥",
      "text_simple": "والرجز فاهجر ٥",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5479,
      "number": 6,
      "text_uthmani": "وَلَا تَمْنُن تَسْتَكْثِرُۖ ٦",
      "text_simple": "ولا تمنن تستكثر ٦",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5480,
      "number": 7,
      "text_uthmani": "وَلِرَبِّكَ فَاصْبِرْۖ ٧",
      "text_simple": "ولربك فاصبر ٧",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5481,
      "number": 8,
      "text_uthmani": "فَإِذَا نُقِرَ فِے اِ۬لنَّاقُورِ ٨",
      "text_simple": "فاذا نقر فے الناقور ٨",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5482,
      "number": 9,
      "text_uthmani": "فَذَٰلِكَ يَوْمَئِذٖ يَوْمٌ عَسِيرٌ ٩",
      "text_simple": "فذلك يومئذٖ يوم عسير ٩",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5483,
      "number": 10,
      "text_uthmani": "عَلَى اَ۬لْكٰ۪فِرِينَ غَيْرُ يَسِيرٖۖ ١٠",
      "text_simple": "علي الكفرين غير يسيرٖ ١٠",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5484,
      "number": 11,
      "text_uthmani": "ذَرْنِے وَمَنْ خَلَقْتُ وَحِيداٗ ١١",
      "text_simple": "ذرنے ومن خلقت وحيداٗ ١١",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5485,
      "number": 12,
      "text_uthmani": "وَجَعَلْتُ لَهُۥ مَالاٗ مَّمْدُوداٗ ١٢",
      "text_simple": "وجعلت له مالاٗ ممدوداٗ ١٢",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5486,
      "number": 13,
      "text_uthmani": "وَبَنِينَ شُهُوداٗ ١٣",
      "text_simple": "وبنين شهوداٗ ١٣",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5487,
      "number": 14,
      "text_uthmani": "وَمَهَّدتُّ لَهُۥ تَمْهِيداٗ ١٤",
      "text_simple": "ومهدت له تمهيداٗ ١٤",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5488,
      "number": 15,
      "text_uthmani": "ثُمَّ يَطْمَعُ أَنَ اَزِيدَ ١٥",
      "text_simple": "ثم يطمع ان ازيد ١٥",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5489,
      "number": 16,
      "text_uthmani": "كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيداٗۖ ١٦",
      "text_simple": "كلآ انه كان لآيتنا عنيداٗ ١٦",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5490,
      "number": 17,
      "text_uthmani": "سَأُرْهِقُهُۥ صَعُوداًۖ ١٧",
      "text_simple": "سارهقه صعودا ١٧",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5491,
      "number": 18,
      "text_uthmani": "اِنَّهُۥ فَكَّرَ وَقَدَّرَ ١٨",
      "text_simple": "انه فكر وقدر ١٨",
      "juz": 29,
      "page": 575,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5492,
      "number": 19,
      "text_uthmani": "فَقُتِلَ كَيْفَ قَدَّرَ ١٩",
      "text_simple": "فقتل كيف قدر ١٩",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5493,
      "number": 20,
      "text_uthmani": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ ٢٠",
      "text_simple": "ثم قتل كيف قدر ٢٠",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5494,
      "number": 21,
      "text_uthmani": "ثُمَّ نَظَرَ ٢١",
      "text_simple": "ثم نظر ٢١",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5495,
      "number": 22,
      "text_uthmani": "ثُمَّ عَبَسَ وَبَسَرَ ٢٢",
      "text_simple": "ثم عبس وبسر ٢٢",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5496,
      "number": 23,
      "text_uthmani": "ثُمَّ أَدْبَرَ وَاسْتَكْبَرَ ٢٣",
      "text_simple": "ثم ادبر واستكبر ٢٣",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5497,
      "number": 24,
      "text_uthmani": "فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرٞ يُوثَرُ ٢٤",
      "text_simple": "فقال ان هذآ الا سحرٞ يوثر ٢٤",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5498,
      "number": 25,
      "text_uthmani": "إِنْ هَٰذَآ إِلَّا قَوْلُ اُ۬لْبَشَرِۖ ٢٥",
      "text_simple": "ان هذآ الا قول البشر ٢٥",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5499,
      "number": 26,
      "text_uthmani": "سَأُصْلِيهِ سَقَرَۖ ٢٦",
      "text_simple": "ساصليه سقر ٢٦",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5500,
      "number": 27,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا سَقَرُۖ ٢٧",
      "text_simple": "ومآ ادريك ما سقر ٢٧",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5501,
      "number": 28,
      "text_uthmani": "لَا تُبْقِے وَلَا تَذَرُۖ ٢٨",
      "text_simple": "لا تبقے ولا تذر ٢٨",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5502,
      "number": 29,
      "text_uthmani": "لَوَّاحَةٞ لِّلْبَشَرِۖ ٢٩",
      "text_simple": "لواحهٞ للبشر ٢٩",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5503,
      "number": 30,
      "text_uthmani": "عَلَيْهَا تِسْعَةَ عَشَرَۖ ٣٠",
      "text_simple": "عليها تسعه عشر ٣٠",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5504,
      "number": 31,
      "text_uthmani": "۞ وَمَا جَعَلْنَآ أَصْحَٰبَ اَ۬لنّ۪ارِ إِلَّا مَلَٰٓئِكَةٗۖ وَمَا جَعَلْنَا عِدَّتَهُمُۥٓ إِلَّا فِتْنَةٗ لِّلذِينَ كَفَرُواْ لِيَسْتَيْقِنَ اَ۬لذِينَ أُوتُواْ اُ۬لْكِتَٰبَ وَيَزْدَادَ اَ۬لذِينَ ءَامَنُوٓاْ إِيمَٰناٗ وَلَا يَرْتَابَ اَ۬لذِينَ أُوتُواْ اُ۬لْكِتَٰبَ وَالْمُومِنُونَ وَلِيَقُولَ اَ۬لذِينَ فِے قُلُوبِهِم مَّرَضٞ وَالْكَٰفِرُونَ مَاذَآ أَرَادَ اَ۬للَّهُ بِهَٰذَا مَثَلاٗۖ كَذَٰلِكَ يُضِلُّ اُ۬للَّهُ مَنْ يَّشَآءُ وَيَهْدِے مَنْ يَّشَآءُۖ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۖ وَمَا هِيَ إِلَّا ذِكْر۪ىٰ لِلْبَشَرِۖ ٣١",
      "text_simple": "وما جعلنآ اصحب النار الا ملٓئكهٗ وما جعلنا عدتهمٓ الا فتنهٗ للذين كفروا ليستيقن الذين اوتوا الكتب ويزداد الذين ءامنوٓا ايمناٗ ولا يرتاب الذين اوتوا الكتب والمومنون وليقول الذين فے قلوبهم مرضٞ والكفرون ماذآ اراد الله بهذا مثلاٗ كذلك يضل الله من يشآء ويهدے من يشآء وما يعلم جنود ربك الا هو وما هي الا ذكري للبشر ٣١",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 4,
      "line_end": 10
    },
    {
      "id": 5505,
      "number": 32,
      "text_uthmani": "كَلَّا وَالْقَمَرِ ٣٢",
      "text_simple": "كلا والقمر ٣٢",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5506,
      "number": 33,
      "text_uthmani": "وَاليْلِ إِذَ اَدْبَرَ ٣٣",
      "text_simple": "واليل اذ ادبر ٣٣",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5507,
      "number": 34,
      "text_uthmani": "وَالصُّبْحِ إِذَآ أَسْفَرَ ٣٤",
      "text_simple": "والصبح اذآ اسفر ٣٤",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5508,
      "number": 35,
      "text_uthmani": "إِنَّهَا لَإِحْدَى اَ۬لْكُبَرِ ٣٥",
      "text_simple": "انها لاحدي الكبر ٣٥",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5509,
      "number": 36,
      "text_uthmani": "نَذِيراٗ لِّلْبَشَرِ ٣٦",
      "text_simple": "نذيراٗ للبشر ٣٦",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5510,
      "number": 37,
      "text_uthmani": "لِمَن شَآءَ مِنكُمُۥٓ أَنْ يَّتَقَدَّمَ أَوْ يَتَأَخَّرَۖ ٣٧",
      "text_simple": "لمن شآء منكمٓ ان يتقدم او يتاخر ٣٧",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5511,
      "number": 38,
      "text_uthmani": "كُلُّ نَفْسِۢ بِمَا كَسَبَتْ رَهِينَةٌ ٣٨",
      "text_simple": "كل نفس بما كسبت رهينه ٣٨",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5512,
      "number": 39,
      "text_uthmani": "اِلَّآ أَصْحَٰبَ اَ۬لْيَمِينِۖ ٣٩",
      "text_simple": "الآ اصحب اليمين ٣٩",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5513,
      "number": 40,
      "text_uthmani": "فِے جَنَّٰتٖ يَتَسَآءَلُونَ عَنِ اِ۬لْمُجْرِمِينَ ٤٠",
      "text_simple": "فے جنتٖ يتسآءلون عن المجرمين ٤٠",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5514,
      "number": 41,
      "text_uthmani": "مَا سَلَكَكُمْ فِے سَقَرَۖ ٤١",
      "text_simple": "ما سلككم فے سقر ٤١",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5515,
      "number": 42,
      "text_uthmani": "قَالُواْ لَمْ نَكُ مِنَ اَ۬لْمُصَلِّينَ ٤٢",
      "text_simple": "قالوا لم نك من المصلين ٤٢",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5516,
      "number": 43,
      "text_uthmani": "وَلَمْ نَكُ نُطْعِمُ اُ۬لْمِسْكِينَ ٤٣",
      "text_simple": "ولم نك نطعم المسكين ٤٣",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5517,
      "number": 44,
      "text_uthmani": "وَكُنَّا نَخُوضُ مَعَ اَ۬لْخَآئِضِينَ ٤٤",
      "text_simple": "وكنا نخوض مع الخآئضين ٤٤",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5518,
      "number": 45,
      "text_uthmani": "وَكُنَّا نُكَذِّبُ بِيَوْمِ اِ۬لدِّينِ ٤٥",
      "text_simple": "وكنا نكذب بيوم الدين ٤٥",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5519,
      "number": 46,
      "text_uthmani": "حَتَّىٰٓ أَت۪يٰنَا اَ۬لْيَقِينُۖ ٤٦",
      "text_simple": "حتيٓ اتينا اليقين ٤٦",
      "juz": 29,
      "page": 576,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5520,
      "number": 47,
      "text_uthmani": "فَمَا تَنفَعُهُمْ شَفَٰعَةُ اُ۬لشَّٰفِعِينَۖ ٤٧",
      "text_simple": "فما تنفعهم شفعه الشفعين ٤٧",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5521,
      "number": 48,
      "text_uthmani": "فَمَا لَهُمْ عَنِ اِ۬لتَّذْكِرَةِ مُعْرِضِينَ ٤٨",
      "text_simple": "فما لهم عن التذكره معرضين ٤٨",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5522,
      "number": 49,
      "text_uthmani": "كَأَنَّهُمْ حُمُرٞ مُّسْتَنفَرَةٞ ٤٩",
      "text_simple": "كانهم حمرٞ مستنفرهٞ ٤٩",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5523,
      "number": 50,
      "text_uthmani": "فَرَّتْ مِن قَسْوَرَةِۢۖ ٥٠",
      "text_simple": "فرت من قسوره ٥٠",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5524,
      "number": 51,
      "text_uthmani": "بَلْ يُرِيدُ كُلُّ اُ۪مْرِےٕٖ مِّنْهُمُۥٓ أَنْ يُّوت۪ىٰ صُحُفاٗ مُّنَشَّرَةٗۖ ٥١",
      "text_simple": "بل يريد كل امرےٕٖ منهمٓ ان يوتي صحفاٗ منشرهٗ ٥١",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5525,
      "number": 52,
      "text_uthmani": "كَلَّا بَل لَّا يَخَافُونَ اَ۬لَاخِرَةَۖ ٥٢",
      "text_simple": "كلا بل لا يخافون الاخره ٥٢",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5526,
      "number": 53,
      "text_uthmani": "كَلَّآ إِنَّهُۥ تَذْكِرَةٞۖ ٥٣",
      "text_simple": "كلآ انه تذكرهٞ ٥٣",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5527,
      "number": 54,
      "text_uthmani": "فَمَن شَآءَ ذَكَرَهُۥۖ ٥٤",
      "text_simple": "فمن شآء ذكره ٥٤",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5528,
      "number": 55,
      "text_uthmani": "وَمَا تَذْكُرُونَ إِلَّآ أَنْ يَّشَآءَ اَ۬للَّهُۖ هُوَ أَهْلُ اُ۬لتَّقْو۪ىٰ وَأَهْلُ اُ۬لْمَغْفِرَةِۖ ٥٥",
      "text_simple": "وما تذكرون الآ ان يشآء الله هو اهل التقوي واهل المغفره ٥٥",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    }
  ]
}