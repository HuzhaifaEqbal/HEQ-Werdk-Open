{
  "number": 53,
  "name_ar": "النَّجم",
  "name_en": "An-Najm",
  "ayahs_count": 61,
  "page_start": 526,
  "page_end": 528,
  "ayahs": [
    {
      "id": 4763,
      "number": 1,
      "text_uthmani": "وَالنَّجْمِ إِذَا هَو۪ىٰ ١",
      "text_simple": "والنجم اذا هوي ١",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 4764,
      "number": 2,
      "text_uthmani": "مَا ضَلَّ صَٰحِبُكُمْ وَمَا غَو۪ىٰ ٢",
      "text_simple": "ما ضل صحبكم وما غوي ٢",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 4765,
      "number": 3,
      "text_uthmani": "وَمَا يَنطِقُ عَنِ اِ۬لْهَو۪ىٰٓ ٣",
      "text_simple": "وما ينطق عن الهويٓ ٣",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 4766,
      "number": 4,
      "text_uthmani": "إِنْ هُوَ إِلَّا وَحْيٞ يُوح۪ىٰۖ ٤",
      "text_simple": "ان هو الا وحيٞ يوحي ٤",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 4767,
      "number": 5,
      "text_uthmani": "عَلَّمَهُۥ شَدِيدُ اُ۬لْقُو۪ىٰ ٥",
      "text_simple": "علمه شديد القوي ٥",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 4768,
      "number": 6,
      "text_uthmani": "ذُو مِرَّةٖۖ فَاسْتَو۪ىٰ ٦",
      "text_simple": "ذو مرهٖ فاستوي ٦",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 4769,
      "number": 7,
      "text_uthmani": "وَهُوَ بِالُافُقِ اِ۬لَاعْل۪ىٰۖ ٧",
      "text_simple": "وهو بالافق الاعلي ٧",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 4770,
      "number": 8,
      "text_uthmani": "ثُمَّ دَنَا فَتَدَلّ۪ىٰ ٨",
      "text_simple": "ثم دنا فتدلي ٨",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 4771,
      "number": 9,
      "text_uthmani": "فَكَانَ قَابَ قَوْسَيْنِ أَوَ اَدْن۪ىٰۖ ٩",
      "text_simple": "فكان قاب قوسين او ادني ٩",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 4772,
      "number": 10,
      "text_uthmani": "فَأَوْح۪ىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْح۪ىٰۖ ١٠",
      "text_simple": "فاوحيٓ الي عبده مآ اوحي ١٠",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 4773,
      "number": 11,
      "text_uthmani": "مَا كَذَبَ اَ۬لْفُؤَادُ مَا ر۪أ۪ىٰٓۖ ١١",
      "text_simple": "ما كذب الفؤاد ما رايٓ ١١",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 4774,
      "number": 12,
      "text_uthmani": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَر۪ىٰۖ ١٢",
      "text_simple": "افتمرونه علي ما يري ١٢",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4775,
      "number": 13,
      "text_uthmani": "وَلَقَدْ ر۪ء۪اهُ نَزْلَةً ا۟خْر۪ىٰ ١٣",
      "text_simple": "ولقد رءاه نزله اخري ١٣",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4776,
      "number": 14,
      "text_uthmani": "عِندَ سِدْرَةِ اِ۬لْمُنتَه۪ىٰ ١٤",
      "text_simple": "عند سدره المنتهي ١٤",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 4777,
      "number": 15,
      "text_uthmani": "عِندَهَا جَنَّةُ اُ۬لْمَأْو۪ىٰٓ ١٥",
      "text_simple": "عندها جنه الماويٓ ١٥",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 4778,
      "number": 16,
      "text_uthmani": "إِذْ يَغْشَى اَ۬لسِّدْرَةَ مَا يَغْش۪ىٰۖ ١٦",
      "text_simple": "اذ يغشي السدره ما يغشي ١٦",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 4779,
      "number": 17,
      "text_uthmani": "مَا زَاغَ اَ۬لْبَصَرُ وَمَا طَغ۪ىٰۖ ١٧",
      "text_simple": "ما زاغ البصر وما طغي ١٧",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4780,
      "number": 18,
      "text_uthmani": "لَقَدْ ر۪أ۪ىٰ مِنَ اٰيَٰتِ رَبِّهِ اِ۬لْكُبْر۪ىٰٓۖ ١٨",
      "text_simple": "لقد راي من ايت ربه الكبريٓ ١٨",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 4781,
      "number": 19,
      "text_uthmani": "أَفَرَٰٓيْتُمُ اُ۬للَّٰتَ وَالْعُزّ۪ىٰ ١٩",
      "text_simple": "افرٓيتم اللت والعزي ١٩",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4782,
      "number": 20,
      "text_uthmani": "وَمَنَوٰةَ اَ۬لثَّالِثَةَ اَ۬لُاخْر۪ىٰٓ ٢٠",
      "text_simple": "ومنوه الثالثه الاخريٓ ٢٠",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4783,
      "number": 21,
      "text_uthmani": "أَلَكُمُ اُ۬لذَّكَرُ وَلَهُ اُ۬لُانث۪ىٰۖ ٢١",
      "text_simple": "الكم الذكر وله الانثي ٢١",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 4784,
      "number": 22,
      "text_uthmani": "تِلْكَ إِذاٗ قِسْمَةٞ ضِيز۪ىٰٓۖ ٢٢",
      "text_simple": "تلك اذاٗ قسمهٞ ضيزيٓ ٢٢",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 4785,
      "number": 23,
      "text_uthmani": "إِنْ هِيَ إِلَّآ أَسْمَآءٞ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ اَ۬للَّهُ بِهَا مِن سُلْطَٰنٍۖ اِنْ يَّتَّبِعُونَ إِلَّا اَ۬لظَّنَّ وَمَا تَهْوَى اَ۬لَانفُسُۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ اُ۬لْهُد۪ىٰٓۖ ٢٣",
      "text_simple": "ان هي الآ اسمآءٞ سميتموهآ انتم وءابآؤكم مآ انزل الله بها من سلطن ان يتبعون الا الظن وما تهوي الانفس ولقد جآءهم من ربهم الهديٓ ٢٣",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 11,
      "line_end": 13
    },
    {
      "id": 4786,
      "number": 24,
      "text_uthmani": "أَمْ لِلِانسَٰنِ مَا تَمَنّ۪ىٰۖ ٢٤",
      "text_simple": "ام للانسن ما تمني ٢٤",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 4787,
      "number": 25,
      "text_uthmani": "فَلِلهِ اِ۬لَاخِرَةُ وَالُاول۪ىٰۖ ٢٥",
      "text_simple": "فلله الاخره والاولي ٢٥",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4788,
      "number": 26,
      "text_uthmani": "۞ وَكَم مِّن مَّلَكٖ فِے اِ۬لسَّمَٰوَٰتِ لَا تُغْنِے شَفَٰعَتُهُمْ شَئْاً اِلَّا مِنۢ بَعْدِ أَنْ يَّاذَنَ اَ۬للَّهُ لِمَنْ يَّشَآءُ وَيَرْض۪ىٰٓۖ ٢٦",
      "text_simple": "وكم من ملكٖ فے السموت لا تغنے شفعتهم شئا الا من بعد ان ياذن الله لمن يشآء ويرضيٓ ٢٦",
      "juz": 27,
      "page": 526,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 4789,
      "number": 27,
      "text_uthmani": "إِنَّ اَ۬لذِينَ لَا يُومِنُونَ بِالَاخِرَةِ لَيُسَمُّونَ اَ۬لْمَلَٰٓئِكَةَ تَسْمِيَةَ اَ۬لُانث۪ىٰۖ ٢٧",
      "text_simple": "ان الذين لا يومنون بالاخره ليسمون الملٓئكه تسميه الانثي ٢٧",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4790,
      "number": 28,
      "text_uthmani": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍۖ اِنْ يَّتَّبِعُونَ إِلَّا اَ۬لظَّنَّۖ وَإِنَّ اَ۬لظَّنَّ لَا يُغْنِے مِنَ اَ۬لْحَقِّ شَئْاٗۖ فَأَعْرِضْ عَن مَّن تَوَلّ۪ىٰ عَن ذِكْرِنَا وَلَمْ يُرِدِ اِلَّا اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪اۖ ٢٨",
      "text_simple": "وما لهم به من علم ان يتبعون الا الظن وان الظن لا يغنے من الحق شئاٗ فاعرض عن من تولي عن ذكرنا ولم يرد الا الحيوه الدنيا ٢٨",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 2,
      "line_end": 4
    },
    {
      "id": 4791,
      "number": 29,
      "text_uthmani": "ذَٰلِكَ مَبْلَغُهُم مِّنَ اَ۬لْعِلْمِۖ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهُوَ أَعْلَمُ بِمَنِ اِ۪هْتَد۪ىٰۖ ٢٩",
      "text_simple": "ذلك مبلغهم من العلم ان ربك هو اعلم بمن ضل عن سبيله وهو اعلم بمن اهتدي ٢٩",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 4792,
      "number": 30,
      "text_uthmani": "وَلِلهِ مَا فِے اِ۬لسَّمَٰوَٰتِ وَمَا فِے اِ۬لَارْضِ لِيَجْزِيَ اَ۬لذِينَ أَسَٰٓـُٔواْ بِمَا عَمِلُواْ وَيَجْزِيَ اَ۬لذِينَ أَحْسَنُواْ بِالْحُسْنَىۖ ٣٠",
      "text_simple": "ولله ما فے السموت وما فے الارض ليجزي الذين اسٓـٔوا بما عملوا ويجزي الذين احسنوا بالحسني ٣٠",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 5,
      "line_end": 7
    },
    {
      "id": 4793,
      "number": 31,
      "text_uthmani": "اَ۬لذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ اَ۬لِاثْمِ وَالْفَوَٰحِشَ إِلَّا اَ۬للَّمَمَۖ إِنَّ رَبَّكَ وَٰسِعُ اُ۬لْمَغْفِرَةِۖ هُوَ أَعْلَمُ بِكُمُۥٓ إِذَ اَنشَأَكُم مِّنَ اَ۬لَارْضِ وَإِذَ اَنتُمُۥٓ أَجِنَّةٞ فِے بُطُونِ أُمَّهَٰتِكُمْۖ فَلَا تُزَكُّوٓاْ أَنفُسَكُمْۖ هُوَ أَعْلَمُ بِمَنِ اِ۪تَّق۪ىٰٓۖ ٣١",
      "text_simple": "الذين يجتنبون كبٓئر الاثم والفوحش الا اللمم ان ربك وسع المغفره هو اعلم بكمٓ اذ انشاكم من الارض واذ انتمٓ اجنهٞ فے بطون امهتكم فلا تزكوٓا انفسكم هو اعلم بمن اتقيٓ ٣١",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 7,
      "line_end": 10
    },
    {
      "id": 4794,
      "number": 32,
      "text_uthmani": "أَفَرَٰٓيْتَ اَ۬لذِے تَوَلّ۪ىٰ ٣٢",
      "text_simple": "افرٓيت الذے تولي ٣٢",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4795,
      "number": 33,
      "text_uthmani": "وَأَعْط۪ىٰ قَلِيلاٗ وَأَكْد۪ىٰٓ ٣٣",
      "text_simple": "واعطي قليلاٗ واكديٓ ٣٣",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4796,
      "number": 34,
      "text_uthmani": "أَعِندَهُۥ عِلْمُ اُ۬لْغَيْبِ فَهُوَ يَر۪ىٰٓۖ ٣٤",
      "text_simple": "اعنده علم الغيب فهو يريٓ ٣٤",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 4797,
      "number": 35,
      "text_uthmani": "أَمْ لَمْ يُنَبَّأْ بِمَا فِے صُحُفِ مُوس۪ىٰ ٣٥",
      "text_simple": "ام لم ينبا بما فے صحف موسي ٣٥",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 4798,
      "number": 36,
      "text_uthmani": "وَإِبْرَٰهِيمَ اَ۬لذِے وَفّ۪ىٰٓ ٣٦",
      "text_simple": "وابرهيم الذے وفيٓ ٣٦",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 4799,
      "number": 37,
      "text_uthmani": "أَلَّا تَزِرُ وَازِرَةٞ وِزْرَ أُخْر۪ىٰۖ ٣٧",
      "text_simple": "الا تزر وازرهٞ وزر اخري ٣٧",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 4800,
      "number": 38,
      "text_uthmani": "وَأَن لَّيْسَ لِلِانسَٰنِ إِلَّا مَا سَع۪ىٰۖ ٣٨",
      "text_simple": "وان ليس للانسن الا ما سعي ٣٨",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 4801,
      "number": 39,
      "text_uthmani": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُر۪ىٰۖ ٣٩",
      "text_simple": "وان سعيه سوف يري ٣٩",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 4802,
      "number": 40,
      "text_uthmani": "ثُمَّ يُجْز۪يٰهُ اُ۬لْجَزَآءَ اَ۬لَاوْف۪ىٰۖ ٤٠",
      "text_simple": "ثم يجزيه الجزآء الاوفي ٤٠",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4803,
      "number": 41,
      "text_uthmani": "وَأَنَّ إِلَىٰ رَبِّكَ اَ۬لْمُنتَه۪ىٰۖ ٤١",
      "text_simple": "وان الي ربك المنتهي ٤١",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4804,
      "number": 42,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْك۪ىٰۖ ٤٢",
      "text_simple": "وانه هو اضحك وابكي ٤٢",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 4805,
      "number": 43,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْي۪اۖ ٤٣",
      "text_simple": "وانه هو امات واحيا ٤٣",
      "juz": 27,
      "page": 527,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 4806,
      "number": 44,
      "text_uthmani": "وَأَنَّهُۥ خَلَقَ اَ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالُانث۪ىٰ ٤٤",
      "text_simple": "وانه خلق الزوجين الذكر والانثي ٤٤",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4807,
      "number": 45,
      "text_uthmani": "مِن نُّطْفَةٍ اِذَا تُمْن۪ىٰۖ ٤٥",
      "text_simple": "من نطفه اذا تمني ٤٥",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4808,
      "number": 46,
      "text_uthmani": "۞ وَأَنَّ عَلَيْهِ اِ۬لنَّشْأَةَ اَ۬لُاخْر۪ىٰۖ ٤٦",
      "text_simple": "وان عليه النشاه الاخري ٤٦",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 4809,
      "number": 47,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَغْن۪ىٰ وَأَقْن۪ىٰۖ ٤٧",
      "text_simple": "وانه هو اغني واقني ٤٧",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 4810,
      "number": 48,
      "text_uthmani": "وَأَنَّهُۥ هُوَ رَبُّ اُ۬لشِّعْر۪ىٰۖ ٤٨",
      "text_simple": "وانه هو رب الشعري ٤٨",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 4811,
      "number": 49,
      "text_uthmani": "وَأَنَّهُۥٓ أَهْلَكَ عَاداٗ اَ۬لُّاول۪ىٰ ٤٩",
      "text_simple": "وانهٓ اهلك عاداٗ الاولي ٤٩",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 4812,
      "number": 50,
      "text_uthmani": "وَثَمُوداٗ فَمَآ أَبْق۪ىٰ ٥٠",
      "text_simple": "وثموداٗ فمآ ابقي ٥٠",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 4813,
      "number": 51,
      "text_uthmani": "وَقَوْمَ نُوحٖ مِّن قَبْلُۖ إِنَّهُمْ كَانُواْ هُمُۥٓ أَظْلَمَ وَأَطْغ۪ىٰۖ ٥١",
      "text_simple": "وقوم نوحٖ من قبل انهم كانوا همٓ اظلم واطغي ٥١",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 4814,
      "number": 52,
      "text_uthmani": "وَالْمُوتَفِكَةَ أَهْو۪ىٰۖ ٥٢",
      "text_simple": "والموتفكه اهوي ٥٢",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 4815,
      "number": 53,
      "text_uthmani": "فَغَشّ۪يٰهَا مَا غَشّ۪ىٰۖ ٥٣",
      "text_simple": "فغشيها ما غشي ٥٣",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 4816,
      "number": 54,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكَ تَتَمَار۪ىٰۖ ٥٤",
      "text_simple": "فباي ءالآء ربك تتماري ٥٤",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 4817,
      "number": 55,
      "text_uthmani": "هَٰذَا نَذِيرٞ مِّنَ اَ۬لنُّذُرِ اِ۬لُاول۪ىٰٓۖ ٥٥",
      "text_simple": "هذا نذيرٞ من النذر الاوليٓ ٥٥",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 4818,
      "number": 56,
      "text_uthmani": "أَزِفَتِ اِ۬لَازِفَةُۖ ٥٦",
      "text_simple": "ازفت الازفه ٥٦",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 4819,
      "number": 57,
      "text_uthmani": "لَيْسَ لَهَا مِن دُونِ اِ۬للَّهِ كَاشِفَةٌۖ ٥٧",
      "text_simple": "ليس لها من دون الله كاشفه ٥٧",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4820,
      "number": 58,
      "text_uthmani": "اَفَمِنْ هَٰذَا اَ۬لْحَدِيثِ تَعْجَبُونَ ٥٨",
      "text_simple": "افمن هذا الحديث تعجبون ٥٨",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 4821,
      "number": 59,
      "text_uthmani": "وَتَضْحَكُونَ وَلَا تَبْكُونَ ٥٩",
      "text_simple": "وتضحكون ولا تبكون ٥٩",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 4822,
      "number": 60,
      "text_uthmani": "وَأَنتُمْ سَٰمِدُونَۖ ٦٠",
      "text_simple": "وانتم سمدون ٦٠",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 4823,
      "number": 61,
      "text_uthmani": "فَاسْجُدُواْ لِلهِ وَاعْبُدُواْۖ ٦١",
      "text_simple": "فاسجدوا لله واعبدوا ٦١",
      "juz": 27,
      "page": 528,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    }
  ]
}