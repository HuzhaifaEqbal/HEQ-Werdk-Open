{
  "number": 83,
  "name_ar": "المُطَففين",
  "name_en": "Al-Muṭaffifīn",
  "ayahs_count": 36,
  "page_start": 587,
  "page_end": 589,
  "ayahs": [
    {
      "id": 5824,
      "number": 1,
      "text_uthmani": "وَيْلٞ لِّلْمُطَفِّفِينَ ١",
      "text_simple": "ويلٞ للمطففين ١",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5825,
      "number": 2,
      "text_uthmani": "اَ۬لذِينَ إِذَا اَ۪كْتَالُواْ عَلَى اَ۬لنَّاسِ يَسْتَوْفُونَ ٢",
      "text_simple": "الذين اذا اكتالوا علي الناس يستوفون ٢",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5826,
      "number": 3,
      "text_uthmani": "وَإِذَا كَالُوهُمُۥٓ أَو وَّزَنُوهُمْ يُخْسِرُونَۖ ٣",
      "text_simple": "واذا كالوهمٓ او وزنوهم يخسرون ٣",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5827,
      "number": 4,
      "text_uthmani": "أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ ٤",
      "text_simple": "الا يظن اولٓئك انهم مبعوثون ٤",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5828,
      "number": 5,
      "text_uthmani": "لِيَوْمٍ عَظِيمٖ ٥",
      "text_simple": "ليوم عظيمٖ ٥",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5829,
      "number": 6,
      "text_uthmani": "يَوْمَ يَقُومُ اُ۬لنَّاسُ لِرَبِّ اِ۬لْعَٰلَمِينَۖ ٦",
      "text_simple": "يوم يقوم الناس لرب العلمين ٦",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5830,
      "number": 7,
      "text_uthmani": "كَلَّآ إِنَّ كِتَٰبَ اَ۬لْفُجّ۪ارِ لَفِے سِجِّينٖۖ ٧",
      "text_simple": "كلآ ان كتب الفجار لفے سجينٖ ٧",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5831,
      "number": 8,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا سِجِّينٞ ٨",
      "text_simple": "ومآ ادريك ما سجينٞ ٨",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5832,
      "number": 9,
      "text_uthmani": "كِتَٰبٞ مَّرْقُومٞۖ ٩",
      "text_simple": "كتبٞ مرقومٞ ٩",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5833,
      "number": 10,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَ ١٠",
      "text_simple": "ويلٞ يومئذٖ للمكذبين ١٠",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5834,
      "number": 11,
      "text_uthmani": "اَ۬لذِينَ يُكَذِّبُونَ بِيَوْمِ اِ۬لدِّينِۖ ١١",
      "text_simple": "الذين يكذبون بيوم الدين ١١",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5835,
      "number": 12,
      "text_uthmani": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ اَثِيمٍ ١٢",
      "text_simple": "وما يكذب بهٓ الا كل معتد اثيم ١٢",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5836,
      "number": 13,
      "text_uthmani": "اِذَا تُتْل۪ىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ ١٣",
      "text_simple": "اذا تتلي عليه ءايتنا قال اسطير الاولين ١٣",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5837,
      "number": 14,
      "text_uthmani": "۞ كَلَّا بَل رَّانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكْسِبُونَۖ ١٤",
      "text_simple": "كلا بل ران علي قلوبهم ما كانوا يكسبون ١٤",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5838,
      "number": 15,
      "text_uthmani": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٖ لَّمَحْجُوبُونَۖ ١٥",
      "text_simple": "كلآ انهم عن ربهم يومئذٖ لمحجوبون ١٥",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5839,
      "number": 16,
      "text_uthmani": "ثُمَّ إِنَّهُمْ لَصَالُواْ اُ۬لْجَحِيمِۖ ١٦",
      "text_simple": "ثم انهم لصالوا الجحيم ١٦",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5840,
      "number": 17,
      "text_uthmani": "ثُمَّ يُقَالُ هَٰذَا اَ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ ١٧",
      "text_simple": "ثم يقال هذا الذے كنتم به تكذبون ١٧",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5841,
      "number": 18,
      "text_uthmani": "كَلَّآ إِنَّ كِتَٰبَ اَ۬لَابْر۪ارِ لَفِے عِلِّيِّينَۖ ١٨",
      "text_simple": "كلآ ان كتب الابرار لفے عليين ١٨",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5842,
      "number": 19,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا عِلِّيُّونَ ١٩",
      "text_simple": "ومآ ادريك ما عليون ١٩",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5843,
      "number": 20,
      "text_uthmani": "كِتَٰبٞ مَّرْقُومٞ ٢٠",
      "text_simple": "كتبٞ مرقومٞ ٢٠",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5844,
      "number": 21,
      "text_uthmani": "يَشْهَدُهُ اُ۬لْمُقَرَّبُونَۖ ٢١",
      "text_simple": "يشهده المقربون ٢١",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5845,
      "number": 22,
      "text_uthmani": "إِنَّ اَ۬لَابْرَارَ لَفِے نَعِيمٍ ٢٢",
      "text_simple": "ان الابرار لفے نعيم ٢٢",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5846,
      "number": 23,
      "text_uthmani": "عَلَى اَ۬لَارَآئِكِ يَنظُرُونَ ٢٣",
      "text_simple": "علي الارآئك ينظرون ٢٣",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5847,
      "number": 24,
      "text_uthmani": "تَعْرِفُ فِے وُجُوهِهِمْ نَضْرَةَ اَ۬لنَّعِيمِ ٢٤",
      "text_simple": "تعرف فے وجوههم نضره النعيم ٢٤",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5848,
      "number": 25,
      "text_uthmani": "يُسْقَوْنَ مِن رَّحِيقٖ مَّخْتُومٍ ٢٥",
      "text_simple": "يسقون من رحيقٖ مختوم ٢٥",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5849,
      "number": 26,
      "text_uthmani": "خِتَٰمُهُۥ مِسْكٞۖ وَفِے ذَٰلِكَ فَلْيَتَنَافَسِ اِ۬لْمُتَنَٰفِسُونَۖ ٢٦",
      "text_simple": "ختمه مسكٞ وفے ذلك فليتنافس المتنفسون ٢٦",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5850,
      "number": 27,
      "text_uthmani": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ ٢٧",
      "text_simple": "ومزاجه من تسنيم ٢٧",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5851,
      "number": 28,
      "text_uthmani": "عَيْناٗ يَشْرَبُ بِهَا اَ۬لْمُقَرَّبُونَۖ ٢٨",
      "text_simple": "عيناٗ يشرب بها المقربون ٢٨",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5852,
      "number": 29,
      "text_uthmani": "إِنَّ اَ۬لذِينَ أَجْرَمُواْ كَانُواْ مِنَ اَ۬لذِينَ ءَامَنُواْ يَضْحَكُونَ ٢٩",
      "text_simple": "ان الذين اجرموا كانوا من الذين ءامنوا يضحكون ٢٩",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5853,
      "number": 30,
      "text_uthmani": "وَإِذَا مَرُّواْ بِهِمْ يَتَغَامَزُونَ ٣٠",
      "text_simple": "واذا مروا بهم يتغامزون ٣٠",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5854,
      "number": 31,
      "text_uthmani": "وَإِذَا اَ۪نقَلَبُوٓاْ إِلَىٰٓ أَهْلِهِمُ اُ۪نقَلَبُواْ فَٰكِهِينَ ٣١",
      "text_simple": "واذا انقلبوٓا اليٓ اهلهم انقلبوا فكهين ٣١",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5855,
      "number": 32,
      "text_uthmani": "وَإِذَا رَأَوْهُمْ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ ٣٢",
      "text_simple": "واذا راوهم قالوٓا ان هٓؤلآء لضآلون ٣٢",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5856,
      "number": 33,
      "text_uthmani": "وَمَآ أُرْسِلُواْ عَلَيْهِمْ حَٰفِظِينَۖ ٣٣",
      "text_simple": "ومآ ارسلوا عليهم حفظين ٣٣",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5857,
      "number": 34,
      "text_uthmani": "فَالْيَوْمَ اَ۬لذِينَ ءَامَنُواْ مِنَ اَ۬لْكُفّ۪ارِ يَضْحَكُونَ ٣٤",
      "text_simple": "فاليوم الذين ءامنوا من الكفار يضحكون ٣٤",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5858,
      "number": 35,
      "text_uthmani": "عَلَى اَ۬لَارَآئِكِۖ يَنظُرُونَ ٣٥",
      "text_simple": "علي الارآئك ينظرون ٣٥",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5859,
      "number": 36,
      "text_uthmani": "هَلْ ثُوِّبَ اَ۬لْكُفَّارُ مَا كَانُواْ يَفْعَلُونَۖ ٣٦",
      "text_simple": "هل ثوب الكفار ما كانوا يفعلون ٣٦",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    }
  ]
}