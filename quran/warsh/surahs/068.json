{
  "number": 68,
  "name_ar": "القَلَم",
  "name_en": "Al-Qalam",
  "ayahs_count": 52,
  "page_start": 564,
  "page_end": 566,
  "ayahs": [
    {
      "id": 5250,
      "number": 1,
      "text_uthmani": "نُّٓۖ وَالْقَلَمِ وَمَا يَسْطُرُونَ ١",
      "text_simple": "نٓ والقلم وما يسطرون ١",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5251,
      "number": 2,
      "text_uthmani": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٖ ٢",
      "text_simple": "مآ انت بنعمه ربك بمجنونٖ ٢",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5252,
      "number": 3,
      "text_uthmani": "وَإِنَّ لَكَ لَأَجْراً غَيْرَ مَمْنُونٖ ٣",
      "text_simple": "وان لك لاجرا غير ممنونٖ ٣",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5253,
      "number": 4,
      "text_uthmani": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖۖ ٤",
      "text_simple": "وانك لعلي خلق عظيمٖ ٤",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5254,
      "number": 5,
      "text_uthmani": "فَسَتُبْصِرُ وَيُبْصِرُونَ ٥",
      "text_simple": "فستبصر ويبصرون ٥",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5255,
      "number": 6,
      "text_uthmani": "بِأَييِّكُمُ اُ۬لْمَفْتُونُۖ ٦",
      "text_simple": "باييكم المفتون ٦",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5256,
      "number": 7,
      "text_uthmani": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَۖ ٧",
      "text_simple": "ان ربك هو اعلم بمن ضل عن سبيله وهو اعلم بالمهتدين ٧",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5257,
      "number": 8,
      "text_uthmani": "فَلَا تُطِعِ اِ۬لْمُكَذِّبِينَۖ ٨",
      "text_simple": "فلا تطع المكذبين ٨",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5258,
      "number": 9,
      "text_uthmani": "وَدُّواْ لَوْ تُدْهِنُ فَيُدْهِنُونَۖ ٩",
      "text_simple": "ودوا لو تدهن فيدهنون ٩",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5259,
      "number": 10,
      "text_uthmani": "وَلَا تُطِعْ كُلَّ حَلَّٰفٖ مَّهِينٍ ١٠",
      "text_simple": "ولا تطع كل حلفٖ مهين ١٠",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5260,
      "number": 11,
      "text_uthmani": "هَمَّازٖ مَّشَّآءِۢ بِنَمِيمٖ ١١",
      "text_simple": "همازٖ مشآء بنميمٖ ١١",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5261,
      "number": 12,
      "text_uthmani": "مَّنَّاعٖ لِّلْخَيْرِ مُعْتَدٍ اَثِيمٍ ١٢",
      "text_simple": "مناعٖ للخير معتد اثيم ١٢",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5262,
      "number": 13,
      "text_uthmani": "عُتُلِّۢ بَعْدَ ذَٰلِكَ زَنِيمٍ ١٣",
      "text_simple": "عتل بعد ذلك زنيم ١٣",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5263,
      "number": 14,
      "text_uthmani": "اَن كَانَ ذَا مَالٖ وَبَنِينَ ١٤",
      "text_simple": "ان كان ذا مالٖ وبنين ١٤",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5264,
      "number": 15,
      "text_uthmani": "إِذَا تُتْل۪ىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ ١٥",
      "text_simple": "اذا تتلي عليه ءايتنا قال اسطير الاولين ١٥",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5265,
      "number": 16,
      "text_uthmani": "سَنَسِمُهُۥ عَلَى اَ۬لْخُرْطُومِۖ ١٦",
      "text_simple": "سنسمه علي الخرطوم ١٦",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5266,
      "number": 17,
      "text_uthmani": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ اَ۬لْجَنَّةِ إِذَ اَقْسَمُواْ لَيَصْرِمُنَّهَا مُصْبِحِينَ ١٧",
      "text_simple": "انا بلونهم كما بلونآ اصحب الجنه اذ اقسموا ليصرمنها مصبحين ١٧",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5267,
      "number": 18,
      "text_uthmani": "وَلَا يَسْتَثْنُونَۖ ١٨",
      "text_simple": "ولا يستثنون ١٨",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5268,
      "number": 19,
      "text_uthmani": "۞ فَطَافَ عَلَيْهَا طَآئِفٞ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ ١٩",
      "text_simple": "فطاف عليها طآئفٞ من ربك وهم نآئمون ١٩",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5269,
      "number": 20,
      "text_uthmani": "فَأَصْبَحَتْ كَالصَّرِيمِۖ ٢٠",
      "text_simple": "فاصبحت كالصريم ٢٠",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5270,
      "number": 21,
      "text_uthmani": "فَتَنَادَوْاْ مُصْبِحِينَ ٢١",
      "text_simple": "فتنادوا مصبحين ٢١",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5271,
      "number": 22,
      "text_uthmani": "أَنُ اُ۟غْدُواْ عَلَىٰ حَرْثِكُمُۥٓ إِن كُنتُمْ صَٰرِمِينَۖ ٢٢",
      "text_simple": "ان اغدوا علي حرثكمٓ ان كنتم صرمين ٢٢",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5272,
      "number": 23,
      "text_uthmani": "فَانطَلَقُواْ وَهُمْ يَتَخَٰفَتُونَ ٢٣",
      "text_simple": "فانطلقوا وهم يتخفتون ٢٣",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5273,
      "number": 24,
      "text_uthmani": "أَن لَّا يَدْخُلَنَّهَا اَ۬لْيَوْمَ عَلَيْكُم مِّسْكِينٞۖ ٢٤",
      "text_simple": "ان لا يدخلنها اليوم عليكم مسكينٞ ٢٤",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5274,
      "number": 25,
      "text_uthmani": "وَغَدَوْاْ عَلَىٰ حَرْدٖ قَٰدِرِينَۖ ٢٥",
      "text_simple": "وغدوا علي حردٖ قدرين ٢٥",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5275,
      "number": 26,
      "text_uthmani": "فَلَمَّا رَأَوْهَا قَالُوٓاْ إِنَّا لَضَآلُّونَ ٢٦",
      "text_simple": "فلما راوها قالوٓا انا لضآلون ٢٦",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5276,
      "number": 27,
      "text_uthmani": "بَلْ نَحْنُ مَحْرُومُونَۖ ٢٧",
      "text_simple": "بل نحن محرومون ٢٧",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5277,
      "number": 28,
      "text_uthmani": "قَالَ أَوْسَطُهُمُۥٓ أَلَمَ اَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَۖ ٢٨",
      "text_simple": "قال اوسطهمٓ الم اقل لكم لولا تسبحون ٢٨",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5278,
      "number": 29,
      "text_uthmani": "قَالُواْ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَۖ ٢٩",
      "text_simple": "قالوا سبحن ربنآ انا كنا ظلمين ٢٩",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5279,
      "number": 30,
      "text_uthmani": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَلَٰوَمُونَۖ ٣٠",
      "text_simple": "فاقبل بعضهم علي بعضٖ يتلومون ٣٠",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5280,
      "number": 31,
      "text_uthmani": "قَالُواْ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ ٣١",
      "text_simple": "قالوا يويلنآ انا كنا طغين ٣١",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5281,
      "number": 32,
      "text_uthmani": "عَس۪ىٰ رَبُّنَآ أَنْ يُّبَدِّلَنَا خَيْراٗ مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَۖ ٣٢",
      "text_simple": "عسي ربنآ ان يبدلنا خيراٗ منهآ انآ الي ربنا رغبون ٣٢",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5282,
      "number": 33,
      "text_uthmani": "كَذَٰلِكَ اَ۬لْعَذَابُۖ وَلَعَذَابُ اُ۬لَاخِرَةِ أَكْبَرُ لَوْ كَانُواْ يَعْلَمُونَۖ ٣٣",
      "text_simple": "كذلك العذاب ولعذاب الاخره اكبر لو كانوا يعلمون ٣٣",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5283,
      "number": 34,
      "text_uthmani": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ اِ۬لنَّعِيمِۖ ٣٤",
      "text_simple": "ان للمتقين عند ربهم جنت النعيم ٣٤",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5284,
      "number": 35,
      "text_uthmani": "أَفَنَجْعَلُ اُ۬لْمُسْلِمِينَ كَالْمُجْرِمِينَۖ ٣٥",
      "text_simple": "افنجعل المسلمين كالمجرمين ٣٥",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5285,
      "number": 36,
      "text_uthmani": "مَا لَكُمْۖ كَيْفَ تَحْكُمُونَۖ ٣٦",
      "text_simple": "ما لكم كيف تحكمون ٣٦",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5286,
      "number": 37,
      "text_uthmani": "أَمْ لَكُمْ كِتَٰبٞ فِيهِ تَدْرُسُونَ ٣٧",
      "text_simple": "ام لكم كتبٞ فيه تدرسون ٣٧",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5287,
      "number": 38,
      "text_uthmani": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَۖ ٣٨",
      "text_simple": "ان لكم فيه لما تخيرون ٣٨",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5288,
      "number": 39,
      "text_uthmani": "أَمْ لَكُمُۥٓ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ اِلَىٰ يَوْمِ اِ۬لْقِيَٰمَةِ إِنَّ لَكُمْ لَمَا تَحْكُمُونَۖ ٣٩",
      "text_simple": "ام لكمٓ ايمن علينا بلغه الي يوم القيمه ان لكم لما تحكمون ٣٩",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5289,
      "number": 40,
      "text_uthmani": "سَلْهُمُۥٓ أَيُّهُم بِذَٰلِكَ زَعِيمٌۖ ٤٠",
      "text_simple": "سلهمٓ ايهم بذلك زعيم ٤٠",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5290,
      "number": 41,
      "text_uthmani": "اَمْ لَهُمْ شُرَكَآءُ فَلْيَاتُواْ بِشُرَكَآئِهِمُۥٓ إِن كَانُواْ صَٰدِقِينَۖ ٤١",
      "text_simple": "ام لهم شركآء فلياتوا بشركآئهمٓ ان كانوا صدقين ٤١",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5291,
      "number": 42,
      "text_uthmani": "يَوْمَ يُكْشَفُ عَن سَاقٖ وَيُدْعَوْنَ إِلَى اَ۬لسُّجُودِ فَلَا يَسْتَطِيعُونَۖ ٤٢",
      "text_simple": "يوم يكشف عن ساقٖ ويدعون الي السجود فلا يستطيعون ٤٢",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5292,
      "number": 43,
      "text_uthmani": "خَٰشِعَةً اَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ وَقَدْ كَانُواْ يُدْعَوْنَ إِلَى اَ۬لسُّجُودِ وَهُمْ سَٰلِمُونَۖ ٤٣",
      "text_simple": "خشعه ابصرهم ترهقهم ذلهٞ وقد كانوا يدعون الي السجود وهم سلمون ٤٣",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5293,
      "number": 44,
      "text_uthmani": "فَذَرْنِے وَمَنْ يُّكَذِّبُ بِهَٰذَا اَ۬لْحَدِيثِۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ ٤٤",
      "text_simple": "فذرنے ومن يكذب بهذا الحديث سنستدرجهم من حيث لا يعلمون ٤٤",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5294,
      "number": 45,
      "text_uthmani": "وَأُمْلِے لَهُمُۥٓۖ إِنَّ كَيْدِے مَتِينٌۖ ٤٥",
      "text_simple": "واملے لهمٓ ان كيدے متين ٤٥",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5295,
      "number": 46,
      "text_uthmani": "اَمْ تَسْـَٔلُهُمُۥٓ أَجْراٗ فَهُم مِّن مَّغْرَمٖ مُّثْقَلُونَۖ ٤٦",
      "text_simple": "ام تسـٔلهمٓ اجراٗ فهم من مغرمٖ مثقلون ٤٦",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5296,
      "number": 47,
      "text_uthmani": "أَمْ عِندَهُمُ اُ۬لْغَيْبُ فَهُمْ يَكْتُبُونَۖ ٤٧",
      "text_simple": "ام عندهم الغيب فهم يكتبون ٤٧",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5297,
      "number": 48,
      "text_uthmani": "۞ فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَٰحِبِ اِ۬لْحُوتِ إِذْ نَاد۪ىٰ وَهُوَ مَكْظُومٞۖ ٤٨",
      "text_simple": "فاصبر لحكم ربك ولا تكن كصحب الحوت اذ نادي وهو مكظومٞ ٤٨",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5298,
      "number": 49,
      "text_uthmani": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِالْعَرَآءِ وَهُوَ مَذْمُومٞۖ ٤٩",
      "text_simple": "لولآ ان تدركه نعمهٞ من ربه لنبذ بالعرآء وهو مذمومٞ ٤٩",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5299,
      "number": 50,
      "text_uthmani": "فَاجْتَبٰ۪هُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ اَ۬لصَّٰلِحِينَۖ ٥٠",
      "text_simple": "فاجتبه ربه فجعله من الصلحين ٥٠",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5300,
      "number": 51,
      "text_uthmani": "وَإِنْ يَّكَادُ اُ۬لذِينَ كَفَرُواْ لَيَزْلِقُونَكَ بِأَبْصٰ۪رِهِمْ لَمَّا سَمِعُواْ اُ۬لذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٞۖ ٥١",
      "text_simple": "وان يكاد الذين كفروا ليزلقونك بابصرهم لما سمعوا الذكر ويقولون انه لمجنونٞ ٥١",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5301,
      "number": 52,
      "text_uthmani": "وَمَا هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَۖ ٥٢",
      "text_simple": "وما هو الا ذكرٞ للعلمين ٥٢",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    }
  ]
}