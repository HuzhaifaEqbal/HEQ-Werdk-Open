{
  "number": 92,
  "name_ar": "اللَّيل",
  "name_en": "Al-Lail",
  "ayahs_count": 21,
  "page_start": 595,
  "page_end": 596,
  "ayahs": [
    {
      "id": 6036,
      "number": 1,
      "text_uthmani": "وَاليْلِ إِذَا يَغْش۪ىٰ ١",
      "text_simple": "واليل اذا يغشي ١",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 6037,
      "number": 2,
      "text_uthmani": "وَالنَّه۪ارِ إِذَا تَجَلّ۪ىٰ ٢",
      "text_simple": "والنهار اذا تجلي ٢",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 6038,
      "number": 3,
      "text_uthmani": "وَمَا خَلَقَ اَ۬لذَّكَرَ وَالُانث۪ىٰٓ ٣",
      "text_simple": "وما خلق الذكر والانثيٓ ٣",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 6039,
      "number": 4,
      "text_uthmani": "إِنَّ سَعْيَكُمْ لَشَتّ۪ىٰۖ ٤",
      "text_simple": "ان سعيكم لشتي ٤",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 6040,
      "number": 5,
      "text_uthmani": "فَأَمَّا مَنَ اَعْط۪ىٰ وَاتَّق۪ىٰ ٥",
      "text_simple": "فاما من اعطي واتقي ٥",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 6041,
      "number": 6,
      "text_uthmani": "وَصَدَّقَ بِالْحُسْن۪ىٰ ٦",
      "text_simple": "وصدق بالحسني ٦",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 6042,
      "number": 7,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْيُسْر۪ىٰۖ ٧",
      "text_simple": "فسنيسره لليسري ٧",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6043,
      "number": 8,
      "text_uthmani": "وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْن۪ىٰ ٨",
      "text_simple": "واما من بخل واستغني ٨",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6044,
      "number": 9,
      "text_uthmani": "وَكَذَّبَ بِالْحُسْن۪ىٰ ٩",
      "text_simple": "وكذب بالحسني ٩",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6045,
      "number": 10,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْعُسْر۪ىٰۖ ١٠",
      "text_simple": "فسنيسره للعسري ١٠",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 6046,
      "number": 11,
      "text_uthmani": "وَمَا يُغْنِے عَنْهُ مَالُهُۥٓ إِذَا تَرَدّ۪ىٰٓۖ ١١",
      "text_simple": "وما يغنے عنه مالهٓ اذا ترديٓ ١١",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 6047,
      "number": 12,
      "text_uthmani": "إِنَّ عَلَيْنَا لَلْهُد۪ىٰ ١٢",
      "text_simple": "ان علينا للهدي ١٢",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 6048,
      "number": 13,
      "text_uthmani": "وَإِنَّ لَنَا لَلَاخِرَةَ وَالُاول۪ىٰۖ ١٣",
      "text_simple": "وان لنا للاخره والاولي ١٣",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 6049,
      "number": 14,
      "text_uthmani": "فَأَنذَرْتُكُمْ نَاراٗ تَلَظّ۪ىٰ ١٤",
      "text_simple": "فانذرتكم ناراٗ تلظي ١٤",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 6050,
      "number": 15,
      "text_uthmani": "لَا يَصْلَيٰهَآ إِلَّا اَ۬لَاشْقَي ١٥",
      "text_simple": "لا يصليهآ الا الاشقي ١٥",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 6051,
      "number": 16,
      "text_uthmani": "اَ۬لذِے كَذَّبَ وَتَوَلّ۪ىٰۖ ١٦",
      "text_simple": "الذے كذب وتولي ١٦",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 6052,
      "number": 17,
      "text_uthmani": "وَسَيُجَنَّبُهَا اَ۬لَاتْقَي ١٧",
      "text_simple": "وسيجنبها الاتقي ١٧",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 6053,
      "number": 18,
      "text_uthmani": "اَ۬لذِے يُوتِے مَالَهُۥ يَتَزَكّ۪ىٰۖ ١٨",
      "text_simple": "الذے يوتے ماله يتزكي ١٨",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 6054,
      "number": 19,
      "text_uthmani": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْز۪ىٰٓ ١٩",
      "text_simple": "وما لاحد عنده من نعمهٖ تجزيٓ ١٩",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 6055,
      "number": 20,
      "text_uthmani": "إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لَاعْل۪ىٰۖ ٢٠",
      "text_simple": "الا ابتغآء وجه ربه الاعلي ٢٠",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 6056,
      "number": 21,
      "text_uthmani": "وَلَسَوْفَ يَرْض۪ىٰۖ ٢١",
      "text_simple": "ولسوف يرضي ٢١",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    }
  ]
}