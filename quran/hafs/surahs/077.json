{
  "number": 77,
  "name_ar": "المُرسَلات",
  "name_en": "Al-Mursalāt",
  "ayahs_count": 50,
  "page_start": 580,
  "page_end": 581,
  "ayahs": [
    {
      "id": 5623,
      "number": 1,
      "text_uthmani": "وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا ١",
      "text_simple": "والمرسلات عرفا",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5624,
      "number": 2,
      "text_uthmani": "فَٱلۡعَٰصِفَٰتِ عَصۡفٗا ٢",
      "text_simple": "فالعاصفات عصفا",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5625,
      "number": 3,
      "text_uthmani": "وَٱلنَّٰشِرَٰتِ نَشۡرٗا ٣",
      "text_simple": "والناشرات نشرا",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5626,
      "number": 4,
      "text_uthmani": "فَٱلۡفَٰرِقَٰتِ فَرۡقٗا ٤",
      "text_simple": "فالفارقات فرقا",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5627,
      "number": 5,
      "text_uthmani": "فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا ٥",
      "text_simple": "فالملقيات ذكرا",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5628,
      "number": 6,
      "text_uthmani": "عُذۡرًا أَوۡ نُذۡرًا ٦",
      "text_simple": "عذرا أو نذرا",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5629,
      "number": 7,
      "text_uthmani": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ ٧",
      "text_simple": "إنما توعدون لواقع",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5630,
      "number": 8,
      "text_uthmani": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ ٨",
      "text_simple": "فإذا النجوم طمست",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5631,
      "number": 9,
      "text_uthmani": "وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ ٩",
      "text_simple": "وإذا السماء فرجت",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5632,
      "number": 10,
      "text_uthmani": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ ١٠",
      "text_simple": "وإذا الجبال نسفت",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5633,
      "number": 11,
      "text_uthmani": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ ١١",
      "text_simple": "وإذا الرسل أقتت",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5634,
      "number": 12,
      "text_uthmani": "لِأَيِّ يَوۡمٍ أُجِّلَتۡ ١٢",
      "text_simple": "لأي يوم أجلت",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5635,
      "number": 13,
      "text_uthmani": "لِيَوۡمِ ٱلۡفَصۡلِ ١٣",
      "text_simple": "ليوم الفصل",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5636,
      "number": 14,
      "text_uthmani": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ ١٤",
      "text_simple": "وما أدراك ما يوم الفصل",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5637,
      "number": 15,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١٥",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5638,
      "number": 16,
      "text_uthmani": "أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ ١٦",
      "text_simple": "ألم نهلك الأولين",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5639,
      "number": 17,
      "text_uthmani": "ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ ١٧",
      "text_simple": "ثم نتبعهم الآخرين",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5640,
      "number": 18,
      "text_uthmani": "كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ١٨",
      "text_simple": "كذلك نفعل بالمجرمين",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5641,
      "number": 19,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١٩",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 29,
      "page": 580,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5642,
      "number": 20,
      "text_uthmani": "أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ ٢٠",
      "text_simple": "ألم نخلقكم من ماء مهين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5643,
      "number": 21,
      "text_uthmani": "فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ ٢١",
      "text_simple": "فجعلناه في قرار مكين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5644,
      "number": 22,
      "text_uthmani": "إِلَىٰ قَدَرٖ مَّعۡلُومٖ ٢٢",
      "text_simple": "إلى قدر معلوم",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5645,
      "number": 23,
      "text_uthmani": "فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ ٢٣",
      "text_simple": "فقدرنا فنعم القادرون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5646,
      "number": 24,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٢٤",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5647,
      "number": 25,
      "text_uthmani": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا ٢٥",
      "text_simple": "ألم نجعل الأرض كفاتا",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5648,
      "number": 26,
      "text_uthmani": "أَحۡيَآءٗ وَأَمۡوَٰتٗا ٢٦",
      "text_simple": "أحياء وأمواتا",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5649,
      "number": 27,
      "text_uthmani": "وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا ٢٧",
      "text_simple": "وجعلنا فيها رواسي شامخات وأسقيناكم ماء فراتا",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5650,
      "number": 28,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٢٨",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5651,
      "number": 29,
      "text_uthmani": "ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ ٢٩",
      "text_simple": "انطلقوا إلى ما كنتم به تكذبون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5652,
      "number": 30,
      "text_uthmani": "ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ ٣٠",
      "text_simple": "انطلقوا إلى ظل ذي ثلاث شعب",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5653,
      "number": 31,
      "text_uthmani": "لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ ٣١",
      "text_simple": "لا ظليل ولا يغني من اللهب",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5654,
      "number": 32,
      "text_uthmani": "إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ ٣٢",
      "text_simple": "إنها ترمي بشرر كالقصر",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5655,
      "number": 33,
      "text_uthmani": "كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ ٣٣",
      "text_simple": "كأنه جمالة صفر",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5656,
      "number": 34,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٣٤",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5657,
      "number": 35,
      "text_uthmani": "هَٰذَا يَوۡمُ لَا يَنطِقُونَ ٣٥",
      "text_simple": "هذا يوم لا ينطقون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5658,
      "number": 36,
      "text_uthmani": "وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ ٣٦",
      "text_simple": "ولا يؤذن لهم فيعتذرون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5659,
      "number": 37,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٣٧",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5660,
      "number": 38,
      "text_uthmani": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ ٣٨",
      "text_simple": "هذا يوم الفصل جمعناكم والأولين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5661,
      "number": 39,
      "text_uthmani": "فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ ٣٩",
      "text_simple": "فإن كان لكم كيد فكيدون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5662,
      "number": 40,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٠",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5663,
      "number": 41,
      "text_uthmani": "إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ ٤١",
      "text_simple": "إن المتقين في ظلال وعيون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5664,
      "number": 42,
      "text_uthmani": "وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ ٤٢",
      "text_simple": "وفواكه مما يشتهون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5665,
      "number": 43,
      "text_uthmani": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ ٤٣",
      "text_simple": "كلوا واشربوا هنيئا بما كنتم تعملون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5666,
      "number": 44,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ٤٤",
      "text_simple": "إنا كذلك نجزي المحسنين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5667,
      "number": 45,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٥",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5668,
      "number": 46,
      "text_uthmani": "كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ ٤٦",
      "text_simple": "كلوا وتمتعوا قليلا إنكم مجرمون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5669,
      "number": 47,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٧",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5670,
      "number": 48,
      "text_uthmani": "وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ ٤٨",
      "text_simple": "وإذا قيل لهم اركعوا لا يركعون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5671,
      "number": 49,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٩",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5672,
      "number": 50,
      "text_uthmani": "فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ ٥٠",
      "text_simple": "فبأي حديث بعده يؤمنون",
      "juz": 29,
      "page": 581,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    }
  ]
}