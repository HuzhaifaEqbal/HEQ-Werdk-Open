{
  "number": 78,
  "name_ar": "النَّبَإ",
  "name_en": "An-Naba’",
  "ayahs_count": 40,
  "page_start": 582,
  "page_end": 583,
  "ayahs": [
    {
      "id": 5673,
      "number": 1,
      "text_uthmani": "عَمَّ يَتَسَآءَلُونَ ١",
      "text_simple": "عم يتساءلون",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5674,
      "number": 2,
      "text_uthmani": "عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ ٢",
      "text_simple": "عن النبإ العظيم",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5675,
      "number": 3,
      "text_uthmani": "ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ ٣",
      "text_simple": "الذي هم فيه مختلفون",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5676,
      "number": 4,
      "text_uthmani": "كـَلَّا سَيَعۡلَمُونَ ٤",
      "text_simple": "كلا سيعلمون",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5677,
      "number": 5,
      "text_uthmani": "ثُمَّ كـَلَّا سَيَعۡلَمُونَ ٥",
      "text_simple": "ثم كلا سيعلمون",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5678,
      "number": 6,
      "text_uthmani": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا ٦",
      "text_simple": "ألم نجعل الأرض مهادا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5679,
      "number": 7,
      "text_uthmani": "وَٱلۡجِبَالَ أَوۡتَادٗا ٧",
      "text_simple": "والجبال أوتادا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5680,
      "number": 8,
      "text_uthmani": "وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا ٨",
      "text_simple": "وخلقناكم أزواجا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5681,
      "number": 9,
      "text_uthmani": "وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا ٩",
      "text_simple": "وجعلنا نومكم سباتا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5682,
      "number": 10,
      "text_uthmani": "وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا ١٠",
      "text_simple": "وجعلنا الليل لباسا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5683,
      "number": 11,
      "text_uthmani": "وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا ١١",
      "text_simple": "وجعلنا النهار معاشا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5684,
      "number": 12,
      "text_uthmani": "وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا ١٢",
      "text_simple": "وبنينا فوقكم سبعا شدادا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5685,
      "number": 13,
      "text_uthmani": "وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا ١٣",
      "text_simple": "وجعلنا سراجا وهاجا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5686,
      "number": 14,
      "text_uthmani": "وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا ١٤",
      "text_simple": "وأنزلنا من المعصرات ماء ثجاجا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5687,
      "number": 15,
      "text_uthmani": "لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا ١٥",
      "text_simple": "لنخرج به حبا ونباتا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5688,
      "number": 16,
      "text_uthmani": "وَجَنَّٰتٍ أَلۡفَافًا ١٦",
      "text_simple": "وجنات ألفافا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5689,
      "number": 17,
      "text_uthmani": "إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا ١٧",
      "text_simple": "إن يوم الفصل كان ميقاتا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5690,
      "number": 18,
      "text_uthmani": "يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا ١٨",
      "text_simple": "يوم ينفخ في الصور فتأتون أفواجا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5691,
      "number": 19,
      "text_uthmani": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا ١٩",
      "text_simple": "وفتحت السماء فكانت أبوابا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5692,
      "number": 20,
      "text_uthmani": "وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا ٢٠",
      "text_simple": "وسيرت الجبال فكانت سرابا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5693,
      "number": 21,
      "text_uthmani": "إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا ٢١",
      "text_simple": "إن جهنم كانت مرصادا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5694,
      "number": 22,
      "text_uthmani": "لِّلطَّٰغِينَ مَـَٔابٗا ٢٢",
      "text_simple": "للطاغين مآبا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5695,
      "number": 23,
      "text_uthmani": "لَّٰبِثِينَ فِيهَآ أَحۡقَابٗا ٢٣",
      "text_simple": "لابثين فيها أحقابا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5696,
      "number": 24,
      "text_uthmani": "لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا ٢٤",
      "text_simple": "لا يذوقون فيها بردا ولا شرابا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5697,
      "number": 25,
      "text_uthmani": "إِلَّا حَمِيمٗا وَغَسَّاقٗا ٢٥",
      "text_simple": "إلا حميما وغساقا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5698,
      "number": 26,
      "text_uthmani": "جَزَآءٗ وِفَاقًا ٢٦",
      "text_simple": "جزاء وفاقا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5699,
      "number": 27,
      "text_uthmani": "إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا ٢٧",
      "text_simple": "إنهم كانوا لا يرجون حسابا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5700,
      "number": 28,
      "text_uthmani": "وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا ٢٨",
      "text_simple": "وكذبوا بآياتنا كذابا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5701,
      "number": 29,
      "text_uthmani": "وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا ٢٩",
      "text_simple": "وكل شيء أحصيناه كتابا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5702,
      "number": 30,
      "text_uthmani": "فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا ٣٠",
      "text_simple": "فذوقوا فلن نزيدكم إلا عذابا",
      "juz": 30,
      "page": 582,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5703,
      "number": 31,
      "text_uthmani": "إِنَّ لِلۡمُتَّقِينَ مَفَازًا ٣١",
      "text_simple": "إن للمتقين مفازا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5704,
      "number": 32,
      "text_uthmani": "حَدَآئِقَ وَأَعۡنَٰبٗا ٣٢",
      "text_simple": "حدائق وأعنابا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5705,
      "number": 33,
      "text_uthmani": "وَكَوَاعِبَ أَتۡرَابٗا ٣٣",
      "text_simple": "وكواعب أترابا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5706,
      "number": 34,
      "text_uthmani": "وَكَأۡسٗا دِهَاقٗا ٣٤",
      "text_simple": "وكأسا دهاقا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5707,
      "number": 35,
      "text_uthmani": "لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا ٣٥",
      "text_simple": "لا يسمعون فيها لغوا ولا كذابا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5708,
      "number": 36,
      "text_uthmani": "جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا ٣٦",
      "text_simple": "جزاء من ربك عطاء حسابا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5709,
      "number": 37,
      "text_uthmani": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا ٣٧",
      "text_simple": "رب السموات والأرض وما بينهما الرحمن لا يملكون منه خطابا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5710,
      "number": 38,
      "text_uthmani": "يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا ٣٨",
      "text_simple": "يوم يقوم الروح والملائكة صفا لا يتكلمون إلا من أذن له الرحمن وقال صوابا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5711,
      "number": 39,
      "text_uthmani": "ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا ٣٩",
      "text_simple": "ذلك اليوم الحق فمن شاء اتخذ إلى ربه مآبا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5712,
      "number": 40,
      "text_uthmani": "إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا ٤٠",
      "text_simple": "إنا أنذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر ياليتني كنت ترابا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    }
  ]
}