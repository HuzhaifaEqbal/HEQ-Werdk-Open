{
  "number": 92,
  "name_ar": "اللَّيل",
  "name_en": "Al-Lail",
  "ayahs_count": 21,
  "page_start": 595,
  "page_end": 596,
  "ayahs": [
    {
      "id": 6059,
      "number": 1,
      "text_uthmani": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ ١",
      "text_simple": "والليل إذا يغشى",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 6060,
      "number": 2,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ ٢",
      "text_simple": "والنهار إذا تجلى",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 6061,
      "number": 3,
      "text_uthmani": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ ٣",
      "text_simple": "وما خلق الذكر والأنثى",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 6062,
      "number": 4,
      "text_uthmani": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ ٤",
      "text_simple": "إن سعيكم لشتى",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 6063,
      "number": 5,
      "text_uthmani": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ ٥",
      "text_simple": "فأما من أعطى واتقى",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 6064,
      "number": 6,
      "text_uthmani": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ ٦",
      "text_simple": "وصدق بالحسنى",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 6065,
      "number": 7,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ ٧",
      "text_simple": "فسنيسره لليسرى",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6066,
      "number": 8,
      "text_uthmani": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ ٨",
      "text_simple": "وأما من بخل واستغنى",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6067,
      "number": 9,
      "text_uthmani": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ ٩",
      "text_simple": "وكذب بالحسنى",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6068,
      "number": 10,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ ١٠",
      "text_simple": "فسنيسره للعسرى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 6069,
      "number": 11,
      "text_uthmani": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ ١١",
      "text_simple": "وما يغني عنه ماله إذا تردى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 6070,
      "number": 12,
      "text_uthmani": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ ١٢",
      "text_simple": "إن علينا للهدى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 6071,
      "number": 13,
      "text_uthmani": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ ١٣",
      "text_simple": "وإن لنا للآخرة والأولى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 6072,
      "number": 14,
      "text_uthmani": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ ١٤",
      "text_simple": "فأنذرتكم نارا تلظى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 6073,
      "number": 15,
      "text_uthmani": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى ١٥",
      "text_simple": "لا يصلاها إلا الأشقى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 6074,
      "number": 16,
      "text_uthmani": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ ١٦",
      "text_simple": "الذي كذب وتولى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 6075,
      "number": 17,
      "text_uthmani": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى ١٧",
      "text_simple": "وسيجنبها الأتقى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 6076,
      "number": 18,
      "text_uthmani": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ ١٨",
      "text_simple": "الذي يؤتي ماله يتزكى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 6077,
      "number": 19,
      "text_uthmani": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ ١٩",
      "text_simple": "وما لأحد عنده من نعمة تجزى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 6078,
      "number": 20,
      "text_uthmani": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ ٢٠",
      "text_simple": "إلا ابتغاء وجه ربه الأعلى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 6079,
      "number": 21,
      "text_uthmani": "وَلَسَوۡفَ يَرۡضَىٰ ٢١",
      "text_simple": "ولسوف يرضى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    }
  ]
}