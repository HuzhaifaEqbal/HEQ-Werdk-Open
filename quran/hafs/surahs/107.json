      "page": 602,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6199,
      "number": 2,
      "text_uthmani": "فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ ٢",
      "text_simple": "فذلك الذي يدع اليتيم",
      "juz": 30,
      "page": 602,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 6200,
      "number": 3,
      "text_uthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ٣",
      "text_simple": "ولا يحض على طعام المسكين",
      "juz": 30,
      "page": 602,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6201,
      "number": 4,
      "text_uthmani": "فَوَيۡلٞ لِّلۡمُصَلِّينَ ٤",
