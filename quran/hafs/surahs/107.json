      "juz": 30,
      "page": 602,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 6202,
      "number": 5,
      "text_uthmani": "ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ ٥",
      "text_simple": "الذين هم عن صلاتهم ساهون",
      "juz": 30,
      "page": 602,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6203,
      "number": 6,
      "text_uthmani": "ٱلَّذِينَ هُمۡ يُرَآءُونَ ٦",
