{
  "number": 89,
  "name_ar": "الفَجر",
  "name_en": "Al-Fajr",
  "ayahs_count": 30,
  "page_start": 593,
  "page_end": 594,
  "ayahs": [
    {
      "id": 5994,
      "number": 1,
      "text_uthmani": "وَٱلۡفَجۡرِ ١",
      "text_simple": "والفجر",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5995,
      "number": 2,
      "text_uthmani": "وَلَيَالٍ عَشۡرٖ ٢",
      "text_simple": "وليال عشر",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5996,
      "number": 3,
      "text_uthmani": "وَٱلشَّفۡعِ وَٱلۡوَتۡرِ ٣",
      "text_simple": "والشفع والوتر",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5997,
      "number": 4,
      "text_uthmani": "وَٱلَّيۡلِ إِذَا يَسۡرِ ٤",
      "text_simple": "والليل إذا يسر",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5998,
      "number": 5,
      "text_uthmani": "هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ ٥",
      "text_simple": "هل في ذلك قسم لذي حجر",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5999,
      "number": 6,
      "text_uthmani": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ ٦",
      "text_simple": "ألم تر كيف فعل ربك بعاد",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 6000,
      "number": 7,
      "text_uthmani": "إِرَمَ ذَاتِ ٱلۡعِمَادِ ٧",
      "text_simple": "إرم ذات العماد",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 6001,
      "number": 8,
      "text_uthmani": "ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ ٨",
      "text_simple": "التي لم يخلق مثلها في البلاد",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 6002,
      "number": 9,
      "text_uthmani": "وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ ٩",
      "text_simple": "وثمود الذين جابوا الصخر بالواد",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 6003,
      "number": 10,
      "text_uthmani": "وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ ١٠",
      "text_simple": "وفرعون ذي الأوتاد",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6004,
      "number": 11,
      "text_uthmani": "ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ ١١",
      "text_simple": "الذين طغوا في البلاد",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 6005,
      "number": 12,
      "text_uthmani": "فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ ١٢",
      "text_simple": "فأكثروا فيها الفساد",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6006,
      "number": 13,
      "text_uthmani": "فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ ١٣",
      "text_simple": "فصب عليهم ربك سوط عذاب",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 6007,
      "number": 14,
      "text_uthmani": "إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ ١٤",
      "text_simple": "إن ربك لبالمرصاد",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6008,
      "number": 15,
      "text_uthmani": "فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ ١٥",
      "text_simple": "فأما الإنسان إذا ما ابتلاه ربه فأكرمه ونعمه فيقول ربي أكرمن",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 6009,
      "number": 16,
      "text_uthmani": "وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ ١٦",
      "text_simple": "وأما إذا ما ابتلاه فقدر عليه رزقه فيقول ربي أهانن",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 6010,
      "number": 17,
      "text_uthmani": "كـَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ ١٧",
      "text_simple": "كلا بل لا تكرمون اليتيم",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 6011,
      "number": 18,
      "text_uthmani": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ١٨",
      "text_simple": "ولا تحاضون على طعام المسكين",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 6012,
      "number": 19,
      "text_uthmani": "وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا ١٩",
      "text_simple": "وتأكلون التراث أكلا لما",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 6013,
      "number": 20,
      "text_uthmani": "وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا ٢٠",
      "text_simple": "وتحبون المال حبا جما",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 6014,
      "number": 21,
      "text_uthmani": "كـَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا ٢١",
      "text_simple": "كلا إذا دكت الأرض دكا دكا",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 6015,
      "number": 22,
      "text_uthmani": "وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا ٢٢",
      "text_simple": "وجاء ربك والملك صفا صفا",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6016,
      "number": 23,
      "text_uthmani": "وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ ٢٣",
      "text_simple": "وجيء يومئذ بجهنم يومئذ يتذكر الإنسان وأنى له الذكرى",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 6017,
      "number": 24,
      "text_uthmani": "يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي ٢٤",
      "text_simple": "يقول ياليتني قدمت لحياتي",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 6018,
      "number": 25,
      "text_uthmani": "فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ ٢٥",
      "text_simple": "فيومئذ لا يعذب عذابه أحد",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 6019,
      "number": 26,
      "text_uthmani": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ ٢٦",
      "text_simple": "ولا يوثق وثاقه أحد",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 6020,
      "number": 27,
      "text_uthmani": "يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ ٢٧",
      "text_simple": "ياأيتها النفس المطمئنة",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 6021,
      "number": 28,
      "text_uthmani": "ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ ٢٨",
      "text_simple": "ارجعي إلى ربك راضية مرضية",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 6022,
      "number": 29,
      "text_uthmani": "فَٱدۡخُلِي فِي عِبَٰدِي ٢٩",
      "text_simple": "فادخلي في عبادي",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 6023,
      "number": 30,
      "text_uthmani": "وَٱدۡخُلِي جَنَّتِي ٣٠",
      "text_simple": "وادخلي جنتي",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    }
  ]
}