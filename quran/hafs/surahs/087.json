{
  "number": 87,
  "name_ar": "الأعلى",
  "name_en": "Al-A‘lā",
  "ayahs_count": 19,
  "page_start": 591,
  "page_end": 592,
  "ayahs": [
    {
      "id": 5949,
      "number": 1,
      "text_uthmani": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى ١",
      "text_simple": "سبح اسم ربك الأعلى",
      "juz": 30,
      "page": 591,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5950,
      "number": 2,
      "text_uthmani": "ٱلَّذِي خَلَقَ فَسَوَّىٰ ٢",
      "text_simple": "الذي خلق فسوى",
      "juz": 30,
      "page": 591,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5951,
      "number": 3,
      "text_uthmani": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ ٣",
      "text_simple": "والذي قدر فهدى",
      "juz": 30,
      "page": 591,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5952,
      "number": 4,
      "text_uthmani": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ ٤",
      "text_simple": "والذي أخرج المرعى",
      "juz": 30,
      "page": 591,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5953,
      "number": 5,
      "text_uthmani": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ ٥",
      "text_simple": "فجعله غثاء أحوى",
      "juz": 30,
      "page": 591,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5954,
      "number": 6,
      "text_uthmani": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ ٦",
      "text_simple": "سنقرئك فلا تنسى",
      "juz": 30,
      "page": 591,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5955,
      "number": 7,
      "text_uthmani": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ ٧",
      "text_simple": "إلا ما شاء الله إنه يعلم الجهر وما يخفى",
      "juz": 30,
      "page": 591,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5956,
      "number": 8,
      "text_uthmani": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ ٨",
      "text_simple": "ونيسرك لليسرى",
      "juz": 30,
      "page": 591,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5957,
      "number": 9,
      "text_uthmani": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ ٩",
      "text_simple": "فذكر إن نفعت الذكرى",
      "juz": 30,
      "page": 591,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5958,
      "number": 10,
      "text_uthmani": "سَيَذَّكَّرُ مَن يَخۡشَىٰ ١٠",
      "text_simple": "سيذكر من يخشى",
      "juz": 30,
      "page": 591,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5959,
      "number": 11,
      "text_uthmani": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى ١١",
      "text_simple": "ويتجنبها الأشقى",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5960,
      "number": 12,
      "text_uthmani": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ ١٢",
      "text_simple": "الذي يصلى النار الكبرى",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5961,
      "number": 13,
      "text_uthmani": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ ١٣",
      "text_simple": "ثم لا يموت فيها ولا يحيا",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5962,
      "number": 14,
      "text_uthmani": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ ١٤",
      "text_simple": "قد أفلح من تزكى",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5963,
      "number": 15,
      "text_uthmani": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ ١٥",
      "text_simple": "وذكر اسم ربه فصلى",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5964,
      "number": 16,
      "text_uthmani": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ١٦",
      "text_simple": "بل تؤثرون الحياة الدنيا",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5965,
      "number": 17,
      "text_uthmani": "وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ ١٧",
      "text_simple": "والآخرة خير وأبقى",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5966,
      "number": 18,
      "text_uthmani": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ ١٨",
      "text_simple": "إن هذا لفي الصحف الأولى",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5967,
      "number": 19,
      "text_uthmani": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ ١٩",
      "text_simple": "صحف إبراهيم وموسى",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    }
  ]
}