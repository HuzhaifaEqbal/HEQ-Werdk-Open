{
  "number": 68,
  "name_ar": "القَلَم",
  "name_en": "Al-Qalam",
  "ayahs_count": 52,
  "page_start": 564,
  "page_end": 566,
  "ayahs": [
    {
      "id": 5272,
      "number": 1,
      "text_uthmani": "نٓۚ وَٱلۡقَلَمِ وَمَا يَسۡطُرُونَ ١",
      "text_simple": "ن والقلم وما يسطرون",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5273,
      "number": 2,
      "text_uthmani": "مَآ أَنتَ بِنِعۡمَةِ رَبِّكَ بِمَجۡنُونٖ ٢",
      "text_simple": "ما أنت بنعمة ربك بمجنون",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5274,
      "number": 3,
      "text_uthmani": "وَإِنَّ لَكَ لَأَجۡرًا غَيۡرَ مَمۡنُونٖ ٣",
      "text_simple": "وإن لك لأجرا غير ممنون",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5275,
      "number": 4,
      "text_uthmani": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖ ٤",
      "text_simple": "وإنك لعلى خلق عظيم",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5276,
      "number": 5,
      "text_uthmani": "فَسَتُبۡصِرُ وَيُبۡصِرُونَ ٥",
      "text_simple": "فستبصر ويبصرون",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5277,
      "number": 6,
      "text_uthmani": "بِأَييِّكُمُ ٱلۡمَفۡتُونُ ٦",
      "text_simple": "بأيكم المفتون",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5278,
      "number": 7,
      "text_uthmani": "إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِٱلۡمُهۡتَدِينَ ٧",
      "text_simple": "إن ربك هو أعلم بمن ضل عن سبيله وهو أعلم بالمهتدين",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5279,
      "number": 8,
      "text_uthmani": "فَلَا تُطِعِ ٱلۡمُكَذِّبِينَ ٨",
      "text_simple": "فلا تطع المكذبين",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5280,
      "number": 9,
      "text_uthmani": "وَدُّواْ لَوۡ تُدۡهِنُ فَيُدۡهِنُونَ ٩",
      "text_simple": "ودوا لو تدهن فيدهنون",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5281,
      "number": 10,
      "text_uthmani": "وَلَا تُطِعۡ كُلَّ حَلَّافٖ مَّهِينٍ ١٠",
      "text_simple": "ولا تطع كل حلاف مهين",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5282,
      "number": 11,
      "text_uthmani": "هَمَّازٖ مَّشَّآءِۭ بِنَمِيمٖ ١١",
      "text_simple": "هماز مشاء بنميم",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5283,
      "number": 12,
      "text_uthmani": "مَّنَّاعٖ لِّلۡخَيۡرِ مُعۡتَدٍ أَثِيمٍ ١٢",
      "text_simple": "مناع للخير معتد أثيم",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5284,
      "number": 13,
      "text_uthmani": "عُتُلِّۭ بَعۡدَ ذَٰلِكَ زَنِيمٍ ١٣",
      "text_simple": "عتل بعد ذلك زنيم",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5285,
      "number": 14,
      "text_uthmani": "أَن كَانَ ذَا مَالٖ وَبَنِينَ ١٤",
      "text_simple": "أن كان ذا مال وبنين",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5286,
      "number": 15,
      "text_uthmani": "إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ ١٥",
      "text_simple": "إذا تتلى عليه آياتنا قال أساطير الأولين",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5287,
      "number": 16,
      "text_uthmani": "سَنَسِمُهُۥ عَلَى ٱلۡخُرۡطُومِ ١٦",
      "text_simple": "سنسمه على الخرطوم",
      "juz": 29,
      "page": 564,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5288,
      "number": 17,
      "text_uthmani": "إِنَّا بَلَوۡنَٰهُمۡ كَمَا بَلَوۡنَآ أَصۡحَٰبَ ٱلۡجَنَّةِ إِذۡ أَقۡسَمُواْ لَيَصۡرِمُنَّهَا مُصۡبِحِينَ ١٧",
      "text_simple": "إنا بلوناهم كما بلونا أصحاب الجنة إذ أقسموا ليصرمنها مصبحين",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5289,
      "number": 18,
      "text_uthmani": "وَلَا يَسۡتَثۡنُونَ ١٨",
      "text_simple": "ولا يستثنون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5290,
      "number": 19,
      "text_uthmani": "فَطَافَ عَلَيۡهَا طَآئِفٞ مِّن رَّبِّكَ وَهُمۡ نَآئِمُونَ ١٩",
      "text_simple": "فطاف عليها طائف من ربك وهم نائمون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5291,
      "number": 20,
      "text_uthmani": "فَأَصۡبَحَتۡ كَٱلصَّرِيمِ ٢٠",
      "text_simple": "فأصبحت كالصريم",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5292,
      "number": 21,
      "text_uthmani": "فَتَنَادَوۡاْ مُصۡبِحِينَ ٢١",
      "text_simple": "فتنادوا مصبحين",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5293,
      "number": 22,
      "text_uthmani": "أَنِ ٱغۡدُواْ عَلَىٰ حَرۡثِكُمۡ إِن كُنتُمۡ صَٰرِمِينَ ٢٢",
      "text_simple": "أن اغدوا على حرثكم إن كنتم صارمين",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5294,
      "number": 23,
      "text_uthmani": "فَٱنطَلَقُواْ وَهُمۡ يَتَخَٰفَتُونَ ٢٣",
      "text_simple": "فانطلقوا وهم يتخافتون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5295,
      "number": 24,
      "text_uthmani": "أَن لَّا يَدۡخُلَنَّهَا ٱلۡيَوۡمَ عَلَيۡكُم مِّسۡكِينٞ ٢٤",
      "text_simple": "أن لا يدخلنها اليوم عليكم مسكين",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5296,
      "number": 25,
      "text_uthmani": "وَغَدَوۡاْ عَلَىٰ حَرۡدٖ قَٰدِرِينَ ٢٥",
      "text_simple": "وغدوا على حرد قادرين",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5297,
      "number": 26,
      "text_uthmani": "فَلَمَّا رَأَوۡهَا قَالُوٓاْ إِنَّا لَضَآلُّونَ ٢٦",
      "text_simple": "فلما رأوها قالوا إنا لضالون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5298,
      "number": 27,
      "text_uthmani": "بَلۡ نَحۡنُ مَحۡرُومُونَ ٢٧",
      "text_simple": "بل نحن محرومون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5299,
      "number": 28,
      "text_uthmani": "قَالَ أَوۡسَطُهُمۡ أَلَمۡ أَقُل لَّكُمۡ لَوۡلَا تُسَبِّحُونَ ٢٨",
      "text_simple": "قال أوسطهم ألم أقل لكم لولا تسبحون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5300,
      "number": 29,
      "text_uthmani": "قَالُواْ سُبۡحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ ٢٩",
      "text_simple": "قالوا سبحان ربنا إنا كنا ظالمين",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5301,
      "number": 30,
      "text_uthmani": "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَلَٰوَمُونَ ٣٠",
      "text_simple": "فأقبل بعضهم على بعض يتلاومون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5302,
      "number": 31,
      "text_uthmani": "قَالُواْ يَٰوَيۡلَنَآ إِنَّا كُنَّا طَٰغِينَ ٣١",
      "text_simple": "قالوا ياويلنا إنا كنا طاغين",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5303,
      "number": 32,
      "text_uthmani": "عَسَىٰ رَبُّنَآ أَن يُبۡدِلَنَا خَيۡرٗا مِّنۡهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ ٣٢",
      "text_simple": "عسى ربنا أن يبدلنا خيرا منها إنا إلى ربنا راغبون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5304,
      "number": 33,
      "text_uthmani": "كَذَٰلِكَ ٱلۡعَذَابُۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَكۡبَرُۚ لَوۡ كَانُواْ يَعۡلَمُونَ ٣٣",
      "text_simple": "كذلك العذاب ولعذاب الآخرة أكبر لو كانوا يعلمون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5305,
      "number": 34,
      "text_uthmani": "إِنَّ لِلۡمُتَّقِينَ عِندَ رَبِّهِمۡ جَنَّٰتِ ٱلنَّعِيمِ ٣٤",
      "text_simple": "إن للمتقين عند ربهم جنات النعيم",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5306,
      "number": 35,
      "text_uthmani": "أَفَنَجۡعَلُ ٱلۡمُسۡلِمِينَ كَٱلۡمُجۡرِمِينَ ٣٥",
      "text_simple": "أفنجعل المسلمين كالمجرمين",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5307,
      "number": 36,
      "text_uthmani": "مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ ٣٦",
      "text_simple": "ما لكم كيف تحكمون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5308,
      "number": 37,
      "text_uthmani": "أَمۡ لَكُمۡ كِتَٰبٞ فِيهِ تَدۡرُسُونَ ٣٧",
      "text_simple": "أم لكم كتاب فيه تدرسون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5309,
      "number": 38,
      "text_uthmani": "إِنَّ لَكُمۡ فِيهِ لَمَا تَخَيَّرُونَ ٣٨",
      "text_simple": "إن لكم فيه لما تخيرون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5310,
      "number": 39,
      "text_uthmani": "أَمۡ لَكُمۡ أَيۡمَٰنٌ عَلَيۡنَا بَٰلِغَةٌ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ إِنَّ لَكُمۡ لَمَا تَحۡكُمُونَ ٣٩",
      "text_simple": "أم لكم أيمان علينا بالغة إلى يوم القيامة إن لكم لما تحكمون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5311,
      "number": 40,
      "text_uthmani": "سَلۡهُمۡ أَيُّهُم بِذَٰلِكَ زَعِيمٌ ٤٠",
      "text_simple": "سلهم أيهم بذلك زعيم",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5312,
      "number": 41,
      "text_uthmani": "أَمۡ لَهُمۡ شُرَكَآءُ فَلۡيَأۡتُواْ بِشُرَكَآئِهِمۡ إِن كَانُواْ صَٰدِقِينَ ٤١",
      "text_simple": "أم لهم شركاء فليأتوا بشركائهم إن كانوا صادقين",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5313,
      "number": 42,
      "text_uthmani": "يَوۡمَ يُكۡشَفُ عَن سَاقٖ وَيُدۡعَوۡنَ إِلَى ٱلسُّجُودِ فَلَا يَسۡتَطِيعُونَ ٤٢",
      "text_simple": "يوم يكشف عن ساق ويدعون إلى السجود فلا يستطيعون",
      "juz": 29,
      "page": 565,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5314,
      "number": 43,
      "text_uthmani": "خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۖ وَقَدۡ كَانُواْ يُدۡعَوۡنَ إِلَى ٱلسُّجُودِ وَهُمۡ سَٰلِمُونَ ٤٣",
      "text_simple": "خاشعة أبصارهم ترهقهم ذلة وقد كانوا يدعون إلى السجود وهم سالمون",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5315,
      "number": 44,
      "text_uthmani": "فَذَرۡنِي وَمَن يُكَذِّبُ بِهَٰذَا ٱلۡحَدِيثِۖ سَنَسۡتَدۡرِجُهُم مِّنۡ حَيۡثُ لَا يَعۡلَمُونَ ٤٤",
      "text_simple": "فذرني ومن يكذب بهذا الحديث سنستدرجهم من حيث لا يعلمون",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5316,
      "number": 45,
      "text_uthmani": "وَأُمۡلِي لَهُمۡۚ إِنَّ كَيۡدِي مَتِينٌ ٤٥",
      "text_simple": "وأملي لهم إن كيدي متين",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5317,
      "number": 46,
      "text_uthmani": "أَمۡ تَسۡـَٔلُهُمۡ أَجۡرٗا فَهُم مِّن مَّغۡرَمٖ مُّثۡقَلُونَ ٤٦",
      "text_simple": "أم تسألهم أجرا فهم من مغرم مثقلون",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5318,
      "number": 47,
      "text_uthmani": "أَمۡ عِندَهُمُ ٱلۡغَيۡبُ فَهُمۡ يَكۡتُبُونَ ٤٧",
      "text_simple": "أم عندهم الغيب فهم يكتبون",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5319,
      "number": 48,
      "text_uthmani": "فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلۡحُوتِ إِذۡ نَادَىٰ وَهُوَ مَكۡظُومٞ ٤٨",
      "text_simple": "فاصبر لحكم ربك ولا تكن كصاحب الحوت إذ نادى وهو مكظوم",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5320,
      "number": 49,
      "text_uthmani": "لَّوۡلَآ أَن تَدَٰرَكَهُۥ نِعۡمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلۡعَرَآءِ وَهُوَ مَذۡمُومٞ ٤٩",
      "text_simple": "لولا أن تداركه نعمة من ربه لنبذ بالعراء وهو مذموم",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5321,
      "number": 50,
      "text_uthmani": "فَٱجۡتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ ٥٠",
      "text_simple": "فاجتباه ربه فجعله من الصالحين",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5322,
      "number": 51,
      "text_uthmani": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُواْ لَيُزۡلِقُونَكَ بِأَبۡصَٰرِهِمۡ لَمَّا سَمِعُواْ ٱلذِّكۡرَ وَيَقُولُونَ إِنَّهُۥ لَمَجۡنُونٞ ٥١",
      "text_simple": "وإن يكاد الذين كفروا ليزلقونك بأبصارهم لما سمعوا الذكر ويقولون إنه لمجنون",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5323,
      "number": 52,
      "text_uthmani": "وَمَا هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ ٥٢",
      "text_simple": "وما هو إلا ذكر للعالمين",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    }
  ]
}