{
  "number": 75,
  "name_ar": "القِيَامة",
  "name_en": "Al-Qiyāmah",
  "ayahs_count": 40,
  "page_start": 577,
  "page_end": 578,
  "ayahs": [
    {
      "id": 5552,
      "number": 1,
      "text_uthmani": "لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ ١",
      "text_simple": "لا أقسم بيوم القيامة",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5553,
      "number": 2,
      "text_uthmani": "وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ ٢",
      "text_simple": "ولا أقسم بالنفس اللوامة",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5554,
      "number": 3,
      "text_uthmani": "أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ ٣",
      "text_simple": "أيحسب الإنسان ألن نجمع عظامه",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5555,
      "number": 4,
      "text_uthmani": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ ٤",
      "text_simple": "بلى قادرين على أن نسوي بنانه",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5556,
      "number": 5,
      "text_uthmani": "بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ ٥",
      "text_simple": "بل يريد الإنسان ليفجر أمامه",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5557,
      "number": 6,
      "text_uthmani": "يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ ٦",
      "text_simple": "يسأل أيان يوم القيامة",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5558,
      "number": 7,
      "text_uthmani": "فَإِذَا بَرِقَ ٱلۡبَصَرُ ٧",
      "text_simple": "فإذا برق البصر",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5559,
      "number": 8,
      "text_uthmani": "وَخَسَفَ ٱلۡقَمَرُ ٨",
      "text_simple": "وخسف القمر",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5560,
      "number": 9,
      "text_uthmani": "وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ ٩",
      "text_simple": "وجمع الشمس والقمر",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5561,
      "number": 10,
      "text_uthmani": "يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ ١٠",
      "text_simple": "يقول الإنسان يومئذ أين المفر",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5562,
      "number": 11,
      "text_uthmani": "كـَلَّا لَا وَزَرَ ١١",
      "text_simple": "كلا لا وزر",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5563,
      "number": 12,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ ١٢",
      "text_simple": "إلى ربك يومئذ المستقر",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5564,
      "number": 13,
      "text_uthmani": "يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ ١٣",
      "text_simple": "ينبأ الإنسان يومئذ بما قدم وأخر",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5565,
      "number": 14,
      "text_uthmani": "بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ ١٤",
      "text_simple": "بل الإنسان على نفسه بصيرة",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5566,
      "number": 15,
      "text_uthmani": "وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ ١٥",
      "text_simple": "ولو ألقى معاذيره",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5567,
      "number": 16,
      "text_uthmani": "لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ ١٦",
      "text_simple": "لا تحرك به لسانك لتعجل به",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5568,
      "number": 17,
      "text_uthmani": "إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ ١٧",
      "text_simple": "إن علينا جمعه وقرآنه",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5569,
      "number": 18,
      "text_uthmani": "فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ ١٨",
      "text_simple": "فإذا قرأناه فاتبع قرآنه",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5570,
      "number": 19,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ ١٩",
      "text_simple": "ثم إن علينا بيانه",
      "juz": 29,
      "page": 577,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5571,
      "number": 20,
      "text_uthmani": "كـَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ ٢٠",
      "text_simple": "كلا بل تحبون العاجلة",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5572,
      "number": 21,
      "text_uthmani": "وَتَذَرُونَ ٱلۡأٓخِرَةَ ٢١",
      "text_simple": "وتذرون الآخرة",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5573,
      "number": 22,
      "text_uthmani": "وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ ٢٢",
      "text_simple": "وجوه يومئذ ناضرة",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5574,
      "number": 23,
      "text_uthmani": "إِلَىٰ رَبِّهَا نَاظِرَةٞ ٢٣",
      "text_simple": "إلى ربها ناظرة",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5575,
      "number": 24,
      "text_uthmani": "وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ ٢٤",
      "text_simple": "ووجوه يومئذ باسرة",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5576,
      "number": 25,
      "text_uthmani": "تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ ٢٥",
      "text_simple": "تظن أن يفعل بها فاقرة",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5577,
      "number": 26,
      "text_uthmani": "كـَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ ٢٦",
      "text_simple": "كلا إذا بلغت التراقي",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5578,
      "number": 27,
      "text_uthmani": "وَقِيلَ مَنۡۜ رَاقٖ ٢٧",
      "text_simple": "وقيل من راق",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5579,
      "number": 28,
      "text_uthmani": "وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ ٢٨",
      "text_simple": "وظن أنه الفراق",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5580,
      "number": 29,
      "text_uthmani": "وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ ٢٩",
      "text_simple": "والتفت الساق بالساق",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5581,
      "number": 30,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ ٣٠",
      "text_simple": "إلى ربك يومئذ المساق",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5582,
      "number": 31,
      "text_uthmani": "فَلَا صَدَّقَ وَلَا صَلَّىٰ ٣١",
      "text_simple": "فلا صدق ولا صلى",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5583,
      "number": 32,
      "text_uthmani": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ ٣٢",
      "text_simple": "ولكن كذب وتولى",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5584,
      "number": 33,
      "text_uthmani": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ ٣٣",
      "text_simple": "ثم ذهب إلى أهله يتمطى",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5585,
      "number": 34,
      "text_uthmani": "أَوۡلَىٰ لَكَ فَأَوۡلَىٰ ٣٤",
      "text_simple": "أولى لك فأولى",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5586,
      "number": 35,
      "text_uthmani": "ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ ٣٥",
      "text_simple": "ثم أولى لك فأولى",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5587,
      "number": 36,
      "text_uthmani": "أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى ٣٦",
      "text_simple": "أيحسب الإنسان أن يترك سدى",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5588,
      "number": 37,
      "text_uthmani": "أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ ٣٧",
      "text_simple": "ألم يك نطفة من مني يمنى",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5589,
      "number": 38,
      "text_uthmani": "ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ ٣٨",
      "text_simple": "ثم كان علقة فخلق فسوى",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5590,
      "number": 39,
      "text_uthmani": "فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ ٣٩",
      "text_simple": "فجعل منه الزوجين الذكر والأنثى",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5591,
      "number": 40,
      "text_uthmani": "أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ ٤٠",
      "text_simple": "أليس ذلك بقادر على أن يحيي الموتى",
      "juz": 29,
      "page": 578,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    }
  ]
}