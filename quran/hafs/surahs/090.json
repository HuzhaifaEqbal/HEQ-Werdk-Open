{
  "number": 90,
  "name_ar": "البَلَد",
  "name_en": "Al-Balad",
  "ayahs_count": 20,
  "page_start": 594,
  "page_end": 595,
  "ayahs": [
    {
      "id": 6024,
      "number": 1,
      "text_uthmani": "لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ ١",
      "text_simple": "لا أقسم بهذا البلد",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6025,
      "number": 2,
      "text_uthmani": "وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ ٢",
      "text_simple": "وأنت حل بهذا البلد",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6026,
      "number": 3,
      "text_uthmani": "وَوَالِدٖ وَمَا وَلَدَ ٣",
      "text_simple": "ووالد وما ولد",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6027,
      "number": 4,
      "text_uthmani": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ ٤",
      "text_simple": "لقد خلقنا الإنسان في كبد",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6028,
      "number": 5,
      "text_uthmani": "أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ ٥",
      "text_simple": "أيحسب أن لن يقدر عليه أحد",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 6029,
      "number": 6,
      "text_uthmani": "يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا ٦",
      "text_simple": "يقول أهلكت مالا لبدا",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6030,
      "number": 7,
      "text_uthmani": "أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ ٧",
      "text_simple": "أيحسب أن لم يره أحد",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6031,
      "number": 8,
      "text_uthmani": "أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ ٨",
      "text_simple": "ألم نجعل له عينين",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 6032,
      "number": 9,
      "text_uthmani": "وَلِسَانٗا وَشَفَتَيۡنِ ٩",
      "text_simple": "ولسانا وشفتين",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 6033,
      "number": 10,
      "text_uthmani": "وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ ١٠",
      "text_simple": "وهديناه النجدين",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 6034,
      "number": 11,
      "text_uthmani": "فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ ١١",
      "text_simple": "فلا اقتحم العقبة",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 6035,
      "number": 12,
      "text_uthmani": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ ١٢",
      "text_simple": "وما أدراك ما العقبة",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 6036,
      "number": 13,
      "text_uthmani": "فَكُّ رَقَبَةٍ ١٣",
      "text_simple": "فك رقبة",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 6037,
      "number": 14,
      "text_uthmani": "أَوۡ إِطۡعَٰمٞ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ ١٤",
      "text_simple": "أو إطعام في يوم ذي مسغبة",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 6038,
      "number": 15,
      "text_uthmani": "يَتِيمٗا ذَا مَقۡرَبَةٍ ١٥",
      "text_simple": "يتيما ذا مقربة",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 6039,
      "number": 16,
      "text_uthmani": "أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ ١٦",
      "text_simple": "أو مسكينا ذا متربة",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 6040,
      "number": 17,
      "text_uthmani": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ ١٧",
      "text_simple": "ثم كان من الذين آمنوا وتواصوا بالصبر وتواصوا بالمرحمة",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 6041,
      "number": 18,
      "text_uthmani": "أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ١٨",
      "text_simple": "أولئك أصحاب الميمنة",
      "juz": 30,
      "page": 594,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6042,
      "number": 19,
      "text_uthmani": "وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ١٩",
      "text_simple": "والذين كفروا بآياتنا هم أصحاب المشأمة",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 6043,
      "number": 20,
      "text_uthmani": "عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ ٢٠",
      "text_simple": "عليهم نار مؤصدة",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    }
  ]
}