{
  "number": 82,
  "name_ar": "الانفِطَار",
  "name_en": "Al-Infiṭār",
  "ayahs_count": 19,
  "page_start": 587,
  "page_end": 587,
  "ayahs": [
    {
      "id": 5830,
      "number": 1,
      "text_uthmani": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ ١",
      "text_simple": "إذا السماء انفطرت",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5831,
      "number": 2,
      "text_uthmani": "وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ ٢",
      "text_simple": "وإذا الكواكب انتثرت",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5832,
      "number": 3,
      "text_uthmani": "وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ ٣",
      "text_simple": "وإذا البحار فجرت",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5833,
      "number": 4,
      "text_uthmani": "وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ ٤",
      "text_simple": "وإذا القبور بعثرت",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5834,
      "number": 5,
      "text_uthmani": "عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ ٥",
      "text_simple": "علمت نفس ما قدمت وأخرت",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5835,
      "number": 6,
      "text_uthmani": "يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ ٦",
      "text_simple": "ياأيها الإنسان ما غرك بربك الكريم",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5836,
      "number": 7,
      "text_uthmani": "ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ ٧",
      "text_simple": "الذي خلقك فسواك فعدلك",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5837,
      "number": 8,
      "text_uthmani": "فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ ٨",
      "text_simple": "في أي صورة ما شاء ركبك",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5838,
      "number": 9,
      "text_uthmani": "كـَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ ٩",
      "text_simple": "كلا بل تكذبون بالدين",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5839,
      "number": 10,
      "text_uthmani": "وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ ١٠",
      "text_simple": "وإن عليكم لحافظين",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5840,
      "number": 11,
      "text_uthmani": "كِرَامٗا كَٰتِبِينَ ١١",
      "text_simple": "كراما كاتبين",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5841,
      "number": 12,
      "text_uthmani": "يَعۡلَمُونَ مَا تَفۡعَلُونَ ١٢",
      "text_simple": "يعلمون ما تفعلون",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5842,
      "number": 13,
      "text_uthmani": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ ١٣",
      "text_simple": "إن الأبرار لفي نعيم",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5843,
      "number": 14,
      "text_uthmani": "وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ ١٤",
      "text_simple": "وإن الفجار لفي جحيم",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5844,
      "number": 15,
      "text_uthmani": "يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ ١٥",
      "text_simple": "يصلونها يوم الدين",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5845,
      "number": 16,
      "text_uthmani": "وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ ١٦",
      "text_simple": "وما هم عنها بغائبين",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5846,
      "number": 17,
      "text_uthmani": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ١٧",
      "text_simple": "وما أدراك ما يوم الدين",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5847,
      "number": 18,
      "text_uthmani": "ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ١٨",
      "text_simple": "ثم ما أدراك ما يوم الدين",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5848,
      "number": 19,
      "text_uthmani": "يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ ١٩",
      "text_simple": "يوم لا تملك نفس لنفس شيئا والأمر يومئذ لله",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    }
  ]
}