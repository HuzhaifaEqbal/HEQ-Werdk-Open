{
  "number": 69,
  "name_ar": "الحَاقة",
  "name_en": "Al-Ḥāqqah",
  "ayahs_count": 52,
  "page_start": 566,
  "page_end": 568,
  "ayahs": [
    {
      "id": 5324,
      "number": 1,
      "text_uthmani": "ٱلۡحَآقَّةُ ١",
      "text_simple": "الحاقة",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5325,
      "number": 2,
      "text_uthmani": "مَا ٱلۡحَآقَّةُ ٢",
      "text_simple": "ما الحاقة",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5326,
      "number": 3,
      "text_uthmani": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحَآقَّةُ ٣",
      "text_simple": "وما أدراك ما الحاقة",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5327,
      "number": 4,
      "text_uthmani": "كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ ٤",
      "text_simple": "كذبت ثمود وعاد بالقارعة",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5328,
      "number": 5,
      "text_uthmani": "فَأَمَّا ثَمُودُ فَأُهۡلِكُواْ بِٱلطَّاغِيَةِ ٥",
      "text_simple": "فأما ثمود فأهلكوا بالطاغية",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5329,
      "number": 6,
      "text_uthmani": "وَأَمَّا عَادٞ فَأُهۡلِكُواْ بِرِيحٖ صَرۡصَرٍ عَاتِيَةٖ ٦",
      "text_simple": "وأما عاد فأهلكوا بريح صرصر عاتية",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5330,
      "number": 7,
      "text_uthmani": "سَخَّرَهَا عَلَيۡهِمۡ سَبۡعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومٗاۖ فَتَرَى ٱلۡقَوۡمَ فِيهَا صَرۡعَىٰ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٍ خَاوِيَةٖ ٧",
      "text_simple": "سخرها عليهم سبع ليال وثمانية أيام حسوما فترى القوم فيها صرعى كأنهم أعجاز نخل خاوية",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5331,
      "number": 8,
      "text_uthmani": "فَهَلۡ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٖ ٨",
      "text_simple": "فهل ترى لهم من باقية",
      "juz": 29,
      "page": 566,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5332,
      "number": 9,
      "text_uthmani": "وَجَآءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَٰتُ بِٱلۡخَاطِئَةِ ٩",
      "text_simple": "وجاء فرعون ومن قبله والمؤتفكات بالخاطئة",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5333,
      "number": 10,
      "text_uthmani": "فَعَصَوۡاْ رَسُولَ رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةٗ رَّابِيَةً ١٠",
      "text_simple": "فعصوا رسول ربهم فأخذهم أخذة رابية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5334,
      "number": 11,
      "text_uthmani": "إِنَّا لَمَّا طَغَا ٱلۡمَآءُ حَمَلۡنَٰكُمۡ فِي ٱلۡجَارِيَةِ ١١",
      "text_simple": "إنا لما طغى الماء حملناكم في الجارية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5335,
      "number": 12,
      "text_uthmani": "لِنَجۡعَلَهَا لَكُمۡ تَذۡكِرَةٗ وَتَعِيَهَآ أُذُنٞ وَٰعِيَةٞ ١٢",
      "text_simple": "لنجعلها لكم تذكرة وتعيها أذن واعية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5336,
      "number": 13,
      "text_uthmani": "فَإِذَا نُفِخَ فِي ٱلصُّورِ نَفۡخَةٞ وَٰحِدَةٞ ١٣",
      "text_simple": "فإذا نفخ في الصور نفخة واحدة",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5337,
      "number": 14,
      "text_uthmani": "وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ ١٤",
      "text_simple": "وحملت الأرض والجبال فدكتا دكة واحدة",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5338,
      "number": 15,
      "text_uthmani": "فَيَوۡمَئِذٖ وَقَعَتِ ٱلۡوَاقِعَةُ ١٥",
      "text_simple": "فيومئذ وقعت الواقعة",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5339,
      "number": 16,
      "text_uthmani": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِيَ يَوۡمَئِذٖ وَاهِيَةٞ ١٦",
      "text_simple": "وانشقت السماء فهي يومئذ واهية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5340,
      "number": 17,
      "text_uthmani": "وَٱلۡمَلَكُ عَلَىٰٓ أَرۡجَآئِهَاۚ وَيَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ يَوۡمَئِذٖ ثَمَٰنِيَةٞ ١٧",
      "text_simple": "والملك على أرجائها ويحمل عرش ربك فوقهم يومئذ ثمانية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5341,
      "number": 18,
      "text_uthmani": "يَوۡمَئِذٖ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمۡ خَافِيَةٞ ١٨",
      "text_simple": "يومئذ تعرضون لا تخفى منكم خافية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5342,
      "number": 19,
      "text_uthmani": "فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقۡرَءُواْ كِتَٰبِيَهۡ ١٩",
      "text_simple": "فأما من أوتي كتابه بيمينه فيقول هاؤم اقرءوا كتابيه",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5343,
      "number": 20,
      "text_uthmani": "إِنِّي ظَنَنتُ أَنِّي مُلَٰقٍ حِسَابِيَهۡ ٢٠",
      "text_simple": "إني ظننت أني ملاق حسابيه",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5344,
      "number": 21,
      "text_uthmani": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ ٢١",
      "text_simple": "فهو في عيشة راضية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5345,
      "number": 22,
      "text_uthmani": "فِي جَنَّةٍ عَالِيَةٖ ٢٢",
      "text_simple": "في جنة عالية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5346,
      "number": 23,
      "text_uthmani": "قُطُوفُهَا دَانِيَةٞ ٢٣",
      "text_simple": "قطوفها دانية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5347,
      "number": 24,
      "text_uthmani": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَآ أَسۡلَفۡتُمۡ فِي ٱلۡأَيَّامِ ٱلۡخَالِيَةِ ٢٤",
      "text_simple": "كلوا واشربوا هنيئا بما أسلفتم في الأيام الخالية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5348,
      "number": 25,
      "text_uthmani": "وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيۡتَنِي لَمۡ أُوتَ كِتَٰبِيَهۡ ٢٥",
      "text_simple": "وأما من أوتي كتابه بشماله فيقول ياليتني لم أوت كتابيه",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5349,
      "number": 26,
      "text_uthmani": "وَلَمۡ أَدۡرِ مَا حِسَابِيَهۡ ٢٦",
      "text_simple": "ولم أدر ما حسابيه",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5350,
      "number": 27,
      "text_uthmani": "يَٰلَيۡتَهَا كَانَتِ ٱلۡقَاضِيَةَ ٢٧",
      "text_simple": "ياليتها كانت القاضية",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5351,
      "number": 28,
      "text_uthmani": "مَآ أَغۡنَىٰ عَنِّي مَالِيَهۡۜ ٢٨",
      "text_simple": "ما أغنى عني ماليه",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5352,
      "number": 29,
      "text_uthmani": "هَلَكَ عَنِّي سُلۡطَٰنِيَهۡ ٢٩",
      "text_simple": "هلك عني سلطانيه",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5353,
      "number": 30,
      "text_uthmani": "خُذُوهُ فَغُلُّوهُ ٣٠",
      "text_simple": "خذوه فغلوه",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5354,
      "number": 31,
      "text_uthmani": "ثُمَّ ٱلۡجَحِيمَ صَلُّوهُ ٣١",
      "text_simple": "ثم الجحيم صلوه",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5355,
      "number": 32,
      "text_uthmani": "ثُمَّ فِي سِلۡسِلَةٖ ذَرۡعُهَا سَبۡعُونَ ذِرَاعٗا فَٱسۡلُكُوهُ ٣٢",
      "text_simple": "ثم في سلسلة ذرعها سبعون ذراعا فاسلكوه",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5356,
      "number": 33,
      "text_uthmani": "إِنَّهُۥ كَانَ لَا يُؤۡمِنُ بِٱللَّهِ ٱلۡعَظِيمِ ٣٣",
      "text_simple": "إنه كان لا يؤمن بالله العظيم",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5357,
      "number": 34,
      "text_uthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ٣٤",
      "text_simple": "ولا يحض على طعام المسكين",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5358,
      "number": 35,
      "text_uthmani": "فَلَيۡسَ لَهُ ٱلۡيَوۡمَ هَٰهُنَا حَمِيمٞ ٣٥",
      "text_simple": "فليس له اليوم هاهنا حميم",
      "juz": 29,
      "page": 567,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5359,
      "number": 36,
      "text_uthmani": "وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِينٖ ٣٦",
      "text_simple": "ولا طعام إلا من غسلين",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5360,
      "number": 37,
      "text_uthmani": "لَّا يَأۡكُلُهُۥٓ إِلَّا ٱلۡخَٰطِـُٔونَ ٣٧",
      "text_simple": "لا يأكله إلا الخاطئون",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5361,
      "number": 38,
      "text_uthmani": "فَلَآ أُقۡسِمُ بِمَا تُبۡصِرُونَ ٣٨",
      "text_simple": "فلا أقسم بما تبصرون",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5362,
      "number": 39,
      "text_uthmani": "وَمَا لَا تُبۡصِرُونَ ٣٩",
      "text_simple": "وما لا تبصرون",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5363,
      "number": 40,
      "text_uthmani": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ٤٠",
      "text_simple": "إنه لقول رسول كريم",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5364,
      "number": 41,
      "text_uthmani": "وَمَا هُوَ بِقَوۡلِ شَاعِرٖۚ قَلِيلٗا مَّا تُؤۡمِنُونَ ٤١",
      "text_simple": "وما هو بقول شاعر قليلا ما تؤمنون",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5365,
      "number": 42,
      "text_uthmani": "وَلَا بِقَوۡلِ كَاهِنٖۚ قَلِيلٗا مَّا تَذَكَّرُونَ ٤٢",
      "text_simple": "ولا بقول كاهن قليلا ما تذكرون",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5366,
      "number": 43,
      "text_uthmani": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ٤٣",
      "text_simple": "تنزيل من رب العالمين",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5367,
      "number": 44,
      "text_uthmani": "وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ ٤٤",
      "text_simple": "ولو تقول علينا بعض الأقاويل",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5368,
      "number": 45,
      "text_uthmani": "لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ ٤٥",
      "text_simple": "لأخذنا منه باليمين",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5369,
      "number": 46,
      "text_uthmani": "ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِينَ ٤٦",
      "text_simple": "ثم لقطعنا منه الوتين",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5370,
      "number": 47,
      "text_uthmani": "فَمَا مِنكُم مِّنۡ أَحَدٍ عَنۡهُ حَٰجِزِينَ ٤٧",
      "text_simple": "فما منكم من أحد عنه حاجزين",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5371,
      "number": 48,
      "text_uthmani": "وَإِنَّهُۥ لَتَذۡكِرَةٞ لِّلۡمُتَّقِينَ ٤٨",
      "text_simple": "وإنه لتذكرة للمتقين",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5372,
      "number": 49,
      "text_uthmani": "وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ ٤٩",
      "text_simple": "وإنا لنعلم أن منكم مكذبين",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5373,
      "number": 50,
      "text_uthmani": "وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَٰفِرِينَ ٥٠",
      "text_simple": "وإنه لحسرة على الكافرين",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5374,
      "number": 51,
      "text_uthmani": "وَإِنَّهُۥ لَحَقُّ ٱلۡيَقِينِ ٥١",
      "text_simple": "وإنه لحق اليقين",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5375,
      "number": 52,
      "text_uthmani": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٥٢",
      "text_simple": "فسبح باسم ربك العظيم",
      "juz": 29,
      "page": 568,
      "page_end": null,
