{
  "number": 55,
  "name_ar": "الرَّحمٰن",
  "name_en": "Ar-Raḥmān",
  "ayahs_count": 78,
  "page_start": 531,
  "page_end": 534,
  "ayahs": [
    {
      "id": 4902,
      "number": 1,
      "text_uthmani": "ٱلرَّحۡمَٰنُ ١",
      "text_simple": "الرحمن",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4903,
      "number": 2,
      "text_uthmani": "عَلَّمَ ٱلۡقُرۡءَانَ ٢",
      "text_simple": "علم القرآن",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4904,
      "number": 3,
      "text_uthmani": "خَلَقَ ٱلۡإِنسَٰنَ ٣",
      "text_simple": "خلق الإنسان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4905,
      "number": 4,
      "text_uthmani": "عَلَّمَهُ ٱلۡبَيَانَ ٤",
      "text_simple": "علمه البيان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4906,
      "number": 5,
      "text_uthmani": "ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ ٥",
      "text_simple": "الشمس والقمر بحسبان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 4907,
      "number": 6,
      "text_uthmani": "وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ ٦",
      "text_simple": "والنجم والشجر يسجدان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 4908,
      "number": 7,
      "text_uthmani": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ ٧",
      "text_simple": "والسماء رفعها ووضع الميزان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4909,
      "number": 8,
      "text_uthmani": "أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ ٨",
      "text_simple": "ألا تطغوا في الميزان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4910,
      "number": 9,
      "text_uthmani": "وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ ٩",
      "text_simple": "وأقيموا الوزن بالقسط ولا تخسروا الميزان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4911,
      "number": 10,
      "text_uthmani": "وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ ١٠",
      "text_simple": "والأرض وضعها للأنام",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 4912,
      "number": 11,
      "text_uthmani": "فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ ١١",
      "text_simple": "فيها فاكهة والنخل ذات الأكمام",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 4913,
      "number": 12,
      "text_uthmani": "وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ ١٢",
      "text_simple": "والحب ذو العصف والريحان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 4914,
      "number": 13,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٣",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 4915,
      "number": 14,
      "text_uthmani": "خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ ١٤",
      "text_simple": "خلق الإنسان من صلصال كالفخار",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 4916,
      "number": 15,
      "text_uthmani": "وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ ١٥",
      "text_simple": "وخلق الجان من مارج من نار",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 4917,
      "number": 16,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٦",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4918,
      "number": 17,
      "text_uthmani": "رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ ١٧",
      "text_simple": "رب المشرقين ورب المغربين",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 4919,
      "number": 18,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٨",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 531,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 4920,
      "number": 19,
      "text_uthmani": "مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ ١٩",
      "text_simple": "مرج البحرين يلتقيان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4921,
      "number": 20,
      "text_uthmani": "بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ ٢٠",
      "text_simple": "بينهما برزخ لا يبغيان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4922,
      "number": 21,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢١",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 4923,
      "number": 22,
      "text_uthmani": "يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ ٢٢",
      "text_simple": "يخرج منهما اللؤلؤ والمرجان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 4924,
      "number": 23,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢٣",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 4925,
      "number": 24,
      "text_uthmani": "وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ ٢٤",
      "text_simple": "وله الجوار المنشآت في البحر كالأعلام",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 4926,
      "number": 25,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢٥",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 4927,
      "number": 26,
      "text_uthmani": "كُلُّ مَنۡ عَلَيۡهَا فَانٖ ٢٦",
      "text_simple": "كل من عليها فان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 4928,
      "number": 27,
      "text_uthmani": "وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ ٢٧",
      "text_simple": "ويبقى وجه ربك ذو الجلال والإكرام",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 4929,
      "number": 28,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢٨",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 4930,
      "number": 29,
      "text_uthmani": "يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ ٢٩",
      "text_simple": "يسأله من في السموات والأرض كل يوم هو في شأن",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 4931,
      "number": 30,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٠",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 4932,
      "number": 31,
      "text_uthmani": "سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ ٣١",
      "text_simple": "سنفرغ لكم أيها الثقلان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 4933,
      "number": 32,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٢",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 4934,
      "number": 33,
      "text_uthmani": "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ ٣٣",
      "text_simple": "يامعشر الجن والإنس إن استطعتم أن تنفذوا من أقطار السموات والأرض فانفذوا لا تنفذون إلا بسلطان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 8,
      "line_end": 10
    },
    {
      "id": 4935,
      "number": 34,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٤",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4936,
      "number": 35,
      "text_uthmani": "يُرۡسَلُ عَلَيۡكُمَا شُوَاظٞ مِّن نَّارٖ وَنُحَاسٞ فَلَا تَنتَصِرَانِ ٣٥",
      "text_simple": "يرسل عليكما شواظ من نار ونحاس فلا تنتصران",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 4937,
      "number": 36,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٦",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 4938,
      "number": 37,
      "text_uthmani": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَٱلدِّهَانِ ٣٧",
      "text_simple": "فإذا انشقت السماء فكانت وردة كالدهان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 4939,
      "number": 38,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٨",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 4940,
      "number": 39,
      "text_uthmani": "فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞ ٣٩",
      "text_simple": "فيومئذ لا يسأل عن ذنبه إنس ولا جان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 4941,
      "number": 40,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٤٠",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4942,
      "number": 41,
      "text_uthmani": "يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ ٤١",
      "text_simple": "يعرف المجرمون بسيماهم فيؤخذ بالنواصي والأقدام",
      "juz": 27,
      "page": 532,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 4943,
      "number": 42,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٤٢",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 533,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4944,
      "number": 43,
      "text_uthmani": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ ٤٣",
      "text_simple": "هذه جهنم التي يكذب بها المجرمون",
      "juz": 27,
      "page": 533,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 4945,
      "number": 44,
      "text_uthmani": "يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ ٤٤",
      "text_simple": "يطوفون بينها وبين حميم آن",
      "juz": 27,
      "page": 533,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 4946,
      "number": 45,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٤٥",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 533,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 4947,
      "number": 46,
      "text_uthmani": "وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ ٤٦",
      "text_simple": "ولمن خاف مقام ربه جنتان",
      "juz": 27,
      "page": 533,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 4948,
      "number": 47,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٤٧",
      "text_simple": "فبأي آلاء ربكما تكذبان",
      "juz": 27,
      "page": 533,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 4949,
