  "ayahs": [
    {
      "id": 6139,
      "number": 1,
      "text_uthmani": "إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا ١",
      "text_simple": "إذا زلزلت الأرض زلزالها",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6140,
      "number": 2,
      "text_uthmani": "وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا ٢",
      "text_simple": "وأخرجت الأرض أثقالها",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6141,
      "number": 3,
      "text_uthmani": "وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا ٣",
      "text_simple": "وقال الإنسان ما لها",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 6142,
      "number": 4,
      "text_uthmani": "يَوۡمَئِذٖ تُحَدِّثُ أَخۡبَارَهَا ٤",
      "text_simple": "يومئذ تحدث أخبارها",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6143,
      "number": 5,
      "text_uthmani": "بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا ٥",
      "text_simple": "بأن ربك أوحى لها",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6144,
      "number": 6,
      "text_uthmani": "يَوۡمَئِذٖ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتٗا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ ٦",
      "text_simple": "يومئذ يصدر الناس أشتاتا ليروا أعمالهم",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6145,
      "number": 7,
      "text_uthmani": "فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرٗا يَرَهُۥ ٧",
      "text_simple": "فمن يعمل مثقال ذرة خيرا يره",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 6146,
      "number": 8,
      "text_uthmani": "وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٖ شَرّٗا يَرَهُۥ ٨",
      "text_simple": "ومن يعمل مثقال ذرة شرا يره",
      "juz": 30,
      "page": 599,
