{
  "number": 80,
  "name_ar": "عَبَسَ",
  "name_en": "‘Abasa",
  "ayahs_count": 42,
  "page_start": 585,
  "page_end": 586,
  "ayahs": [
    {
      "id": 5759,
      "number": 1,
      "text_uthmani": "عَبَسَ وَتَوَلَّىٰٓ ١",
      "text_simple": "عبس وتولى",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5760,
      "number": 2,
      "text_uthmani": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ ٢",
      "text_simple": "أن جاءه الأعمى",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5761,
      "number": 3,
      "text_uthmani": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ ٣",
      "text_simple": "وما يدريك لعله يزكى",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5762,
      "number": 4,
      "text_uthmani": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ ٤",
      "text_simple": "أو يذكر فتنفعه الذكرى",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5763,
      "number": 5,
      "text_uthmani": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ ٥",
      "text_simple": "أما من استغنى",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5764,
      "number": 6,
      "text_uthmani": "فَأَنتَ لَهُۥ تَصَدَّىٰ ٦",
      "text_simple": "فأنت له تصدى",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5765,
      "number": 7,
      "text_uthmani": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ ٧",
      "text_simple": "وما عليك ألا يزكى",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5766,
      "number": 8,
      "text_uthmani": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ ٨",
      "text_simple": "وأما من جاءك يسعى",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5767,
      "number": 9,
      "text_uthmani": "وَهُوَ يَخۡشَىٰ ٩",
      "text_simple": "وهو يخشى",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5768,
      "number": 10,
      "text_uthmani": "فَأَنتَ عَنۡهُ تَلَهَّىٰ ١٠",
      "text_simple": "فأنت عنه تلهى",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5769,
      "number": 11,
      "text_uthmani": "كـَلَّآ إِنَّهَا تَذۡكِرَةٞ ١١",
      "text_simple": "كلا إنها تذكرة",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5770,
      "number": 12,
      "text_uthmani": "فَمَن شَآءَ ذَكَرَهُۥ ١٢",
      "text_simple": "فمن شاء ذكره",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5771,
      "number": 13,
      "text_uthmani": "فِي صُحُفٖ مُّكَرَّمَةٖ ١٣",
      "text_simple": "في صحف مكرمة",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5772,
      "number": 14,
      "text_uthmani": "مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ ١٤",
      "text_simple": "مرفوعة مطهرة",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5773,
      "number": 15,
      "text_uthmani": "بِأَيۡدِي سَفَرَةٖ ١٥",
      "text_simple": "بأيدي سفرة",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5774,
      "number": 16,
      "text_uthmani": "كِرَامِۭ بَرَرَةٖ ١٦",
      "text_simple": "كرام بررة",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5775,
      "number": 17,
      "text_uthmani": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ ١٧",
      "text_simple": "قتل الإنسان ما أكفره",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5776,
      "number": 18,
      "text_uthmani": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ ١٨",
      "text_simple": "من أي شيء خلقه",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5777,
      "number": 19,
      "text_uthmani": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩",
      "text_simple": "من نطفة خلقه فقدره",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5778,
      "number": 20,
      "text_uthmani": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ٢٠",
      "text_simple": "ثم السبيل يسره",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5779,
      "number": 21,
      "text_uthmani": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ ٢١",
      "text_simple": "ثم أماته فأقبره",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5780,
      "number": 22,
      "text_uthmani": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ ٢٢",
      "text_simple": "ثم إذا شاء أنشره",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5781,
      "number": 23,
      "text_uthmani": "كـَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ ٢٣",
      "text_simple": "كلا لما يقض ما أمره",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5782,
      "number": 24,
      "text_uthmani": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ٢٤",
      "text_simple": "فلينظر الإنسان إلى طعامه",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5783,
      "number": 25,
      "text_uthmani": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا ٢٥",
      "text_simple": "أنا صببنا الماء صبا",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5784,
      "number": 26,
      "text_uthmani": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا ٢٦",
      "text_simple": "ثم شققنا الأرض شقا",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5785,
      "number": 27,
      "text_uthmani": "فَأَنۢبَتۡنَا فِيهَا حَبّٗا ٢٧",
      "text_simple": "فأنبتنا فيها حبا",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5786,
      "number": 28,
      "text_uthmani": "وَعِنَبٗا وَقَضۡبٗا ٢٨",
      "text_simple": "وعنبا وقضبا",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5787,
      "number": 29,
      "text_uthmani": "وَزَيۡتُونٗا وَنَخۡلٗا ٢٩",
      "text_simple": "وزيتونا ونخلا",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5788,
      "number": 30,
      "text_uthmani": "وَحَدَآئِقَ غُلۡبٗا ٣٠",
      "text_simple": "وحدائق غلبا",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5789,
      "number": 31,
      "text_uthmani": "وَفَٰكِهَةٗ وَأَبّٗا ٣١",
      "text_simple": "وفاكهة وأبا",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5790,
      "number": 32,
      "text_uthmani": "مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ٣٢",
      "text_simple": "متاعا لكم ولأنعامكم",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5791,
      "number": 33,
      "text_uthmani": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ ٣٣",
      "text_simple": "فإذا جاءت الصاخة",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5792,
      "number": 34,
      "text_uthmani": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ ٣٤",
      "text_simple": "يوم يفر المرء من أخيه",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5793,
      "number": 35,
      "text_uthmani": "وَأُمِّهِۦ وَأَبِيهِ ٣٥",
      "text_simple": "وأمه وأبيه",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5794,
      "number": 36,
      "text_uthmani": "وَصَٰحِبَتِهِۦ وَبَنِيهِ ٣٦",
      "text_simple": "وصاحبته وبنيه",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5795,
      "number": 37,
      "text_uthmani": "لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ ٣٧",
      "text_simple": "لكل امرئ منهم يومئذ شأن يغنيه",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5796,
      "number": 38,
      "text_uthmani": "وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ ٣٨",
      "text_simple": "وجوه يومئذ مسفرة",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5797,
      "number": 39,
      "text_uthmani": "ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ ٣٩",
      "text_simple": "ضاحكة مستبشرة",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5798,
      "number": 40,
      "text_uthmani": "وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ ٤٠",
      "text_simple": "ووجوه يومئذ عليها غبرة",
      "juz": 30,
      "page": 585,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5799,
      "number": 41,
      "text_uthmani": "تَرۡهَقُهَا قَتَرَةٌ ٤١",
      "text_simple": "ترهقها قترة",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5800,
      "number": 42,
      "text_uthmani": "أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ ٤٢",
      "text_simple": "أولئك هم الكفرة الفجرة",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    }
  ]
}