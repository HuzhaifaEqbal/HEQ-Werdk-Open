      "text_uthmani": "ٱلۡقَارِعَةُ ١",
      "text_simple": "القارعة",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 6159,
      "number": 2,
      "text_uthmani": "مَا ٱلۡقَارِعَةُ ٢",
      "text_simple": "ما القارعة",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 6160,
      "number": 3,
      "text_uthmani": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ ٣",
      "text_simple": "وما أدراك ما القارعة",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 6161,
      "number": 4,
      "text_uthmani": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ ٤",
      "text_simple": "يوم يكون الناس كالفراش المبثوث",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 6162,
      "number": 5,
      "text_uthmani": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ ٥",
      "text_simple": "وتكون الجبال كالعهن المنفوش",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 6163,
      "number": 6,
      "text_uthmani": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ ٦",
      "text_simple": "فأما من ثقلت موازينه",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6164,
      "number": 7,
      "text_uthmani": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ ٧",
      "text_simple": "فهو في عيشة راضية",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 6165,
      "number": 8,
      "text_uthmani": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ٨",
      "text_simple": "وأما من خفت موازينه",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6166,
      "number": 9,
      "text_uthmani": "فَأُمُّهُۥ هَاوِيَةٞ ٩",
      "text_simple": "فأمه هاوية",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6167,
      "number": 10,
      "text_uthmani": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ ١٠",
      "text_simple": "وما أدراك ما هيه",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6168,
      "number": 11,
      "text_uthmani": "نَارٌ حَامِيَةُۢ ١١",
      "text_simple": "نار حامية",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    }
  ]
