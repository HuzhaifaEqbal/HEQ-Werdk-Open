{
  "number": 56,
  "name_ar": "الوَاقِعة",
  "name_en": "Al-Wāqi‘ah",
  "ayahs_count": 96,
  "page_start": 534,
  "page_end": 537,
  "ayahs": [
    {
      "id": 4980,
      "number": 1,
      "text_uthmani": "إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ ١",
      "text_simple": "إذا وقعت الواقعة",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4981,
      "number": 2,
      "text_uthmani": "لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ ٢",
      "text_simple": "ليس لوقعتها كاذبة",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4982,
      "number": 3,
      "text_uthmani": "خَافِضَةٞ رَّافِعَةٌ ٣",
      "text_simple": "خافضة رافعة",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 4983,
      "number": 4,
      "text_uthmani": "إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا ٤",
      "text_simple": "إذا رجت الأرض رجا",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4984,
      "number": 5,
      "text_uthmani": "وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا ٥",
      "text_simple": "وبست الجبال بسا",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 4985,
      "number": 6,
      "text_uthmani": "فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا ٦",
      "text_simple": "فكانت هباء منبثا",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 4986,
      "number": 7,
      "text_uthmani": "وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ ٧",
      "text_simple": "وكنتم أزواجا ثلاثة",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 4987,
      "number": 8,
      "text_uthmani": "فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ٨",
      "text_simple": "فأصحاب الميمنة ما أصحاب الميمنة",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 4988,
      "number": 9,
      "text_uthmani": "وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ٩",
      "text_simple": "وأصحاب المشأمة ما أصحاب المشأمة",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 4989,
      "number": 10,
      "text_uthmani": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ ١٠",
      "text_simple": "والسابقون السابقون",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 4990,
      "number": 11,
      "text_uthmani": "أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ ١١",
      "text_simple": "أولئك المقربون",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 4991,
      "number": 12,
      "text_uthmani": "فِي جَنَّٰتِ ٱلنَّعِيمِ ١٢",
      "text_simple": "في جنات النعيم",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4992,
      "number": 13,
      "text_uthmani": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ ١٣",
      "text_simple": "ثلة من الأولين",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4993,
      "number": 14,
      "text_uthmani": "وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ ١٤",
      "text_simple": "وقليل من الآخرين",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 4994,
      "number": 15,
      "text_uthmani": "عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ ١٥",
      "text_simple": "على سرر موضونة",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 4995,
      "number": 16,
      "text_uthmani": "مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ ١٦",
      "text_simple": "متكئين عليها متقابلين",
      "juz": 27,
      "page": 534,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 4996,
      "number": 17,
      "text_uthmani": "يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ ١٧",
      "text_simple": "يطوف عليهم ولدان مخلدون",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 4997,
      "number": 18,
      "text_uthmani": "بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ ١٨",
      "text_simple": "بأكواب وأباريق وكأس من معين",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 4998,
      "number": 19,
      "text_uthmani": "لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ ١٩",
      "text_simple": "لا يصدعون عنها ولا ينزفون",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 4999,
      "number": 20,
      "text_uthmani": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ ٢٠",
      "text_simple": "وفاكهة مما يتخيرون",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5000,
      "number": 21,
      "text_uthmani": "وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ ٢١",
      "text_simple": "ولحم طير مما يشتهون",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5001,
      "number": 22,
      "text_uthmani": "وَحُورٌ عِينٞ ٢٢",
      "text_simple": "وحور عين",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5002,
      "number": 23,
      "text_uthmani": "كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ ٢٣",
      "text_simple": "كأمثال اللؤلؤ المكنون",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5003,
      "number": 24,
      "text_uthmani": "جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ ٢٤",
      "text_simple": "جزاء بما كانوا يعملون",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5004,
      "number": 25,
      "text_uthmani": "لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا ٢٥",
      "text_simple": "لا يسمعون فيها لغوا ولا تأثيما",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5005,
      "number": 26,
      "text_uthmani": "إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا ٢٦",
      "text_simple": "إلا قيلا سلاما سلاما",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5006,
      "number": 27,
      "text_uthmani": "وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ ٢٧",
      "text_simple": "وأصحاب اليمين ما أصحاب اليمين",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5007,
      "number": 28,
      "text_uthmani": "فِي سِدۡرٖ مَّخۡضُودٖ ٢٨",
      "text_simple": "في سدر مخضود",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5008,
      "number": 29,
      "text_uthmani": "وَطَلۡحٖ مَّنضُودٖ ٢٩",
      "text_simple": "وطلح منضود",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5009,
      "number": 30,
      "text_uthmani": "وَظِلّٖ مَّمۡدُودٖ ٣٠",
      "text_simple": "وظل ممدود",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5010,
      "number": 31,
      "text_uthmani": "وَمَآءٖ مَّسۡكُوبٖ ٣١",
      "text_simple": "وماء مسكوب",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5011,
      "number": 32,
      "text_uthmani": "وَفَٰكِهَةٖ كَثِيرَةٖ ٣٢",
      "text_simple": "وفاكهة كثيرة",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5012,
      "number": 33,
      "text_uthmani": "لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ ٣٣",
      "text_simple": "لا مقطوعة ولا ممنوعة",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5013,
      "number": 34,
      "text_uthmani": "وَفُرُشٖ مَّرۡفُوعَةٍ ٣٤",
      "text_simple": "وفرش مرفوعة",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5014,
      "number": 35,
      "text_uthmani": "إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ ٣٥",
      "text_simple": "إنا أنشأناهن إنشاء",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5015,
      "number": 36,
      "text_uthmani": "فَجَعَلۡنَٰهُنَّ أَبۡكَارًا ٣٦",
      "text_simple": "فجعلناهن أبكارا",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5016,
      "number": 37,
      "text_uthmani": "عُرُبًا أَتۡرَابٗا ٣٧",
      "text_simple": "عربا أترابا",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5017,
      "number": 38,
      "text_uthmani": "لِّأَصۡحَٰبِ ٱلۡيَمِينِ ٣٨",
      "text_simple": "لأصحاب اليمين",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5018,
      "number": 39,
      "text_uthmani": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ ٣٩",
      "text_simple": "ثلة من الأولين",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5019,
      "number": 40,
      "text_uthmani": "وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ ٤٠",
      "text_simple": "وثلة من الآخرين",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5020,
      "number": 41,
      "text_uthmani": "وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِّمَالِ ٤١",
      "text_simple": "وأصحاب الشمال ما أصحاب الشمال",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5021,
      "number": 42,
      "text_uthmani": "فِي سَمُومٖ وَحَمِيمٖ ٤٢",
      "text_simple": "في سموم وحميم",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5022,
      "number": 43,
      "text_uthmani": "وَظِلّٖ مِّن يَحۡمُومٖ ٤٣",
      "text_simple": "وظل من يحموم",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5023,
      "number": 44,
      "text_uthmani": "لَّا بَارِدٖ وَلَا كَرِيمٍ ٤٤",
      "text_simple": "لا بارد ولا كريم",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5024,
      "number": 45,
      "text_uthmani": "إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ ٤٥",
      "text_simple": "إنهم كانوا قبل ذلك مترفين",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5025,
      "number": 46,
      "text_uthmani": "وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ ٤٦",
      "text_simple": "وكانوا يصرون على الحنث العظيم",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5026,
      "number": 47,
      "text_uthmani": "وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ ٤٧",
      "text_simple": "وكانوا يقولون أئذا متنا وكنا ترابا وعظاما أئنا لمبعوثون",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5027,
      "number": 48,
      "text_uthmani": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ ٤٨",
      "text_simple": "أو آباؤنا الأولون",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5028,
      "number": 49,
      "text_uthmani": "قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ ٤٩",
      "text_simple": "قل إن الأولين والآخرين",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5029,
      "number": 50,
      "text_uthmani": "لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ ٥٠",
      "text_simple": "لمجموعون إلى ميقات يوم معلوم",
      "juz": 27,
      "page": 535,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5030,
      "number": 51,
      "text_uthmani": "ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ ٥١",
      "text_simple": "ثم إنكم أيها الضالون المكذبون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5031,
      "number": 52,
      "text_uthmani": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ٥٢",
      "text_simple": "لآكلون من شجر من زقوم",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5032,
      "number": 53,
      "text_uthmani": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ٥٣",
      "text_simple": "فمالئون منها البطون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5033,
      "number": 54,
      "text_uthmani": "فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ ٥٤",
      "text_simple": "فشاربون عليه من الحميم",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5034,
      "number": 55,
      "text_uthmani": "فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ ٥٥",
      "text_simple": "فشاربون شرب الهيم",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5035,
      "number": 56,
      "text_uthmani": "هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ ٥٦",
      "text_simple": "هذا نزلهم يوم الدين",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5036,
      "number": 57,
      "text_uthmani": "نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ ٥٧",
      "text_simple": "نحن خلقناكم فلولا تصدقون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5037,
      "number": 58,
      "text_uthmani": "أَفَرَءَيۡتُم مَّا تُمۡنُونَ ٥٨",
      "text_simple": "أفرأيتم ما تمنون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5038,
      "number": 59,
      "text_uthmani": "ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ ٥٩",
      "text_simple": "أأنتم تخلقونه أم نحن الخالقون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5039,
      "number": 60,
      "text_uthmani": "نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ٦٠",
      "text_simple": "نحن قدرنا بينكم الموت وما نحن بمسبوقين",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5040,
      "number": 61,
      "text_uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ ٦١",
      "text_simple": "على أن نبدل أمثالكم وننشئكم في ما لا تعلمون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5041,
      "number": 62,
      "text_uthmani": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ ٦٢",
      "text_simple": "ولقد علمتم النشأة الأولى فلولا تذكرون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5042,
      "number": 63,
      "text_uthmani": "أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ ٦٣",
      "text_simple": "أفرأيتم ما تحرثون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5043,
      "number": 64,
      "text_uthmani": "ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ ٦٤",
      "text_simple": "أأنتم تزرعونه أم نحن الزارعون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5044,
      "number": 65,
      "text_uthmani": "لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ ٦٥",
      "text_simple": "لو نشاء لجعلناه حطاما فظلتم تفكهون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5045,
      "number": 66,
      "text_uthmani": "إِنَّا لَمُغۡرَمُونَ ٦٦",
      "text_simple": "إنا لمغرمون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5046,
      "number": 67,
      "text_uthmani": "بَلۡ نَحۡنُ مَحۡرُومُونَ ٦٧",
      "text_simple": "بل نحن محرومون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5047,
      "number": 68,
      "text_uthmani": "أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ ٦٨",
      "text_simple": "أفرأيتم الماء الذي تشربون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5048,
      "number": 69,
      "text_uthmani": "ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ ٦٩",
      "text_simple": "أأنتم أنزلتموه من المزن أم نحن المنزلون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5049,
      "number": 70,
      "text_uthmani": "لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ ٧٠",
      "text_simple": "لو نشاء جعلناه أجاجا فلولا تشكرون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5050,
      "number": 71,
      "text_uthmani": "أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ ٧١",
      "text_simple": "أفرأيتم النار التي تورون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5051,
      "number": 72,
      "text_uthmani": "ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ ٧٢",
      "text_simple": "أأنتم أنشأتم شجرتها أم نحن المنشئون",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5052,
      "number": 73,
      "text_uthmani": "نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ ٧٣",
      "text_simple": "نحن جعلناها تذكرة ومتاعا للمقوين",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5053,
      "number": 74,
      "text_uthmani": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٧٤",
      "text_simple": "فسبح باسم ربك العظيم",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5054,
      "number": 75,
      "text_uthmani": "۞ فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ ٧٥",
      "text_simple": "فلا أقسم بمواقع النجوم",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5055,
      "number": 76,
      "text_uthmani": "وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ ٧٦",
      "text_simple": "وإنه لقسم لو تعلمون عظيم",
      "juz": 27,
      "page": 536,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5056,
      "number": 77,
      "text_uthmani": "إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ ٧٧",
      "text_simple": "إنه لقرآن كريم",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5057,
      "number": 78,
      "text_uthmani": "فِي كِتَٰبٖ مَّكۡنُونٖ ٧٨",
      "text_simple": "في كتاب مكنون",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5058,
      "number": 79,
      "text_uthmani": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ ٧٩",
      "text_simple": "لا يمسه إلا المطهرون",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5059,
      "number": 80,
      "text_uthmani": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ٨٠",
      "text_simple": "تنزيل من رب العالمين",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5060,
      "number": 81,
      "text_uthmani": "أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ ٨١",
      "text_simple": "أفبهذا الحديث أنتم مدهنون",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5061,
      "number": 82,
      "text_uthmani": "وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ ٨٢",
      "text_simple": "وتجعلون رزقكم أنكم تكذبون",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5062,
      "number": 83,
      "text_uthmani": "فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ ٨٣",
      "text_simple": "فلولا إذا بلغت الحلقوم",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5063,
      "number": 84,
      "text_uthmani": "وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ ٨٤",
      "text_simple": "وأنتم حينئذ تنظرون",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5064,
      "number": 85,
      "text_uthmani": "وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ ٨٥",
      "text_simple": "ونحن أقرب إليه منكم ولكن لا تبصرون",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5065,
      "number": 86,
      "text_uthmani": "فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ ٨٦",
      "text_simple": "فلولا إن كنتم غير مدينين",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5066,
      "number": 87,
      "text_uthmani": "تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ ٨٧",
      "text_simple": "ترجعونها إن كنتم صادقين",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5067,
      "number": 88,
      "text_uthmani": "فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ ٨٨",
      "text_simple": "فأما إن كان من المقربين",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5068,
      "number": 89,
      "text_uthmani": "فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ ٨٩",
      "text_simple": "فروح وريحان وجنة نعيم",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5069,
      "number": 90,
      "text_uthmani": "وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ٩٠",
      "text_simple": "وأما إن كان من أصحاب اليمين",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5070,
      "number": 91,
      "text_uthmani": "فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ٩١",
      "text_simple": "فسلام لك من أصحاب اليمين",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5071,
      "number": 92,
      "text_uthmani": "وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ ٩٢",
      "text_simple": "وأما إن كان من المكذبين الضالين",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5072,
      "number": 93,
      "text_uthmani": "فَنُزُلٞ مِّنۡ حَمِيمٖ ٩٣",
      "text_simple": "فنزل من حميم",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5073,
      "number": 94,
      "text_uthmani": "وَتَصۡلِيَةُ جَحِيمٍ ٩٤",
      "text_simple": "وتصلية جحيم",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5074,
      "number": 95,
      "text_uthmani": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ ٩٥",
      "text_simple": "إن هذا لهو حق اليقين",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5075,
      "number": 96,
      "text_uthmani": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٩٦",
      "text_simple": "فسبح باسم ربك العظيم",
      "juz": 27,
      "page": 537,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    }
  ]
}