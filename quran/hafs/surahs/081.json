{
  "number": 81,
  "name_ar": "التَّكوير",
  "name_en": "At-Takwīr",
  "ayahs_count": 29,
  "page_start": 586,
  "page_end": 586,
  "ayahs": [
    {
      "id": 5801,
      "number": 1,
      "text_uthmani": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ ١",
      "text_simple": "إذا الشمس كورت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5802,
      "number": 2,
      "text_uthmani": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ ٢",
      "text_simple": "وإذا النجوم انكدرت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5803,
      "number": 3,
      "text_uthmani": "وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ ٣",
      "text_simple": "وإذا الجبال سيرت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5804,
      "number": 4,
      "text_uthmani": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ ٤",
      "text_simple": "وإذا العشار عطلت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5805,
      "number": 5,
      "text_uthmani": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ ٥",
      "text_simple": "وإذا الوحوش حشرت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5806,
      "number": 6,
      "text_uthmani": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ ٦",
      "text_simple": "وإذا البحار سجرت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5807,
      "number": 7,
      "text_uthmani": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ ٧",
      "text_simple": "وإذا النفوس زوجت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5808,
      "number": 8,
      "text_uthmani": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ ٨",
      "text_simple": "وإذا الموءودة سئلت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5809,
      "number": 9,
      "text_uthmani": "بِأَيِّ ذَنۢبٖ قُتِلَتۡ ٩",
      "text_simple": "بأي ذنب قتلت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5810,
      "number": 10,
      "text_uthmani": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ ١٠",
      "text_simple": "وإذا الصحف نشرت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5811,
      "number": 11,
      "text_uthmani": "وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ ١١",
      "text_simple": "وإذا السماء كشطت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5812,
      "number": 12,
      "text_uthmani": "وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ ١٢",
      "text_simple": "وإذا الجحيم سعرت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5813,
      "number": 13,
      "text_uthmani": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ ١٣",
      "text_simple": "وإذا الجنة أزلفت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5814,
      "number": 14,
      "text_uthmani": "عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ ١٤",
      "text_simple": "علمت نفس ما أحضرت",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5815,
      "number": 15,
      "text_uthmani": "فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ ١٥",
      "text_simple": "فلا أقسم بالخنس",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5816,
      "number": 16,
      "text_uthmani": "ٱلۡجَوَارِ ٱلۡكُنَّسِ ١٦",
      "text_simple": "الجوار الكنس",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5817,
      "number": 17,
      "text_uthmani": "وَٱلَّيۡلِ إِذَا عَسۡعَسَ ١٧",
      "text_simple": "والليل إذا عسعس",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5818,
      "number": 18,
      "text_uthmani": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ ١٨",
      "text_simple": "والصبح إذا تنفس",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5819,
      "number": 19,
      "text_uthmani": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ١٩",
      "text_simple": "إنه لقول رسول كريم",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5820,
      "number": 20,
      "text_uthmani": "ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ ٢٠",
      "text_simple": "ذي قوة عند ذي العرش مكين",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5821,
      "number": 21,
      "text_uthmani": "مُّطَاعٖ ثَمَّ أَمِينٖ ٢١",
      "text_simple": "مطاع ثم أمين",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5822,
      "number": 22,
      "text_uthmani": "وَمَا صَاحِبُكُم بِمَجۡنُونٖ ٢٢",
      "text_simple": "وما صاحبكم بمجنون",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5823,
      "number": 23,
      "text_uthmani": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ ٢٣",
      "text_simple": "ولقد رآه بالأفق المبين",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5824,
      "number": 24,
      "text_uthmani": "وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ ٢٤",
      "text_simple": "وما هو على الغيب بضنين",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5825,
      "number": 25,
      "text_uthmani": "وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ ٢٥",
      "text_simple": "وما هو بقول شيطان رجيم",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5826,
      "number": 26,
      "text_uthmani": "فَأَيۡنَ تَذۡهَبُونَ ٢٦",
      "text_simple": "فأين تذهبون",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5827,
      "number": 27,
      "text_uthmani": "إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ ٢٧",
      "text_simple": "إن هو إلا ذكر للعالمين",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5828,
      "number": 28,
      "text_uthmani": "لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ ٢٨",
      "text_simple": "لمن شاء منكم أن يستقيم",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5829,
      "number": 29,
      "text_uthmani": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ ٢٩",
      "text_simple": "وما تشاءون إلا أن يشاء الله رب العالمين",
      "juz": 30,
      "page": 586,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    }
  ]
}