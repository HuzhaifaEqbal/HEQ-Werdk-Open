      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 6102,
      "number": 4,
      "text_uthmani": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ ٤",
      "text_simple": "لقد خلقنا الإنسان في أحسن تقويم",
      "juz": 30,
      "page": 597,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 6103,
      "number": 5,
      "text_uthmani": "ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ ٥",
      "text_simple": "ثم رددناه أسفل سافلين",
      "juz": 30,
      "page": 597,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 6104,
      "number": 6,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ ٦",
      "text_simple": "إلا الذين آمنوا وعملوا الصالحات فلهم أجر غير ممنون",
      "juz": 30,
      "page": 597,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 6105,
      "number": 7,
      "text_uthmani": "فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ ٧",
      "text_simple": "فما يكذبك بعد بالدين",
      "juz": 30,
      "page": 597,
