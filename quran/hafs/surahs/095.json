    },
    {
      "id": 6101,
      "number": 3,
      "text_uthmani": "وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ ٣",
      "text_simple": "وهذا البلد الأمين",
      "juz": 30,
