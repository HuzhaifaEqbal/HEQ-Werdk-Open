{
  "number": 83,
  "name_ar": "المُطَففين",
  "name_en": "Al-Muṭaffifīn",
  "ayahs_count": 36,
  "page_start": 587,
  "page_end": 589,
  "ayahs": [
    {
      "id": 5849,
      "number": 1,
      "text_uthmani": "وَيۡلٞ لِّلۡمُطَفِّفِينَ ١",
      "text_simple": "ويل للمطففين",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5850,
      "number": 2,
      "text_uthmani": "ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ ٢",
      "text_simple": "الذين إذا اكتالوا على الناس يستوفون",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5851,
      "number": 3,
      "text_uthmani": "وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ ٣",
      "text_simple": "وإذا كالوهم أو وزنوهم يخسرون",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5852,
      "number": 4,
      "text_uthmani": "أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ ٤",
      "text_simple": "ألا يظن أولئك أنهم مبعوثون",
      "juz": 30,
      "page": 587,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5853,
      "number": 5,
      "text_uthmani": "لِيَوۡمٍ عَظِيمٖ ٥",
      "text_simple": "ليوم عظيم",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5854,
      "number": 6,
      "text_uthmani": "يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَٰلَمِينَ ٦",
      "text_simple": "يوم يقوم الناس لرب العالمين",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5855,
      "number": 7,
      "text_uthmani": "كـَلَّآ إِنَّ كِتَٰبَ ٱلۡفُجَّارِ لَفِي سِجِّينٖ ٧",
      "text_simple": "كلا إن كتاب الفجار لفي سجين",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5856,
      "number": 8,
      "text_uthmani": "وَمَآ أَدۡرَىٰكَ مَا سِجِّينٞ ٨",
      "text_simple": "وما أدراك ما سجين",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5857,
      "number": 9,
      "text_uthmani": "كِتَٰبٞ مَّرۡقُومٞ ٩",
      "text_simple": "كتاب مرقوم",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5858,
      "number": 10,
      "text_uthmani": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١٠",
      "text_simple": "ويل يومئذ للمكذبين",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5859,
      "number": 11,
      "text_uthmani": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ ١١",
      "text_simple": "الذين يكذبون بيوم الدين",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5860,
      "number": 12,
      "text_uthmani": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ ١٢",
      "text_simple": "وما يكذب به إلا كل معتد أثيم",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5861,
      "number": 13,
      "text_uthmani": "إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ ١٣",
      "text_simple": "إذا تتلى عليه آياتنا قال أساطير الأولين",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5862,
      "number": 14,
      "text_uthmani": "كـَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ ١٤",
      "text_simple": "كلا بل ران على قلوبهم ما كانوا يكسبون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5863,
      "number": 15,
      "text_uthmani": "كـَلَّآ إِنَّهُمۡ عَن رَّبِّهِمۡ يَوۡمَئِذٖ لَّمَحۡجُوبُونَ ١٥",
      "text_simple": "كلا إنهم عن ربهم يومئذ لمحجوبون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5864,
      "number": 16,
      "text_uthmani": "ثُمَّ إِنَّهُمۡ لَصَالُواْ ٱلۡجَحِيمِ ١٦",
      "text_simple": "ثم إنهم لصالوا الجحيم",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5865,
      "number": 17,
      "text_uthmani": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ ١٧",
      "text_simple": "ثم يقال هذا الذي كنتم به تكذبون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5866,
      "number": 18,
      "text_uthmani": "كـَلَّآ إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ ١٨",
      "text_simple": "كلا إن كتاب الأبرار لفي عليين",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5867,
      "number": 19,
      "text_uthmani": "وَمَآ أَدۡرَىٰكَ مَا عِلِّيُّونَ ١٩",
      "text_simple": "وما أدراك ما عليون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5868,
      "number": 20,
      "text_uthmani": "كِتَٰبٞ مَّرۡقُومٞ ٢٠",
      "text_simple": "كتاب مرقوم",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5869,
      "number": 21,
      "text_uthmani": "يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ ٢١",
      "text_simple": "يشهده المقربون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5870,
      "number": 22,
      "text_uthmani": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ ٢٢",
      "text_simple": "إن الأبرار لفي نعيم",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5871,
      "number": 23,
      "text_uthmani": "عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ ٢٣",
      "text_simple": "على الأرائك ينظرون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5872,
      "number": 24,
      "text_uthmani": "تَعۡرِفُ فِي وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِيمِ ٢٤",
      "text_simple": "تعرف في وجوههم نضرة النعيم",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5873,
      "number": 25,
      "text_uthmani": "يُسۡقَوۡنَ مِن رَّحِيقٖ مَّخۡتُومٍ ٢٥",
      "text_simple": "يسقون من رحيق مختوم",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5874,
      "number": 26,
      "text_uthmani": "خِتَٰمُهُۥ مِسۡكٞۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ ٢٦",
      "text_simple": "ختامه مسك وفي ذلك فليتنافس المتنافسون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5875,
      "number": 27,
      "text_uthmani": "وَمِزَاجُهُۥ مِن تَسۡنِيمٍ ٢٧",
      "text_simple": "ومزاجه من تسنيم",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5876,
      "number": 28,
      "text_uthmani": "عَيۡنٗا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ ٢٨",
      "text_simple": "عينا يشرب بها المقربون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5877,
      "number": 29,
      "text_uthmani": "إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ ٢٩",
      "text_simple": "إن الذين أجرموا كانوا من الذين آمنوا يضحكون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5878,
      "number": 30,
      "text_uthmani": "وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ ٣٠",
      "text_simple": "وإذا مروا بهم يتغامزون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5879,
      "number": 31,
      "text_uthmani": "وَإِذَا ٱنقَلَبُوٓاْ إِلَىٰٓ أَهۡلِهِمُ ٱنقَلَبُواْ فَكِهِينَ ٣١",
      "text_simple": "وإذا انقلبوا إلى أهلهم انقلبوا فكهين",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5880,
      "number": 32,
      "text_uthmani": "وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ ٣٢",
      "text_simple": "وإذا رأوهم قالوا إن هؤلاء لضالون",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5881,
      "number": 33,
      "text_uthmani": "وَمَآ أُرۡسِلُواْ عَلَيۡهِمۡ حَٰفِظِينَ ٣٣",
      "text_simple": "وما أرسلوا عليهم حافظين",
      "juz": 30,
      "page": 588,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5882,
      "number": 34,
      "text_uthmani": "فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ ٣٤",
      "text_simple": "فاليوم الذين آمنوا من الكفار يضحكون",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5883,
      "number": 35,
      "text_uthmani": "عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ ٣٥",
      "text_simple": "على الأرائك ينظرون",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5884,
      "number": 36,
      "text_uthmani": "هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ ٣٦",
      "text_simple": "هل ثوب الكفار ما كانوا يفعلون",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    }
  ]
}