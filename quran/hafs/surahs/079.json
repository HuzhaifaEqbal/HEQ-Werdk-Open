{
  "number": 79,
  "name_ar": "النَّازعَات",
  "name_en": "An-Nāzi‘āt",
  "ayahs_count": 46,
  "page_start": 583,
  "page_end": 584,
  "ayahs": [
    {
      "id": 5713,
      "number": 1,
      "text_uthmani": "وَٱلنَّٰزِعَٰتِ غَرۡقٗا ١",
      "text_simple": "والنازعات غرقا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5714,
      "number": 2,
      "text_uthmani": "وَٱلنَّٰشِطَٰتِ نَشۡطٗا ٢",
      "text_simple": "والناشطات نشطا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5715,
      "number": 3,
      "text_uthmani": "وَٱلسَّٰبِحَٰتِ سَبۡحٗا ٣",
      "text_simple": "والسابحات سبحا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5716,
      "number": 4,
      "text_uthmani": "فَٱلسَّٰبِقَٰتِ سَبۡقٗا ٤",
      "text_simple": "فالسابقات سبقا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5717,
      "number": 5,
      "text_uthmani": "فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا ٥",
      "text_simple": "فالمدبرات أمرا",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5718,
      "number": 6,
      "text_uthmani": "يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ ٦",
      "text_simple": "يوم ترجف الراجفة",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5719,
      "number": 7,
      "text_uthmani": "تَتۡبَعُهَا ٱلرَّادِفَةُ ٧",
      "text_simple": "تتبعها الرادفة",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5720,
      "number": 8,
      "text_uthmani": "قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ ٨",
      "text_simple": "قلوب يومئذ واجفة",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5721,
      "number": 9,
      "text_uthmani": "أَبۡصَٰرُهَا خَٰشِعَةٞ ٩",
      "text_simple": "أبصارها خاشعة",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5722,
      "number": 10,
      "text_uthmani": "يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ ١٠",
      "text_simple": "يقولون أئنا لمردودون في الحافرة",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5723,
      "number": 11,
      "text_uthmani": "أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ ١١",
      "text_simple": "أئذا كنا عظاما نخرة",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5724,
      "number": 12,
      "text_uthmani": "قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ ١٢",
      "text_simple": "قالوا تلك إذا كرة خاسرة",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5725,
      "number": 13,
      "text_uthmani": "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ ١٣",
      "text_simple": "فإنما هي زجرة واحدة",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5726,
      "number": 14,
      "text_uthmani": "فَإِذَا هُم بِٱلسَّاهِرَةِ ١٤",
      "text_simple": "فإذا هم بالساهرة",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5727,
      "number": 15,
      "text_uthmani": "هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ ١٥",
      "text_simple": "هل أتاك حديث موسى",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5728,
      "number": 16,
      "text_uthmani": "إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى ١٦",
      "text_simple": "إذ ناداه ربه بالواد المقدس طوى",
      "juz": 30,
      "page": 583,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5729,
      "number": 17,
      "text_uthmani": "ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ ١٧",
      "text_simple": "اذهب إلى فرعون إنه طغى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5730,
      "number": 18,
      "text_uthmani": "فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ ١٨",
      "text_simple": "فقل هل لك إلى أن تزكى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5731,
      "number": 19,
      "text_uthmani": "وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ ١٩",
      "text_simple": "وأهديك إلى ربك فتخشى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5732,
      "number": 20,
      "text_uthmani": "فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ ٢٠",
      "text_simple": "فأراه الآية الكبرى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5733,
      "number": 21,
      "text_uthmani": "فَكَذَّبَ وَعَصَىٰ ٢١",
      "text_simple": "فكذب وعصى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5734,
      "number": 22,
      "text_uthmani": "ثُمَّ أَدۡبَرَ يَسۡعَىٰ ٢٢",
      "text_simple": "ثم أدبر يسعى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5735,
      "number": 23,
      "text_uthmani": "فَحَشَرَ فَنَادَىٰ ٢٣",
      "text_simple": "فحشر فنادى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5736,
      "number": 24,
      "text_uthmani": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ ٢٤",
      "text_simple": "فقال أنا ربكم الأعلى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5737,
      "number": 25,
      "text_uthmani": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ ٢٥",
      "text_simple": "فأخذه الله نكال الآخرة والأولى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5738,
      "number": 26,
      "text_uthmani": "إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ ٢٦",
      "text_simple": "إن في ذلك لعبرة لمن يخشى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5739,
      "number": 27,
      "text_uthmani": "ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا ٢٧",
      "text_simple": "أأنتم أشد خلقا أم السماء بناها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5740,
      "number": 28,
      "text_uthmani": "رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا ٢٨",
      "text_simple": "رفع سمكها فسواها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5741,
      "number": 29,
      "text_uthmani": "وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا ٢٩",
      "text_simple": "وأغطش ليلها وأخرج ضحاها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5742,
      "number": 30,
      "text_uthmani": "وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ ٣٠",
      "text_simple": "والأرض بعد ذلك دحاها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5743,
      "number": 31,
      "text_uthmani": "أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا ٣١",
      "text_simple": "أخرج منها ماءها ومرعاها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5744,
      "number": 32,
      "text_uthmani": "وَٱلۡجِبَالَ أَرۡسَىٰهَا ٣٢",
      "text_simple": "والجبال أرساها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5745,
      "number": 33,
      "text_uthmani": "مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ٣٣",
      "text_simple": "متاعا لكم ولأنعامكم",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5746,
      "number": 34,
      "text_uthmani": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ ٣٤",
      "text_simple": "فإذا جاءت الطامة الكبرى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5747,
      "number": 35,
      "text_uthmani": "يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ ٣٥",
      "text_simple": "يوم يتذكر الإنسان ما سعى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5748,
      "number": 36,
      "text_uthmani": "وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ ٣٦",
      "text_simple": "وبرزت الجحيم لمن يرى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5749,
      "number": 37,
      "text_uthmani": "فَأَمَّا مَن طَغَىٰ ٣٧",
      "text_simple": "فأما من طغى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5750,
      "number": 38,
      "text_uthmani": "وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ٣٨",
      "text_simple": "وآثر الحياة الدنيا",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5751,
      "number": 39,
      "text_uthmani": "فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ ٣٩",
      "text_simple": "فإن الجحيم هي المأوى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5752,
      "number": 40,
      "text_uthmani": "وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ ٤٠",
      "text_simple": "وأما من خاف مقام ربه ونهى النفس عن الهوى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5753,
      "number": 41,
      "text_uthmani": "فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ ٤١",
      "text_simple": "فإن الجنة هي المأوى",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5754,
      "number": 42,
      "text_uthmani": "يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا ٤٢",
      "text_simple": "يسألونك عن الساعة أيان مرساها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5755,
      "number": 43,
      "text_uthmani": "فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ ٤٣",
      "text_simple": "فيم أنت من ذكراها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5756,
      "number": 44,
      "text_uthmani": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ ٤٤",
      "text_simple": "إلى ربك منتهاها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5757,
      "number": 45,
      "text_uthmani": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا ٤٥",
      "text_simple": "إنما أنت منذر من يخشاها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5758,
      "number": 46,
      "text_uthmani": "كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا ٤٦",
      "text_simple": "كأنهم يوم يرونها لم يلبثوا إلا عشية أو ضحاها",
      "juz": 30,
      "page": 584,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    }
  ]
}