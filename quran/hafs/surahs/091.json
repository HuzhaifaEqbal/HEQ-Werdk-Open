{
  "number": 91,
  "name_ar": "الشَّمس",
  "name_en": "Ash-Shams",
  "ayahs_count": 15,
  "page_start": 595,
  "page_end": 595,
  "ayahs": [
    {
      "id": 6044,
      "number": 1,
      "text_uthmani": "وَٱلشَّمۡسِ وَضُحَىٰهَا ١",
      "text_simple": "والشمس وضحاها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 6045,
      "number": 2,
      "text_uthmani": "وَٱلۡقَمَرِ إِذَا تَلَىٰهَا ٢",
      "text_simple": "والقمر إذا تلاها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 6046,
      "number": 3,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا ٣",
      "text_simple": "والنهار إذا جلاها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 6047,
      "number": 4,
      "text_uthmani": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا ٤",
      "text_simple": "والليل إذا يغشاها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 6048,
      "number": 5,
      "text_uthmani": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا ٥",
      "text_simple": "والسماء وما بناها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 6049,
      "number": 6,
      "text_uthmani": "وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا ٦",
      "text_simple": "والأرض وما طحاها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 6050,
      "number": 7,
      "text_uthmani": "وَنَفۡسٖ وَمَا سَوَّىٰهَا ٧",
      "text_simple": "ونفس وما سواها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 6051,
      "number": 8,
      "text_uthmani": "فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا ٨",
      "text_simple": "فألهمها فجورها وتقواها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 6052,
      "number": 9,
      "text_uthmani": "قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا ٩",
      "text_simple": "قد أفلح من زكاها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 6053,
      "number": 10,
      "text_uthmani": "وَقَدۡ خَابَ مَن دَسَّىٰهَا ١٠",
      "text_simple": "وقد خاب من دساها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 6054,
      "number": 11,
      "text_uthmani": "كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ ١١",
      "text_simple": "كذبت ثمود بطغواها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6055,
      "number": 12,
      "text_uthmani": "إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا ١٢",
      "text_simple": "إذ انبعث أشقاها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6056,
      "number": 13,
      "text_uthmani": "فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا ١٣",
      "text_simple": "فقال لهم رسول الله ناقة الله وسقياها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 6057,
      "number": 14,
      "text_uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا ١٤",
      "text_simple": "فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسواها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 6058,
      "number": 15,
      "text_uthmani": "وَلَا يَخَافُ عُقۡبَٰهَا ١٥",
      "text_simple": "ولا يخاف عقباها",
      "juz": 30,
      "page": 595,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    }
  ]
}