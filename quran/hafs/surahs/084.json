{
  "number": 84,
  "name_ar": "الانشِقَاق",
  "name_en": "Al-Inshiqāq",
  "ayahs_count": 25,
  "page_start": 589,
  "page_end": 590,
  "ayahs": [
    {
      "id": 5885,
      "number": 1,
      "text_uthmani": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ ١",
      "text_simple": "إذا السماء انشقت",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5886,
      "number": 2,
      "text_uthmani": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ ٢",
      "text_simple": "وأذنت لربها وحقت",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5887,
      "number": 3,
      "text_uthmani": "وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ ٣",
      "text_simple": "وإذا الأرض مدت",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5888,
      "number": 4,
      "text_uthmani": "وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ ٤",
      "text_simple": "وألقت ما فيها وتخلت",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5889,
      "number": 5,
      "text_uthmani": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ ٥",
      "text_simple": "وأذنت لربها وحقت",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5890,
      "number": 6,
      "text_uthmani": "يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ ٦",
      "text_simple": "ياأيها الإنسان إنك كادح إلى ربك كدحا فملاقيه",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5891,
      "number": 7,
      "text_uthmani": "فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ ٧",
      "text_simple": "فأما من أوتي كتابه بيمينه",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5892,
      "number": 8,
      "text_uthmani": "فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا ٨",
      "text_simple": "فسوف يحاسب حسابا يسيرا",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5893,
      "number": 9,
      "text_uthmani": "وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا ٩",
      "text_simple": "وينقلب إلى أهله مسرورا",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5894,
      "number": 10,
      "text_uthmani": "وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ ١٠",
      "text_simple": "وأما من أوتي كتابه وراء ظهره",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5895,
      "number": 11,
      "text_uthmani": "فَسَوۡفَ يَدۡعُواْ ثُبُورٗا ١١",
      "text_simple": "فسوف يدعو ثبورا",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5896,
      "number": 12,
      "text_uthmani": "وَيَصۡلَىٰ سَعِيرًا ١٢",
      "text_simple": "ويصلى سعيرا",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5897,
      "number": 13,
      "text_uthmani": "إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا ١٣",
      "text_simple": "إنه كان في أهله مسرورا",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5898,
      "number": 14,
      "text_uthmani": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ ١٤",
      "text_simple": "إنه ظن أن لن يحور",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5899,
      "number": 15,
      "text_uthmani": "بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا ١٥",
      "text_simple": "بلى إن ربه كان به بصيرا",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5900,
      "number": 16,
      "text_uthmani": "فَلَآ أُقۡسِمُ بِٱلشَّفَقِ ١٦",
      "text_simple": "فلا أقسم بالشفق",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5901,
      "number": 17,
      "text_uthmani": "وَٱلَّيۡلِ وَمَا وَسَقَ ١٧",
      "text_simple": "والليل وما وسق",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5902,
      "number": 18,
      "text_uthmani": "وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ ١٨",
      "text_simple": "والقمر إذا اتسق",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5903,
      "number": 19,
      "text_uthmani": "لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ ١٩",
      "text_simple": "لتركبن طبقا عن طبق",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5904,
      "number": 20,
      "text_uthmani": "فَمَا لَهُمۡ لَا يُؤۡمِنُونَ ٢٠",
      "text_simple": "فما لهم لا يؤمنون",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5905,
      "number": 21,
      "text_uthmani": "وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩ ٢١",
      "text_simple": "وإذا قرئ عليهم القرآن لا يسجدون",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5906,
      "number": 22,
      "text_uthmani": "بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ ٢٢",
      "text_simple": "بل الذين كفروا يكذبون",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5907,
      "number": 23,
      "text_uthmani": "وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ ٢٣",
      "text_simple": "والله أعلم بما يوعون",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5908,
      "number": 24,
      "text_uthmani": "فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ ٢٤",
      "text_simple": "فبشرهم بعذاب أليم",
      "juz": 30,
      "page": 589,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5909,
      "number": 25,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ ٢٥",
      "text_simple": "إلا الذين آمنوا وعملوا الصالحات لهم أجر غير ممنون",
      "juz": 30,
      "page": 590,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    }
  ]
}