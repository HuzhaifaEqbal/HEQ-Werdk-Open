    },
    {
      "id": 6149,
      "number": 3,
      "text_uthmani": "فَٱلۡمُغِيرَٰتِ صُبۡحٗا ٣",
      "text_simple": "فالمغيرات صبحا",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 6150,
      "number": 4,
      "text_uthmani": "فَأَثَرۡنَ بِهِۦ نَقۡعٗا ٤",
      "text_simple": "فأثرن به نقعا",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6151,
      "number": 5,
      "text_uthmani": "فَوَسَطۡنَ بِهِۦ جَمۡعًا ٥",
      "text_simple": "فوسطن به جمعا",
      "juz": 30,
      "page": 599,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 6152,
      "number": 6,
      "text_uthmani": "إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ٦",
      "text_simple": "إن الإنسان لربه لكنود",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 6153,
      "number": 7,
      "text_uthmani": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ٧",
      "text_simple": "وإنه على ذلك لشهيد",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 6154,
      "number": 8,
      "text_uthmani": "وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ ٨",
      "text_simple": "وإنه لحب الخير لشديد",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 6155,
      "number": 9,
      "text_uthmani": "۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ ٩",
      "text_simple": "أفلا يعلم إذا بعثر ما في القبور",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 6156,
      "number": 10,
      "text_uthmani": "وَحُصِّلَ مَا فِي ٱلصُّدُورِ ١٠",
      "text_simple": "وحصل ما في الصدور",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 6157,
      "number": 11,
      "text_uthmani": "إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ ١١",
      "text_simple": "إن ربهم بهم يومئذ لخبير",
      "juz": 30,
      "page": 600,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    }
  ]
