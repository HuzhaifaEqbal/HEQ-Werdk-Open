{
  "number": 70,
  "name_ar": "المَعَارج",
  "name_en": "Al-Ma‘ārij",
  "ayahs_count": 44,
  "page_start": 568,
  "page_end": 570,
  "ayahs": [
    {
      "id": 5376,
      "number": 1,
      "text_uthmani": "سَأَلَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ ١",
      "text_simple": "سأل سائل بعذاب واقع",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5377,
      "number": 2,
      "text_uthmani": "لِّلۡكَٰفِرِينَ لَيۡسَ لَهُۥ دَافِعٞ ٢",
      "text_simple": "للكافرين ليس له دافع",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5378,
      "number": 3,
      "text_uthmani": "مِّنَ ٱللَّهِ ذِي ٱلۡمَعَارِجِ ٣",
      "text_simple": "من الله ذي المعارج",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5379,
      "number": 4,
      "text_uthmani": "تَعۡرُجُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيۡهِ فِي يَوۡمٖ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةٖ ٤",
      "text_simple": "تعرج الملائكة والروح إليه في يوم كان مقداره خمسين ألف سنة",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5380,
      "number": 5,
      "text_uthmani": "فَٱصۡبِرۡ صَبۡرٗا جَمِيلًا ٥",
      "text_simple": "فاصبر صبرا جميلا",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5381,
      "number": 6,
      "text_uthmani": "إِنَّهُمۡ يَرَوۡنَهُۥ بَعِيدٗا ٦",
      "text_simple": "إنهم يرونه بعيدا",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5382,
      "number": 7,
      "text_uthmani": "وَنَرَىٰهُ قَرِيبٗا ٧",
      "text_simple": "ونراه قريبا",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5383,
      "number": 8,
      "text_uthmani": "يَوۡمَ تَكُونُ ٱلسَّمَآءُ كَٱلۡمُهۡلِ ٨",
      "text_simple": "يوم تكون السماء كالمهل",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5384,
      "number": 9,
      "text_uthmani": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٩",
      "text_simple": "وتكون الجبال كالعهن",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5385,
      "number": 10,
      "text_uthmani": "وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمٗا ١٠",
      "text_simple": "ولا يسأل حميم حميما",
      "juz": 29,
      "page": 568,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5386,
      "number": 11,
      "text_uthmani": "يُبَصَّرُونَهُمۡۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِ ١١",
      "text_simple": "يبصرونهم يود المجرم لو يفتدي من عذاب يومئذ ببنيه",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5387,
      "number": 12,
      "text_uthmani": "وَصَٰحِبَتِهِۦ وَأَخِيهِ ١٢",
      "text_simple": "وصاحبته وأخيه",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5388,
      "number": 13,
      "text_uthmani": "وَفَصِيلَتِهِ ٱلَّتِي تُـٔۡوِيهِ ١٣",
      "text_simple": "وفصيلته التي تؤويه",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5389,
      "number": 14,
      "text_uthmani": "وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗا ثُمَّ يُنجِيهِ ١٤",
      "text_simple": "ومن في الأرض جميعا ثم ينجيه",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5390,
      "number": 15,
      "text_uthmani": "كـَلَّآۖ إِنَّهَا لَظَىٰ ١٥",
      "text_simple": "كلا إنها لظى",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5391,
      "number": 16,
      "text_uthmani": "نَزَّاعَةٗ لِّلشَّوَىٰ ١٦",
      "text_simple": "نزاعة للشوى",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 3,
      "line_end": 3
    },
    {
      "id": 5392,
      "number": 17,
      "text_uthmani": "تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ ١٧",
      "text_simple": "تدعو من أدبر وتولى",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 3,
      "line_end": 4
    },
    {
      "id": 5393,
      "number": 18,
      "text_uthmani": "وَجَمَعَ فَأَوۡعَىٰٓ ١٨",
      "text_simple": "وجمع فأوعى",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5394,
      "number": 19,
      "text_uthmani": "۞ إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا ١٩",
      "text_simple": "إن الإنسان خلق هلوعا",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    },
    {
      "id": 5395,
      "number": 20,
      "text_uthmani": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعٗا ٢٠",
      "text_simple": "إذا مسه الشر جزوعا",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 4,
      "line_end": 5
    },
    {
      "id": 5396,
      "number": 21,
      "text_uthmani": "وَإِذَا مَسَّهُ ٱلۡخَيۡرُ مَنُوعًا ٢١",
      "text_simple": "وإذا مسه الخير منوعا",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5397,
      "number": 22,
      "text_uthmani": "إِلَّا ٱلۡمُصَلِّينَ ٢٢",
      "text_simple": "إلا المصلين",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 5,
      "line_end": 5
    },
    {
      "id": 5398,
      "number": 23,
      "text_uthmani": "ٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَآئِمُونَ ٢٣",
      "text_simple": "الذين هم على صلاتهم دائمون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 5,
      "line_end": 6
    },
    {
      "id": 5399,
      "number": 24,
      "text_uthmani": "وَٱلَّذِينَ فِيٓ أَمۡوَٰلِهِمۡ حَقّٞ مَّعۡلُومٞ ٢٤",
      "text_simple": "والذين في أموالهم حق معلوم",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 6,
      "line_end": 6
    },
    {
      "id": 5400,
      "number": 25,
      "text_uthmani": "لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ ٢٥",
      "text_simple": "للسائل والمحروم",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 6,
      "line_end": 7
    },
    {
      "id": 5401,
      "number": 26,
      "text_uthmani": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ ٢٦",
      "text_simple": "والذين يصدقون بيوم الدين",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5402,
      "number": 27,
      "text_uthmani": "وَٱلَّذِينَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ ٢٧",
      "text_simple": "والذين هم من عذاب ربهم مشفقون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5403,
      "number": 28,
      "text_uthmani": "إِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَأۡمُونٖ ٢٨",
      "text_simple": "إن عذاب ربهم غير مأمون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5404,
      "number": 29,
      "text_uthmani": "وَٱلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ ٢٩",
      "text_simple": "والذين هم لفروجهم حافظون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5405,
      "number": 30,
      "text_uthmani": "إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ ٣٠",
      "text_simple": "إلا على أزواجهم أو ما ملكت أيمانهم فإنهم غير ملومين",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5406,
      "number": 31,
      "text_uthmani": "فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡعَادُونَ ٣١",
      "text_simple": "فمن ابتغى وراء ذلك فأولئك هم العادون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5407,
      "number": 32,
      "text_uthmani": "وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ ٣٢",
      "text_simple": "والذين هم لأماناتهم وعهدهم راعون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5408,
      "number": 33,
      "text_uthmani": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمۡ قَآئِمُونَ ٣٣",
      "text_simple": "والذين هم بشهاداتهم قائمون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5409,
      "number": 34,
      "text_uthmani": "وَٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ ٣٤",
      "text_simple": "والذين هم على صلاتهم يحافظون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5410,
      "number": 35,
      "text_uthmani": "أُوْلَٰٓئِكَ فِي جَنَّٰتٖ مُّكۡرَمُونَ ٣٥",
      "text_simple": "أولئك في جنات مكرمون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5411,
      "number": 36,
      "text_uthmani": "فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ ٣٦",
      "text_simple": "فمال الذين كفروا قبلك مهطعين",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5412,
      "number": 37,
      "text_uthmani": "عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ ٣٧",
      "text_simple": "عن اليمين وعن الشمال عزين",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5413,
      "number": 38,
      "text_uthmani": "أَيَطۡمَعُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ ٣٨",
      "text_simple": "أيطمع كل امرئ منهم أن يدخل جنة نعيم",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5414,
      "number": 39,
      "text_uthmani": "كـَلَّآۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ ٣٩",
      "text_simple": "كلا إنا خلقناهم مما يعلمون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 14,
      "line_end": 15
    },
    {
      "id": 5415,
      "number": 40,
      "text_uthmani": "فَلَآ أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ ٤٠",
      "text_simple": "فلا أقسم برب المشارق والمغارب إنا لقادرون",
      "juz": 29,
      "page": 569,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5416,
      "number": 41,
      "text_uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ خَيۡرٗا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ٤١",
      "text_simple": "على أن نبدل خيرا منهم وما نحن بمسبوقين",
      "juz": 29,
      "page": 570,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5417,
      "number": 42,
      "text_uthmani": "فَذَرۡهُمۡ يَخُوضُواْ وَيَلۡعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ ٱلَّذِي يُوعَدُونَ ٤٢",
      "text_simple": "فذرهم يخوضوا ويلعبوا حتى يلاقوا يومهم الذي يوعدون",
      "juz": 29,
      "page": 570,
      "page_end": null,
      "line_start": 1,
      "line_end": 2
    },
    {
      "id": 5418,
      "number": 43,
      "text_uthmani": "يَوۡمَ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعٗا كَأَنَّهُمۡ إِلَىٰ نُصُبٖ يُوفِضُونَ ٤٣",
      "text_simple": "يوم يخرجون من الأجداث سراعا كأنهم إلى نصب يوفضون",
      "juz": 29,
      "page": 570,
      "page_end": null,
      "line_start": 2,
      "line_end": 3
    },
    {
      "id": 5419,
      "number": 44,
      "text_uthmani": "خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۚ ذَٰلِكَ ٱلۡيَوۡمُ ٱلَّذِي كَانُواْ يُوعَدُونَ ٤٤",
      "text_simple": "خاشعة أبصارهم ترهقهم ذلة ذلك اليوم الذي كانوا يوعدون",
      "juz": 29,
      "page": 570,
      "page_end": null,
      "line_start": 4,
      "line_end": 4
    }
  ]
}