      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 6191,
      "number": 3,
      "text_uthmani": "وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ ٣",
      "text_simple": "وأرسل عليهم طيرا أبابيل",
