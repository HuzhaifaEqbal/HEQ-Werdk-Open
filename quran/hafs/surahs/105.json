      "line_end": 13
    },
    {
      "id": 6190,
      "number": 2,
      "text_uthmani": "أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ ٢",
      "text_simple": "ألم يجعل كيدهم في تضليل",
      "juz": 30,
      "page": 601,
