  "ayahs": [
    {
      "id": 6080,
      "number": 1,
      "text_uthmani": "وَٱلضُّحَىٰ ١",
      "text_simple": "والضحى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6081,
      "number": 2,
      "text_uthmani": "وَٱلَّيۡلِ إِذَا سَجَىٰ ٢",
      "text_simple": "والليل إذا سجى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6082,
      "number": 3,
      "text_uthmani": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ٣",
      "text_simple": "ما ودعك ربك وما قلى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 6083,
      "number": 4,
      "text_uthmani": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ ٤",
      "text_simple": "وللآخرة خير لك من الأولى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 6084,
      "number": 5,
      "text_uthmani": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ ٥",
      "text_simple": "ولسوف يعطيك ربك فترضى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 6085,
      "number": 6,
      "text_uthmani": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ ٦",
      "text_simple": "ألم يجدك يتيما فآوى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6086,
      "number": 7,
      "text_uthmani": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ ٧",
      "text_simple": "ووجدك ضالا فهدى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 6087,
      "number": 8,
      "text_uthmani": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ ٨",
      "text_simple": "ووجدك عائلا فأغنى",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 6088,
      "number": 9,
      "text_uthmani": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ ٩",
      "text_simple": "فأما اليتيم فلا تقهر",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 6089,
      "number": 10,
      "text_uthmani": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ ١٠",
      "text_simple": "وأما السائل فلا تنهر",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 6090,
      "number": 11,
      "text_uthmani": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ١١",
      "text_simple": "وأما بنعمة ربك فحدث",
      "juz": 30,
      "page": 596,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    }
  ]
}