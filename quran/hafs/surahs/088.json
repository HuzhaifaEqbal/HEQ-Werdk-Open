{
  "number": 88,
  "name_ar": "الغَاشِية",
  "name_en": "Al-Ghāshiyah",
  "ayahs_count": 26,
  "page_start": 592,
  "page_end": 593,
  "ayahs": [
    {
      "id": 5968,
      "number": 1,
      "text_uthmani": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ ١",
      "text_simple": "هل أتاك حديث الغاشية",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5969,
      "number": 2,
      "text_uthmani": "وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ ٢",
      "text_simple": "وجوه يومئذ خاشعة",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 7,
      "line_end": 7
    },
    {
      "id": 5970,
      "number": 3,
      "text_uthmani": "عَامِلَةٞ نَّاصِبَةٞ ٣",
      "text_simple": "عاملة ناصبة",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 7,
      "line_end": 8
    },
    {
      "id": 5971,
      "number": 4,
      "text_uthmani": "تَصۡلَىٰ نَارًا حَامِيَةٗ ٤",
      "text_simple": "تصلى نارا حامية",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5972,
      "number": 5,
      "text_uthmani": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ ٥",
      "text_simple": "تسقى من عين آنية",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 8,
      "line_end": 8
    },
    {
      "id": 5973,
      "number": 6,
      "text_uthmani": "لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ ٦",
      "text_simple": "ليس لهم طعام إلا من ضريع",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 8,
      "line_end": 9
    },
    {
      "id": 5974,
      "number": 7,
      "text_uthmani": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ ٧",
      "text_simple": "لا يسمن ولا يغني من جوع",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 9,
      "line_end": 9
    },
    {
      "id": 5975,
      "number": 8,
      "text_uthmani": "وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ ٨",
      "text_simple": "وجوه يومئذ ناعمة",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 9,
      "line_end": 10
    },
    {
      "id": 5976,
      "number": 9,
      "text_uthmani": "لِّسَعۡيِهَا رَاضِيَةٞ ٩",
      "text_simple": "لسعيها راضية",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5977,
      "number": 10,
      "text_uthmani": "فِي جَنَّةٍ عَالِيَةٖ ١٠",
      "text_simple": "في جنة عالية",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 10,
      "line_end": 10
    },
    {
      "id": 5978,
      "number": 11,
      "text_uthmani": "لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ ١١",
      "text_simple": "لا تسمع فيها لاغية",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 10,
      "line_end": 11
    },
    {
      "id": 5979,
      "number": 12,
      "text_uthmani": "فِيهَا عَيۡنٞ جَارِيَةٞ ١٢",
      "text_simple": "فيها عين جارية",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5980,
      "number": 13,
      "text_uthmani": "فِيهَا سُرُرٞ مَّرۡفُوعَةٞ ١٣",
      "text_simple": "فيها سرر مرفوعة",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 11,
      "line_end": 11
    },
    {
      "id": 5981,
      "number": 14,
      "text_uthmani": "وَأَكۡوَابٞ مَّوۡضُوعَةٞ ١٤",
      "text_simple": "وأكواب موضوعة",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 11,
      "line_end": 12
    },
    {
      "id": 5982,
      "number": 15,
      "text_uthmani": "وَنَمَارِقُ مَصۡفُوفَةٞ ١٥",
      "text_simple": "ونمارق مصفوفة",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5983,
      "number": 16,
      "text_uthmani": "وَزَرَابِيُّ مَبۡثُوثَةٌ ١٦",
      "text_simple": "وزرابي مبثوثة",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 12,
      "line_end": 12
    },
    {
      "id": 5984,
      "number": 17,
      "text_uthmani": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ ١٧",
      "text_simple": "أفلا ينظرون إلى الإبل كيف خلقت",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 12,
      "line_end": 13
    },
    {
      "id": 5985,
      "number": 18,
      "text_uthmani": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ ١٨",
      "text_simple": "وإلى السماء كيف رفعت",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 13,
      "line_end": 13
    },
    {
      "id": 5986,
      "number": 19,
      "text_uthmani": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ ١٩",
      "text_simple": "وإلى الجبال كيف نصبت",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 13,
      "line_end": 14
    },
    {
      "id": 5987,
      "number": 20,
      "text_uthmani": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ ٢٠",
      "text_simple": "وإلى الأرض كيف سطحت",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 14,
      "line_end": 14
    },
    {
      "id": 5988,
      "number": 21,
      "text_uthmani": "فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ ٢١",
      "text_simple": "فذكر إنما أنت مذكر",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5989,
      "number": 22,
      "text_uthmani": "لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ ٢٢",
      "text_simple": "لست عليهم بمصيطر",
      "juz": 30,
      "page": 592,
      "page_end": null,
      "line_start": 15,
      "line_end": 15
    },
    {
      "id": 5990,
      "number": 23,
      "text_uthmani": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ٢٣",
      "text_simple": "إلا من تولى وكفر",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5991,
      "number": 24,
      "text_uthmani": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ ٢٤",
      "text_simple": "فيعذبه الله العذاب الأكبر",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 1,
      "line_end": 1
    },
    {
      "id": 5992,
      "number": 25,
      "text_uthmani": "إِنَّ إِلَيۡنَآ إِيَابَهُمۡ ٢٥",
      "text_simple": "إن إلينا إيابهم",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    },
    {
      "id": 5993,
      "number": 26,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم ٢٦",
      "text_simple": "ثم إن علينا حسابهم",
      "juz": 30,
      "page": 593,
      "page_end": null,
      "line_start": 2,
      "line_end": 2
    }
  ]
}